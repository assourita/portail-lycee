{% extends 'base.html.twig' %}

{% block title %}Paramètres - Sécurité{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        {% include '_partials/sidebar_role.html.twig' %}

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">
                    <i class="fas fa-shield-alt me-2 text-primary"></i>
                    Sécurité
                </h1>
            </div>

            <!-- Navigation des paramètres -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="list-group">
                        <a href="{{ path('app_parametres') }}" class="list-group-item list-group-item-action">
                            <i class="fas fa-cog me-2"></i>Général
                        </a>
                        <a href="{{ path('app_parametres_securite') }}" class="list-group-item list-group-item-action active">
                            <i class="fas fa-shield-alt me-2"></i>Sécurité
                        </a>
                        <a href="{{ path('app_parametres_notifications') }}" class="list-group-item list-group-item-action">
                            <i class="fas fa-bell me-2"></i>Notifications
                        </a>
                        <a href="{{ path('app_parametres_confidentialite') }}" class="list-group-item list-group-item-action">
                            <i class="fas fa-lock me-2"></i>Confidentialité
                        </a>
                        <a href="{{ path('app_parametres_aide') }}" class="list-group-item list-group-item-action">
                            <i class="fas fa-question-circle me-2"></i>Aide
                        </a>
                    </div>
                </div>
                <div class="col-md-9">
                    <!-- Sécurité du compte -->
                    <div class="card shadow mb-4">
                        <div class="card-header">
                            <h6 class="m-0 font-weight-bold text-primary">
                                <i class="fas fa-shield-alt me-2"></i>Sécurité du compte
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <strong>Double authentification:</strong><br>
                                    <span class="badge {{ securiteInfo.double_auth_active ? 'bg-success' : 'bg-warning' }}">
                                        {{ securiteInfo.double_auth_active ? 'Activée' : 'Désactivée' }}
                                    </span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <strong>Dernière connexion:</strong><br>
                                    {{ user.lastLogin ? user.lastLogin|date('d/m/Y H:i') : 'Jamais' }}
                                </div>
                                <div class="col-md-6 mb-3">
                                    <strong>Mot de passe modifié:</strong><br>
                                    {{ user.passwordChangedAt ? user.passwordChangedAt|date('d/m/Y H:i') : 'Jamais' }}
                                </div>
                                <div class="col-md-6 mb-3">
                                    <strong>Sessions actives:</strong><br>
                                    <span class="badge bg-info">
                                        {{ securiteInfo.active_sessions|length }}
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Actions de sécurité -->
                    <div class="card shadow">
                        <div class="card-header">
                            <h6 class="m-0 font-weight-bold text-warning">
                                <i class="fas fa-tools me-2"></i>Actions de sécurité
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <a href="{{ path('app_profil_modifier') }}" class="btn btn-outline-primary btn-block">
                                        <i class="fas fa-key me-2"></i>Changer le mot de passe
                                    </a>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <button class="btn btn-outline-warning btn-block" disabled>
                                        <i class="fas fa-mobile-alt me-2"></i>Activer 2FA (Bientôt)
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}
