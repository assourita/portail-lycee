{% extends 'base.html.twig' %}

{% block title %}Dashboard Enseignant{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        {% include 'enseignant/_sidebar.html.twig' %}

        <!-- Main content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <div>
                    <h1 class="h2">Dashboard Enseignant</h1>
                    {% if periodeActive %}
                        <p class="text-muted mb-0">
                            <i class="fas fa-calendar-check me-1"></i>
                            Période : <strong>{{ periodeActive.periode }}</strong> - {{ periodeActive.anneeScolaire }}
                        </p>
                    {% endif %}
                </div>
            </div>

            <!-- Statistiques Cards -->
            <div class="row mb-4">
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-primary shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                        MES COURS</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">{{ cours|length }}</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-book fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-success shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                        ÉTUDIANTS</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">{{ totalEtudiants ?? 150 }}</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-user-graduate fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-info shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                        COURS CETTE SEMAINE</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">{{ coursCetteSemaine ?? 12 }}</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-calendar fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-warning shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                        DEVOIRS À CORRIGER</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">{{ devoirsACorriger ?? 18 }}</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-tasks fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mes cours récents -->
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary">Mes cours récents</h6>
                    <a href="{{ path('enseignant_cours_new') }}" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus"></i> Nouveau cours
                    </a>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Titre</th>
                                    <th>Matière</th>
                                    <th>Date de création</th>
                                    <th>Nombre de chapitres</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for cours in cours|slice(0, 5) %}
                                <tr>
                                    <td>{{ cours.titre }}</td>
                                    <td>{{ cours.matiere.nom }}</td>
                                    <td>{{ cours.dateAjout|date('d/m/Y') }}</td>
                                    <td>{{ cours.chapitres|length }}</td>
                                    <td>
                                        <a href="{{ path('enseignant_cours_show', {'id': cours.id}) }}" class="btn btn-primary btn-sm">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="{{ path('enseignant_cours_edit', {'id': cours.id}) }}" class="btn btn-secondary btn-sm">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a href="{{ path('enseignant_chapitre_new', {'id': cours.id}) }}" class="btn btn-success btn-sm">
                                            <i class="fas fa-plus"></i>
                                        </a>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="5" class="text-center">
                                        <div class="alert alert-info">
                                            Vous n'avez pas encore créé de cours. 
                                            <a href="{{ path('enseignant_cours_new') }}" class="alert-link">Créez votre premier cours</a>.
                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Prochains cours -->
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Prochains cours</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Heure</th>
                                    <th>Classe</th>
                                    <th>Matière</th>
                                    <th>Salle</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>05/04/2024</td>
                                    <td>8h-10h</td>
                                    <td>Terminale S1</td>
                                    <td>Mathématiques</td>
                                    <td>Salle 101</td>
                                </tr>
                                <tr>
                                    <td>05/04/2024</td>
                                    <td>10h-12h</td>
                                    <td>Première S2</td>
                                    <td>Physique</td>
                                    <td>Salle 205</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %} 