{% extends 'base.html.twig' %}

{% block title %}Cours - {{ matiere.nom }}{% endblock %}

{% block body %}
<div class="page">
            <div class="page-header">
                <h1 class="h2">Cours - {{ matiere.nom }}</h1>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="{{ path('enseignant_mes_matieres') }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Retour aux matières
                    </a>
                    <a href="{{ path('enseignant_cours_new') }}" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Nouveau cours
                    </a>
                </div>
            </div>

            <!-- Informations de la matière -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0"><i class="fas fa-book me-2"></i>Informations de la matière</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Nom :</strong> {{ matiere.nom }}</p>
                            <p><strong>Coefficient :</strong> {{ matiere.coeficient }}</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Filière :</strong> 
                                {% if matiere.filiere %}
                                    <span class="badge bg-info">{{ matiere.filiere.nom }}</span>
                                {% else %}
                                    <span class="text-muted">Non assignée</span>
                                {% endif %}
                            </p>
                            <p><strong>Nombre de cours :</strong> {{ cours|length }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Liste des cours -->
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="card-title mb-0"><i class="fas fa-list me-2"></i>Liste des cours ({{ cours|length }})</h5>
                </div>
                <div class="card-body">
                    {% if cours|length > 0 %}
                        <div class="row">
                            {% for coursItem in cours %}
                                <div class="col-md-6 col-lg-4 mb-4">
                                    <div class="card h-100">
                                        <div class="card-body">
                                            <h5 class="card-title">
                                                <i class="fas fa-book-open me-2 text-primary"></i>
                                                {{ coursItem.titre }}
                                            </h5>
                                            <p class="card-text">
                                                <small class="text-muted">
                                                    <i class="fas fa-calendar me-1"></i>
                                                    {{ coursItem.dateAjout|date('d/m/Y') }}
                                                </small>
                                            </p>
                                            <p class="card-text">
                                                <strong>Chapitres :</strong> {{ coursItem.chapitres|length }}
                                            </p>
                                            {% if coursItem.contenu %}
                                                <p class="card-text">
                                                    {{ coursItem.contenu|slice(0, 100) }}{% if coursItem.contenu|length > 100 %}...{% endif %}
                                                </p>
                                            {% endif %}
                                        </div>
                                        <div class="card-footer">
                                            <div class="btn-group w-100" role="group">
                                                <a href="{{ path('enseignant_cours_show', {'id': coursItem.id}) }}" class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-eye me-1"></i>Voir
                                                </a>
                                                <a href="{{ path('enseignant_cours_edit', {'id': coursItem.id}) }}" class="btn btn-sm btn-outline-warning">
                                                    <i class="fas fa-edit me-1"></i>Modifier
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-center py-5">
                            <i class="fas fa-book-open fa-3x text-muted mb-3"></i>
                            <h4 class="text-muted">Aucun cours pour cette matière</h4>
                            <p class="text-muted">Commencez par créer votre premier cours.</p>
                            <a href="{{ path('enseignant_cours_new') }}" class="btn btn-primary">
                                <i class="fas fa-plus me-1"></i>Créer un cours
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
{% endblock %}
