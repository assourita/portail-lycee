{% extends 'base.html.twig' %}

{% block title %}Étudiants de {{ filiere.nom }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        {% include 'enseignant/_sidebar.html.twig' %}

        <!-- Main content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Étudiants de {{ filiere.nom }}</h1>
            </div>

            <div class="card">
                <div class="card-body">

        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Prénom</th>
                        <th>Email</th>
                        <th>Date d'inscription</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for etudiant in etudiants %}
                        <tr>
                            <td>{{ etudiant.nom }}</td>
                            <td>{{ etudiant.prenom }}</td>
                            <td>{{ etudiant.email }}</td>
                            <td>{{ etudiant.dateInscription|date('d/m/Y') }}</td>
                            <td>
                                <a href="{{ path('enseignant_note_saisir') }}" class="btn btn-sm btn-info">
                                    <i class="fas fa-graduation-cap"></i> Gérer les notes
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center">
                                Aucun étudiant dans cette filière.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
                </div>
            </div>

            <div class="mt-3">
                <a href="{{ path('app_enseignant_mes_filieres') }}" class="btn btn-secondary">
                    Retour aux filières
                </a>
            </div>
        </main>
    </div>
</div>
{% endblock %} 