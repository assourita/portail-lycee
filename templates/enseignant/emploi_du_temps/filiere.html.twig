{% extends 'base.html.twig' %}

{% block title %}Emploi du Temps - {{ filiere.nom }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        {% include 'enseignant/_sidebar.html.twig' %}

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <div>
                    <h1 class="h2">
                        <i class="fas fa-calendar-alt me-2 text-primary"></i>
                        Emploi du Temps - {{ filiere.nom }}
                    </h1>
                    <p class="text-muted mb-0">
                        <i class="fas fa-user-tie me-1"></i>
                        {{ enseignant.nom }} {{ enseignant.prenom }}
                    </p>
                </div>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <div class="btn-group me-2">
                        <a href="{{ path('app_enseignant_emploi_du_temps') }}" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-arrow-left me-1"></i>Retour
                        </a>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.print()">
                            <i class="fas fa-print me-1"></i>Imprimer
                        </button>
                    </div>
                </div>
            </div>

            <!-- Informations sur la filière -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-university me-2"></i>
                        {{ filiere.nom }}
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p class="mb-1">
                                <strong>Niveau :</strong> 
                                {{ filiere.niveau ?? 'Non spécifié' }}
                            </p>
                            <p class="mb-1">
                                <strong>Description :</strong> 
                                {{ filiere.description ?? 'Aucune description' }}
                            </p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-1">
                                <strong>Total cours dans cette filière :</strong> 
                                {{ emplois_du_temps|length }}
                            </p>
                            <p class="mb-1">
                                <strong>Heures par semaine :</strong> 
                                {% set total_heures = 0 %}
                                {% for emploi in emplois_du_temps %}
                                    {% if emploi.heureDebut and emploi.heureFin %}
                                        {% set duree = emploi.heureFin|date('U') - emploi.heureDebut|date('U') %}
                                        {% set total_heures = total_heures + (duree / 3600) %}
                                    {% endif %}
                                {% endfor %}
                                {{ total_heures|round(1) }}h
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Emploi du temps par jour -->
            {% if emplois_par_jour %}
                <div class="card">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-calendar-alt me-2"></i>
                            Planning hebdomadaire
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th style="width: 15%">Heure</th>
                                        <th style="width: 12%">Lundi</th>
                                        <th style="width: 12%">Mardi</th>
                                        <th style="width: 12%">Mercredi</th>
                                        <th style="width: 12%">Jeudi</th>
                                        <th style="width: 12%">Vendredi</th>
                                        <th style="width: 12%">Samedi</th>
                                        <th style="width: 13%">Dimanche</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% set heures = ['08:00', '09:30', '11:00', '14:00', '15:30', '17:00'] %}
                                    {% for heure in heures %}
                                        <tr>
                                            <td class="fw-bold bg-light text-center">
                                                <i class="fas fa-clock me-1"></i>{{ heure }}
                                            </td>
                                            {% for jour in ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi', 'Dimanche'] %}
                                                <td class="text-center">
                                                    {% set creneau_trouve = false %}
                                                    {% for emploi in emplois_par_jour[jour]|default([]) %}
                                                        {% set heure_debut = emploi.heureDebut|date('H:i') %}
                                                        {% set heure_fin = emploi.heureFin|date('H:i') %}
                                                        {% if heure_debut == heure %}
                                                            <div class="p-2 border rounded bg-success text-white">
                                                                <div class="fw-bold">{{ emploi.matiere.nom }}</div>
                                                                {% if emploi.cours and emploi.cours.salle %}
                                                                    <small><i class="fas fa-door-open me-1"></i>{{ emploi.cours.salle }}</small>
                                                                {% endif %}
                                                                <br>
                                                                <small>{{ heure_debut }} - {{ heure_fin }}</small>
                                                            </div>
                                                            {% set creneau_trouve = true %}
                                                        {% endif %}
                                                    {% endfor %}
                                                    {% if not creneau_trouve %}
                                                        <span class="text-muted">-</span>
                                                    {% endif %}
                                                </td>
                                            {% endfor %}
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Liste détaillée -->
                <div class="card mt-4">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-list me-2"></i>
                            Détail des cours
                        </h5>
                    </div>
                    <div class="card-body">
                        {% for jour in jours %}
                            {% set emploisDuJour = emplois_par_jour[jour.nom]|default([]) %}
                            {% if emploisDuJour %}
                                <div class="mb-4">
                                    <h6 class="text-success mb-3">
                                        <i class="fas fa-calendar-day me-2"></i>{{ jour.nom }}
                                    </h6>
                                    <div class="row">
                                        {% for emploi in emploisDuJour %}
                                            <div class="col-md-6 col-lg-4 mb-3">
                                                <div class="card border-left-success shadow h-100">
                                                    <div class="card-body">
                                                        <div class="d-flex align-items-center mb-2">
                                                            <i class="fas fa-book text-success me-2"></i>
                                                            <h6 class="card-title mb-0">{{ emploi.matiere.nom }}</h6>
                                                        </div>
                                                        <p class="card-text">
                                                            <small class="text-muted">
                                                                <i class="fas fa-clock me-1"></i>
                                                                {{ emploi.heureDebut|date('H:i') }} - {{ emploi.heureFin|date('H:i') }}
                                                            </small><br>
                                                            {% if emploi.cours and emploi.cours.salle %}
                                                                <i class="fas fa-door-open me-1"></i>
                                                                Salle {{ emploi.cours.salle }}
                                                            {% endif %}
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            {% else %}
                <div class="text-center py-5">
                    <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">Aucun cours pour cette filière</h4>
                    <p class="text-muted">Vous n'avez aucun cours programmé pour la filière {{ filiere.nom }}.</p>
                </div>
            {% endif %}
        </main>
    </div>
</div>

<style>
@media print {
    .btn-toolbar, .card-header, .sidebar {
        display: none !important;
    }
    
    .table {
        font-size: 12px;
    }
    
    .container-fluid {
        margin: 0;
        padding: 0;
    }
    
    main {
        margin-left: 0 !important;
        padding: 0 !important;
    }
}

.table td {
    vertical-align: middle;
    min-height: 60px;
}

.border-left-success {
    border-left: 0.25rem solid #1cc88a !important;
}

.bg-success {
    background-color: #1cc88a !important;
}
</style>
{% endblock %}
