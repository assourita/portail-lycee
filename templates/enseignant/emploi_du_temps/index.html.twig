{% extends 'base.html.twig' %}

{% block title %}Mon Emploi du Temps{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        {% include 'enseignant/_sidebar.html.twig' %}

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <div>
                    <h1 class="h2">
                        <i class="fas fa-calendar-alt me-2 text-primary"></i>
                        Mon Emploi du Temps
                    </h1>
                    <p class="text-muted mb-0">
                        <i class="fas fa-user-tie me-1"></i>
                        {{ enseignant.nom }} {{ enseignant.prenom }}
                    </p>
                </div>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <div class="btn-group me-2">
                        <a href="{{ path('enseignant_emploi_du_temps_semaine') }}" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-calendar-week me-1"></i>Vue Semaine
                        </a>
                        <a href="{{ path('enseignant_emploi_du_temps_export') }}" class="btn btn-sm btn-outline-success">
                            <i class="fas fa-download me-1"></i>Exporter
                        </a>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.print()">
                            <i class="fas fa-print me-1"></i>Imprimer
                        </button>
                    </div>
                </div>
            </div>

            <!-- Statistiques -->
            <div class="row mb-4">
                <div class="col-md-3 col-sm-6 mb-3">
                    <div class="card border-primary shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                        Total Cours
                                    </div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">{{ stats.total_cours }}</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-book fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 col-sm-6 mb-3">
                    <div class="card border-success shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                        Heures/Semaine
                                    </div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">{{ stats.total_heures|round(1) }}h</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-clock fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 col-sm-6 mb-3">
                    <div class="card border-info shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                        Filières
                                    </div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">{{ stats.total_filieres }}</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-university fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 col-sm-6 mb-3">
                    <div class="card border-warning shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                        Matières
                                    </div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">{{ stats.matieres_differentes }}</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-chalkboard fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Emploi du temps par jour -->
            {% if emplois_par_jour %}
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-calendar-alt me-2"></i>
                            Emploi du temps hebdomadaire
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th style="width: 15%">Heure</th>
                                        <th style="width: 12%">Lundi</th>
                                        <th style="width: 12%">Mardi</th>
                                        <th style="width: 12%">Mercredi</th>
                                        <th style="width: 12%">Jeudi</th>
                                        <th style="width: 12%">Vendredi</th>
                                        <th style="width: 12%">Samedi</th>
                                        <th style="width: 13%">Dimanche</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% set heures = ['08:00', '09:30', '11:00', '14:00', '15:30', '17:00'] %}
                                    {% for heure in heures %}
                                        <tr>
                                            <td class="fw-bold bg-light text-center">
                                                <i class="fas fa-clock me-1"></i>{{ heure }}
                                            </td>
                                            {% for jour in ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi', 'Dimanche'] %}
                                                <td class="text-center">
                                                    {% set creneau_trouve = false %}
                                                    {% for emploi in emplois_par_jour[jour]|default([]) %}
                                                        {% set heure_debut = emploi.heureDebut|date('H:i') %}
                                                        {% set heure_fin = emploi.heureFin|date('H:i') %}
                                                        {% if heure_debut == heure %}
                                                            <div class="p-2 border rounded bg-info text-white">
                                                                <div class="fw-bold">{{ emploi.matiere.nom }}</div>
                                                                <small>{{ emploi.filiere ? emploi.filiere.nom : '' }}</small>
                                                                <br>
                                                                {% if emploi.cours and emploi.cours.salle %}
                                                                    <small><i class="fas fa-door-open me-1"></i>{{ emploi.cours.salle }}</small>
                                                                {% endif %}
                                                                <br>
                                                                <small>{{ heure_debut }} - {{ heure_fin }}</small>
                                                            </div>
                                                            {% set creneau_trouve = true %}
                                                        {% endif %}
                                                    {% endfor %}
                                                    {% if not creneau_trouve %}
                                                        <span class="text-muted">-</span>
                                                    {% endif %}
                                                </td>
                                            {% endfor %}
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Liste détaillée par jour -->
                <div class="card mt-4">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-list me-2"></i>
                            Détail par jour
                        </h5>
                    </div>
                    <div class="card-body">
                        {% for jour in jours %}
                            {% set emploisDuJour = emplois_par_jour[jour.nom]|default([]) %}
                            {% if emploisDuJour %}
                                <div class="mb-4">
                                    <h6 class="text-primary mb-3">
                                        <i class="fas fa-calendar-day me-2"></i>{{ jour.nom }}
                                    </h6>
                                    <div class="row">
                                        {% for emploi in emploisDuJour %}
                                            <div class="col-md-6 col-lg-4 mb-3">
                                                <div class="card border-left-primary shadow h-100">
                                                    <div class="card-body">
                                                        <div class="d-flex align-items-center mb-2">
                                                            <i class="fas fa-book text-primary me-2"></i>
                                                            <h6 class="card-title mb-0">{{ emploi.matiere.nom }}</h6>
                                                        </div>
                                                        <p class="card-text">
                                                            <small class="text-muted">
                                                                <i class="fas fa-clock me-1"></i>
                                                                {{ emploi.heureDebut|date('H:i') }} - {{ emploi.heureFin|date('H:i') }}
                                                            </small><br>
                                                            <i class="fas fa-university me-1"></i>
                                                            {{ emploi.filiere ? emploi.filiere.nom : 'Non assignée' }}
                                                            {% if emploi.cours and emploi.cours.salle %}
                                                                <br>
                                                                <i class="fas fa-door-open me-1"></i>
                                                                Salle {{ emploi.cours.salle }}
                                                            {% endif %}
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            {% else %}
                <div class="text-center py-5">
                    <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">Aucun emploi du temps</h4>
                    <p class="text-muted">Votre emploi du temps n'a pas encore été configuré.</p>
                    <p class="text-muted">Contactez l'administration pour plus d'informations.</p>
                </div>
            {% endif %}
        </main>
    </div>
</div>

<style>
@media print {
    .btn-toolbar, .card-header, .sidebar {
        display: none !important;
    }
    
    .table {
        font-size: 12px;
    }
    
    .container-fluid {
        margin: 0;
        padding: 0;
    }
    
    main {
        margin-left: 0 !important;
        padding: 0 !important;
    }
}

.table td {
    vertical-align: middle;
    min-height: 60px;
}

.border-left-primary {
    border-left: 0.25rem solid #4e73df !important;
}

.text-xs {
    font-size: 0.7rem;
}

.text-gray-300 {
    color: #dddfeb !important;
}

.text-gray-800 {
    color: #5a5c69 !important;
}
</style>
{% endblock %}
