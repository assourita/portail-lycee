{% extends 'base.html.twig' %}

{% block title %}Mon Emploi du Temps{% endblock %}

{% block body %}
<div class="page">
            <div class="page-header">
                <h1 class="h2">Mon Emploi du Temps</h1>
            </div>

            <div class="card">
                <div class="card-body">

        <div class="table-responsive">
            <table class="table table-bordered">
                <thead class="thead-dark">
                    <tr>
                        <th>Jour</th>
                        <th>Heure de début</th>
                        <th>Heure de fin</th>
                        <th>Classe</th>
                        <th>Matière</th>
                    </tr>
                </thead>
                <tbody>
                    {% for cours in emploiDuTemps %}
                        <tr>
                            <td>{{ cours.jour|date('l')|trans }}</td>
                            <td>{{ cours.heureDebut|date('H:i') }}</td>
                            <td>{{ cours.heureFin|date('H:i') }}</td>
                            <td>{{ cours.classe.nom }}</td>
                            <td>{{ cours.matiere }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center">Aucun cours programmé</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
                </div>
            </div>
        </div>
{% endblock %} 