{% extends 'base.html.twig' %}

{% block title %}Ajouter des notes{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        {% include 'enseignant/_sidebar.html.twig' %}

        <!-- Main content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Ajouter des notes</h1>
            </div>

    {% if not selectedFiliere %}
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Sélectionner une filière</h5>
                <form method="post">
                    <div class="mb-3">
                        <label for="filiere" class="form-label">Filière</label>
                        <select name="filiere" id="filiere" class="form-select" required>
                            <option value="">Choisir une filière</option>
                            {% for filiereId, data in filieres %}
                                <option value="{{ filiereId }}">{{ data.filiere.nom }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Sélectionner</button>
                </form>
            </div>
        </div>
    {% else %}
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Filière : {{ selectedFiliere.nom }}</h5>
                <a href="{{ path('enseignant_note_new') }}" class="btn btn-secondary">Changer de filière</a>
            </div>
        </div>

        <form method="post">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Étudiant</th>
                            <th>Matière</th>
                            <th>Note</th>
                            <th>Type</th>
                            <th>Commentaire</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for formData in forms %}
                            <tr>
                                <td>{{ formData.etudiant.nom }} {{ formData.etudiant.prenom }}</td>
                                <td>{{ form_widget(formData.form.matiere) }}</td>
                                <td>{{ form_widget(formData.form.valeur) }}</td>
                                <td>{{ form_widget(formData.form.type) }}</td>
                                <td>{{ form_widget(formData.form.commentaire) }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Enregistrer les notes</button>
                <a href="{{ path('enseignant_note_index') }}" class="btn btn-secondary">Annuler</a>
            </div>
        </form>
    {% endif %}
        </main>
    </div>
</div>
{% endblock %} 