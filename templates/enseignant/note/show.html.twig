{% extends 'base.html.twig' %}

{% block title %}Détails de la note{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        {% include 'enseignant/_sidebar.html.twig' %}

        <!-- Main content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Détails de la note</h1>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="{{ path('enseignant_note_edit', {'id': note.id}) }}" class="btn btn-warning me-2">
                        <i class="fas fa-edit"></i> Modifier
                    </a>
                    <a href="{{ path('enseignant_note_index') }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Retour
                    </a>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-bordered">
                                <tr>
                                    <th style="width: 200px;">Étudiant</th>
                                    <td>{{ note.etudiant.nom }} {{ note.etudiant.prenom }}</td>
                                </tr>
                                <tr>
                                    <th>Matière</th>
                                    <td>{{ note.matiere.nom }}</td>
                                </tr>
                                <tr>
                                    <th>Note</th>
                                    <td>{{ note.valeur }}/20</td>
                                </tr>
                                <tr>
                                    <th>Type</th>
                                    <td>
                                        {% if note.type == 'devoir' %}
                                            <span class="badge bg-info">Devoir</span>
                                        {% elseif note.type == 'examen' %}
                                            <span class="badge bg-warning">Examen</span>
                                        {% elseif note.type == 'projet' %}
                                            <span class="badge bg-success">Projet</span>
                                        {% else %}
                                            <span class="badge bg-secondary">Participation</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                <tr>
                                    <th>Date</th>
                                    <td>{{ note.dateNote|date('d/m/Y') }}</td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">
                                    <h3 class="card-title">Commentaire</h3>
                                </div>
                                <div class="card-body">
                                    {% if note.commentaire %}
                                        {{ note.commentaire|nl2br }}
                                    {% else %}
                                        <p class="text-muted">Aucun commentaire</p>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}