{% extends 'base.html.twig' %}

{% block title %}Notes de {{ etudiant.nom }} {{ etudiant.prenom }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        {% include 'enseignant/_sidebar.html.twig' %}

        <!-- Main content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Notes de {{ etudiant.nom }} {{ etudiant.prenom }}</h1>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="{{ path('enseignant_filiere_etudiants', {'id': etudiant.filiere.id}) }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Retour à la liste
                    </a>
                </div>
            </div>

            <!-- Informations de l'étudiant -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Informations de l'étudiant</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Nom :</strong> {{ etudiant.nom }}</p>
                            <p><strong>Prénom :</strong> {{ etudiant.prenom }}</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Email :</strong> {{ etudiant.email }}</p>
                            <p><strong>Filière :</strong> {{ etudiant.filiere.nom }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Formulaire d'ajout de note -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Ajouter une note</h5>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                        <!-- Champ étudiant caché -->
                        {{ form_widget(form.etudiant, {'attr': {'style': 'display: none;'}}) }}
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    {{ form_label(form.matiere) }}
                                    {{ form_widget(form.matiere, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.matiere) }}
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-3">
                                    {{ form_label(form.valeur) }}
                                    {{ form_widget(form.valeur, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.valeur) }}
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-3">
                                    {{ form_label(form.type) }}
                                    {{ form_widget(form.type, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.type) }}
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            {{ form_label(form.commentaire) }}
                            {{ form_widget(form.commentaire, {'attr': {'class': 'form-control', 'rows': 3}}) }}
                            {{ form_errors(form.commentaire) }}
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Enregistrer la note
                        </button>
                    {{ form_end(form) }}
                </div>
            </div>

            <!-- Historique des notes -->
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Historique des notes</h5>
                </div>
                <div class="card-body">
                    {% if notes|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Matière</th>
                                        <th>Note</th>
                                        <th>Type</th>
                                        <th>Commentaire</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for note in notes %}
                                        <tr>
                                            <td>{{ note.dateNote|date('d/m/Y') }}</td>
                                            <td>{{ note.matiere.nom }}</td>
                                            <td><strong>{{ note.valeur }}/20</strong></td>
                                            <td>
                                                {% if note.type == 'devoir' %}
                                                    <span class="badge bg-info">Devoir</span>
                                                {% elseif note.type == 'examen' %}
                                                    <span class="badge bg-warning">Examen</span>
                                                {% elseif note.type == 'projet' %}
                                                    <span class="badge bg-success">Projet</span>
                                                {% else %}
                                                    <span class="badge bg-secondary">Participation</span>
                                                {% endif %}
                                            </td>
                                            <td>{{ note.commentaire|default('') }}</td>
                                            <td>
                                                <a href="{{ path('enseignant_note_edit', {'id': note.id}) }}" class="btn btn-sm btn-warning">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <form method="post" action="{{ path('enseignant_note_delete', {'id': note.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette note ?');" style="display: inline;">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ note.id) }}">
                                                    <button class="btn btn-sm btn-danger">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="alert alert-info">
                            Aucune note enregistrée pour cet étudiant.
                        </div>
                    {% endif %}
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}
