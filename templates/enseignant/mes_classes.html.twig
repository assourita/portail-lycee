{% extends 'base.html.twig' %}

{% block title %}Mes Classes{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="mb-4">Mes Classes</h1>

        <div class="row">
            {% for classe in classes %}
                <div class="col-md-4 mb-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">{{ classe.nom }}</h5>
                            <p class="card-text">
                                <strong>Niveau :</strong> {{ classe.niveau }}<br>
                                <strong>Effectif :</strong> {{ classe.etudiants|length }} étudiants
                            </p>
                            <a href="{{ path('enseignant_liste_etudiants', {'classeId': classe.id}) }}" class="btn btn-primary">
                                Voir les étudiants
                            </a>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="alert alert-info">
                        Vous n'êtes pas assigné à aucune classe pour le moment.
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %} 