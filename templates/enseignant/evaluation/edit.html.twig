{% extends 'base.html.twig' %}

{% block title %}Modifier - {{ evaluation.nom }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        {% include 'enseignant/_sidebar.html.twig' %}

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <!-- En-tête -->
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <div>
                    <h1 class="h2">
                        <i class="fas fa-edit me-2 text-warning"></i>
                        Modifier l'Évaluation
                    </h1>
                    <p class="text-muted mb-0">{{ evaluation.nom }}</p>
                </div>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="{{ path('enseignant_evaluation_show', {'id': evaluation.id}) }}" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Retour
                    </a>
                </div>
            </div>

            <!-- Messages flash -->
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            <!-- Formulaire -->
            <div class="row">
                <div class="col-md-8">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <i class="fas fa-edit me-2"></i>Modifier les Informations
                            </h5>
                        </div>
                        <div class="card-body">
                            <form method="post">
                                <div class="mb-3">
                                    <label for="nom" class="form-label">
                                        <i class="fas fa-heading me-1"></i>Nom de l'évaluation *
                                    </label>
                                    <input type="text" class="form-control" id="nom" name="nom" 
                                           value="{{ evaluation.nom }}" required>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">
                                        <i class="fas fa-book me-1"></i>Matière
                                    </label>
                                    <input type="text" class="form-control" value="{{ evaluation.matiere.nom }}" disabled>
                                    <div class="form-text">La matière ne peut pas être modifiée</div>
                                </div>

                                <div class="mb-3">
                                    <label for="description" class="form-label">
                                        <i class="fas fa-align-left me-1"></i>Description
                                    </label>
                                    <textarea class="form-control" id="description" name="description" rows="3">{{ evaluation.description }}</textarea>
                                </div>

                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label for="date_evaluation" class="form-label">
                                            <i class="fas fa-calendar me-1"></i>Date *
                                        </label>
                                        <input type="date" class="form-control" id="date_evaluation" 
                                               name="date_evaluation" value="{{ evaluation.dateEvaluation|date('Y-m-d') }}" required>
                                    </div>

                                    <div class="col-md-4 mb-3">
                                        <label for="coefficient" class="form-label">
                                            <i class="fas fa-weight me-1"></i>Coefficient *
                                        </label>
                                        <input type="number" class="form-control" id="coefficient" 
                                               name="coefficient" value="{{ evaluation.coefficient }}" min="1" max="10" required>
                                    </div>

                                    <div class="col-md-4 mb-3">
                                        <label for="note_max" class="form-label">
                                            <i class="fas fa-star me-1"></i>Note Max *
                                        </label>
                                        <input type="number" class="form-control" id="note_max" 
                                               name="note_max" value="{{ evaluation.noteMax }}" min="1" max="100" required>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label for="trimestre" class="form-label">
                                        <i class="fas fa-calendar-week me-1"></i>Trimestre *
                                    </label>
                                    <select class="form-select" id="trimestre" name="trimestre" required>
                                        <option value="">Sélectionner un trimestre</option>
                                        {% for trimestre in trimestres %}
                                            <option value="{{ trimestre.id }}" {% if trimestre.id == evaluation.trimestre.id %}selected{% endif %}>
                                                {{ trimestre.nom }} ({{ trimestre.classe.nom }})
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>

                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                    <a href="{{ path('enseignant_evaluation_show', {'id': evaluation.id}) }}" class="btn btn-secondary me-md-2">
                                        <i class="fas fa-times me-1"></i>Annuler
                                    </a>
                                    <button type="submit" class="btn btn-warning">
                                        <i class="fas fa-save me-1"></i>Enregistrer les Modifications
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <!-- Statistiques -->
                    <div class="card">
                        <div class="card-header">
                            <h6 class="mb-0">
                                <i class="fas fa-chart-bar me-2"></i>Statistiques
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="text-center">
                                <h2 class="text-primary">{{ evaluation.notes|length }}</h2>
                                <p class="text-muted">Note(s) saisie(s)</p>
                            </div>
                            
                            <hr>
                            
                            <div class="alert alert-warning">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                <strong>Attention :</strong> Modifier cette évaluation peut affecter les notes déjà saisies.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}
