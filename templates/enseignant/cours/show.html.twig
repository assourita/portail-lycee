{% extends 'base.html.twig' %}

{% block title %}{{ cours.titre }}{% endblock %}

{% block body %}
<div class="page">
            <div class="page-header">
                <h1 class="h2">{{ cours.titre }}</h1>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="{{ path('enseignant_cours_edit', {'id': cours.id}) }}" class="btn btn-secondary me-2">
                        <i class="fas fa-edit"></i> Modifier
                    </a>
                    <a href="{{ path('enseignant_chapitre_new', {'id': cours.id}) }}" class="btn btn-primary me-2">
                        <i class="fas fa-plus"></i> Ajouter un chapitre
                    </a>
                    <form method="post" action="{{ path('enseignant_cours_delete', {'id': cours.id}) }}" class="d-inline"
                          onsubmit="return confirm('Supprimer ce cours, ses chapitres et leurs pièces jointes ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-cours' ~ cours.id) }}">
                        <button class="btn btn-outline-danger"><i class="fas fa-trash"></i></button>
                    </form>
                </div>
            </div>

            <div class="row">
                <div class="col-md-8">
                    <div class="card mb-4">
                        <div class="card-body">
                            <h5 class="card-title">Description</h5>
                            <p class="card-text">{{ cours.description }}</p>
                            <p class="card-text">
                                <small class="text-muted">
                                    <i class="fas fa-book"></i> {{ cours.matiere.nom }}
                                </small>
                            </p>
                            <p class="card-text">
                                <small class="text-muted">
                                    <i class="fas fa-graduation-cap"></i> {{ cours.matiere.filiere.nom }}
                                </small>
                            </p>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Chapitres</h5>
                        </div>
                        <div class="card-body">
                            {% if cours.chapitres|length > 0 %}
                                <div class="list-group">
                                    {% for chapitre in cours.chapitres|sort((a, b) => a.ordre <=> b.ordre) %}
                                        <div class="list-group-item">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <h6 class="mb-1">Chapitre {{ chapitre.ordre }}: {{ chapitre.titre }}</h6>
                                                <div>
                                                    <a href="{{ path('enseignant_chapitre_show', {'id': chapitre.id}) }}" class="btn btn-sm btn-success me-1">
                                                        <i class="fas fa-eye"></i> Lire
                                                    </a>
                                                    <a href="{{ path('enseignant_chapitre_edit', {'id': chapitre.id}) }}" class="btn btn-sm btn-outline-primary me-1">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <span class="btn btn-sm btn-secondary me-1" title="Fonctionnalité à venir">
                                                        <i class="fas fa-edit"></i>
                                                    </span>
                                                    <span class="btn btn-sm btn-secondary" title="Fonctionnalité à venir">
                                                        <i class="fas fa-trash"></i>
                                                    </span>
                                                </div>
                                            </div>
                                            <p class="mb-1">{{ chapitre.contenu|slice(0, 150) }}...</p>
                                            <small class="text-muted">
                                                <i class="fas fa-paperclip me-1"></i>
                                                {{ chapitre.piecesJointes|length }} pièce(s) jointe(s)
                                            </small>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <div class="alert alert-info">
                                    Aucun chapitre n'a été ajouté à ce cours.
                                    <a href="{{ path('enseignant_chapitre_new', {'id': cours.id}) }}" class="alert-link">
                                        Ajoutez votre premier chapitre
                                    </a>.
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Statistiques</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <h6>Nombre de chapitres</h6>
                                <p class="h3">{{ cours.chapitres|length }}</p>
                            </div>
                            <div class="mb-3">
                                <h6>Matière</h6>
                                <p><i class="fas fa-book me-1"></i>{{ cours.matiere.nom }}</p>
                            </div>
                            <div class="mb-3">
                                <h6>Filière</h6>
                                <p><i class="fas fa-graduation-cap me-1"></i>{{ cours.matiere.filiere.nom }}</p>
                            </div>
                            <div class="mb-3">
                                <h6>Date de création</h6>
                                <p>{{ cours.dateAjout|date('d/m/Y') }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
{% endblock %} 