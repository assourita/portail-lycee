{% extends 'base.html.twig' %}

{% block title %}Nouveau Chapitre - {{ cours.titre }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        {% include 'enseignant/_sidebar.html.twig' %}

        <!-- Main content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Ajouter un chapitre à "{{ cours.titre }}"</h1>
            </div>

            <div class="card">
                <div class="card-body">
                    {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
                    
                    <div class="row">
                        <div class="col-md-8">
                            <div class="mb-3">
                                {{ form_label(form.titre) }}
                                {{ form_widget(form.titre) }}
                                {{ form_errors(form.titre) }}
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.contenu) }}
                                {{ form_widget(form.contenu) }}
                                {{ form_errors(form.contenu) }}
                            </div>
                        </div>
                        
                        <div class="col-md-4">
                            <div class="mb-3">
                                {{ form_label(form.ordre) }}
                                {{ form_widget(form.ordre) }}
                                {{ form_errors(form.ordre) }}
                            </div>
                        </div>
                    </div>

                    <!-- Section Pièces jointes -->
                    <div class="mb-4">
                        <h5 class="mb-3">
                            <i class="fas fa-paperclip me-2"></i>Pièces jointes
                        </h5>
                        
                        <div class="pieces-jointes-container" data-prototype="{{ form_widget(form.piecesJointes.vars.prototype)|e('html_attr') }}">
                            {% for pieceJointe in form.piecesJointes %}
                                <div class="piece-jointe-item border rounded p-3 mb-3">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="mb-2">
                                                {{ form_label(pieceJointe.nom) }}
                                                {{ form_widget(pieceJointe.nom) }}
                                                {{ form_errors(pieceJointe.nom) }}
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="mb-2">
                                                {{ form_label(pieceJointe.fichier) }}
                                                {{ form_widget(pieceJointe.fichier) }}
                                                {{ form_errors(pieceJointe.fichier) }}
                                            </div>
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-danger remove-piece-jointe">
                                        <i class="fas fa-trash"></i> Supprimer
                                    </button>
                                </div>
                            {% endfor %}
                        </div>
                        
                        <button type="button" class="btn btn-outline-primary add-piece-jointe">
                            <i class="fas fa-plus"></i> Ajouter une pièce jointe
                        </button>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="{{ path('enseignant_cours_show', {'id': cours.id}) }}" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Retour
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Créer le chapitre
                        </button>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </main>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const container = document.querySelector('.pieces-jointes-container');
    const addButton = document.querySelector('.add-piece-jointe');
    const prototype = container.dataset.prototype;
    let index = container.children.length;

    addButton.addEventListener('click', function() {
        const newForm = prototype.replace(/__name__/g, index);
        const div = document.createElement('div');
        div.className = 'piece-jointe-item border rounded p-3 mb-3';
        div.innerHTML = newForm + '<button type="button" class="btn btn-sm btn-danger remove-piece-jointe"><i class="fas fa-trash"></i> Supprimer</button>';
        
        container.appendChild(div);
        index++;
    });

    container.addEventListener('click', function(e) {
        if (e.target.closest('.remove-piece-jointe')) {
            e.target.closest('.piece-jointe-item').remove();
        }
    });
});
</script>
{% endblock %} 