{% extends 'base.html.twig' %}

{% block title %}Modifier le chapitre : {{ chapitre.titre }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        {% include 'enseignant/_sidebar.html.twig' %}

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Modifier le chapitre</h1>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="{{ path('enseignant_chapitre_show', {'id': chapitre.id}) }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Retour
                    </a>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-edit me-2"></i>{{ chapitre.cours.titre }}
                    </h5>
                </div>
                <div class="card-body">
                    {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
                        <div class="row">
                            <div class="col-md-9 mb-3">
                                {{ form_label(form.titre, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.titre) }}
                                {{ form_errors(form.titre) }}
                            </div>
                            <div class="col-md-3 mb-3">
                                {{ form_label(form.ordre, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.ordre) }}
                                {{ form_errors(form.ordre) }}
                            </div>
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.contenu, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.contenu) }}
                            {{ form_errors(form.contenu) }}
                        </div>

                        {% if chapitre.piecesJointes|length > 0 %}
                            <div class="mb-3">
                                <label class="form-label">Pièces jointes actuelles</label>
                                <ul class="list-group">
                                    {% for pieceJointe in chapitre.piecesJointes %}
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <a href="{{ path('enseignant_piece_jointe_download', {'id': pieceJointe.id}) }}">
                                                <i class="fas fa-file me-1"></i>{{ pieceJointe.nom }}
                                            </a>
                                            <div class="form-check mb-0">
                                                <input class="form-check-input" type="checkbox" name="supprimer_pieces[]"
                                                       value="{{ pieceJointe.id }}" id="suppr{{ pieceJointe.id }}">
                                                <label class="form-check-label text-danger small" for="suppr{{ pieceJointe.id }}">Supprimer</label>
                                            </div>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}

                        <div class="mb-4">
                            {{ form_label(form.nouveauxFichiers, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.nouveauxFichiers) }}
                            {{ form_errors(form.nouveauxFichiers) }}
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="{{ path('enseignant_cours_show', {'id': chapitre.cours.id}) }}" class="btn btn-outline-secondary">
                                <i class="fas fa-book"></i> Retour au cours
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Enregistrer
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>

            <form method="post" action="{{ path('enseignant_chapitre_delete', {'id': chapitre.id}) }}"
                  onsubmit="return confirm('Supprimer définitivement ce chapitre et ses pièces jointes ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete-chapitre' ~ chapitre.id) }}">
                <button class="btn btn-outline-danger"><i class="fas fa-trash me-1"></i>Supprimer ce chapitre</button>
            </form>
        </main>
    </div>
</div>
{% endblock %}
