{% extends 'base.html.twig' %}

{% block title %}Modifier le chapitre : {{ chapitre.titre }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        {% include 'enseignant/_sidebar.html.twig' %}

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Modifier le chapitre</h1>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="{{ path('enseignant_chapitre_show', {'id': chapitre.id}) }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Retour
                    </a>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-edit me-2"></i>Modifier le chapitre : {{ chapitre.titre }}
                    </h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        La fonctionnalité d'édition des chapitres sera bientôt disponible.
                    </div>
                    
                    <div class="d-flex justify-content-between">
                        <a href="{{ path('enseignant_chapitre_show', {'id': chapitre.id}) }}" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Retour à la lecture
                        </a>
                        <a href="{{ path('enseignant_cours_show', {'id': chapitre.cours.id}) }}" class="btn btn-primary">
                            <i class="fas fa-book"></i> Retour au cours
                        </a>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}
