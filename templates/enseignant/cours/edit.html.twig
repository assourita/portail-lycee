{% extends 'base.html.twig' %}

{% block title %}Modifier le cours{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        {% include 'enseignant/_sidebar.html.twig' %}

        <!-- Main content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Modifier le cours</h1>
            </div>

            <div class="card">
                <div class="card-body">
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.titre) }}
                            {{ form_widget(form.titre) }}
                            {{ form_errors(form.titre) }}
                        </div>
                        <div class="mb-3">
                            {{ form_label(form.contenu) }}
                            {{ form_widget(form.contenu) }}
                            {{ form_errors(form.contenu) }}
                        </div>
                        <div class="mb-3">
                            {{ form_label(form.matiere) }}
                            {{ form_widget(form.matiere) }}
                            {{ form_errors(form.matiere) }}
                        </div>

                        <div class="d-flex gap-2">
                            <button class="btn btn-primary">{{ button_label|default('Mettre à jour') }}</button>
                            <a href="{{ path('enseignant_cours_show', {'id': cours.id}) }}" class="btn btn-info">
                                <i class="fas fa-eye"></i> Voir
                            </a>
                            <a href="{{ path('enseignant_cours_index') }}" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Retour à la liste
                            </a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}
