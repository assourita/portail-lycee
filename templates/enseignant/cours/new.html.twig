{% extends 'base.html.twig' %}

{% block title %}Nouveau cours{% endblock %}

{% block body %}
<div class="page">
            <div class="page-header">
                <h1 class="h2">Créer un nouveau cours</h1>
            </div>

            <div class="card">
                <div class="card-body">
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.titre) }}
                            {{ form_widget(form.titre) }}
                            {{ form_errors(form.titre) }}
                        </div>
                        <div class="mb-3">
                            {{ form_label(form.contenu) }}
                            {{ form_widget(form.contenu) }}
                            {{ form_errors(form.contenu) }}
                        </div>
                        <div class="mb-3">
                            {{ form_label(form.matiere) }}
                            {{ form_widget(form.matiere) }}
                            {{ form_errors(form.matiere) }}
                        </div>

                        <div class="d-flex gap-2">
                            <button class="btn btn-primary">{{ button_label|default('Enregistrer') }}</button>
                            <a href="{{ path('enseignant_cours_index') }}" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Retour à la liste
                            </a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
{% endblock %} 