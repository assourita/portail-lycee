{% extends 'base.html.twig' %}

{% block title %}Corriger - {{ soumission.etudiant.nom }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        {% include 'enseignant/_sidebar.html.twig' %}

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <!-- En-tête -->
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <div>
                    <h1 class="h2">
                        <i class="fas fa-pen me-2 text-primary"></i>
                        Corriger la Soumission
                    </h1>
                    <p class="text-muted mb-0">
                        {{ soumission.etudiant.nom }} {{ soumission.etudiant.prenom }} - {{ devoir.titre }}
                    </p>
                </div>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="{{ path('enseignant_devoir_show', {'id': devoir.id}) }}" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Retour
                    </a>
                </div>
            </div>

            <!-- Messages flash -->
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            <div class="row">
                <div class="col-md-8">
                    <!-- Travail de l'étudiant -->
                    <div class="card mb-4">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-file-alt me-2"></i>Travail de l'Étudiant
                            </h5>
                        </div>
                        <div class="card-body">
                            <p><strong>Soumis le :</strong> {{ soumission.dateSoumission|date('d/m/Y à H:i') }}</p>
                            
                            {% if soumission.isEnRetard %}
                                <div class="alert alert-warning">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    Soumission en retard de {{ soumission.delaiSoumission }} jour(s)
                                </div>
                            {% endif %}

                            {% if soumission.commentaire %}
                                <p><strong>Réponse de l'étudiant :</strong></p>
                                <div class="bg-light p-3 rounded">
                                    {{ soumission.commentaire|nl2br }}
                                </div>
                            {% else %}
                                <p class="text-muted">Aucun commentaire fourni</p>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Formulaire de correction -->
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <i class="fas fa-pen me-2"></i>Correction
                            </h5>
                        </div>
                        <div class="card-body">
                            <form method="post">
                                <div class="mb-3">
                                    <label for="note" class="form-label">
                                        <i class="fas fa-star me-1"></i>Note * (sur {{ devoir.noteMax }})
                                    </label>
                                    <input type="number" class="form-control" id="note" name="note" 
                                           value="{{ soumission.note }}" 
                                           min="0" max="{{ devoir.noteMax }}" step="0.5" required>
                                </div>

                                <div class="mb-3">
                                    <label for="commentaire" class="form-label">
                                        <i class="fas fa-comment me-1"></i>Commentaire / Appréciation
                                    </label>
                                    <textarea class="form-control" id="commentaire" name="commentaire" rows="6"
                                              placeholder="Votre appréciation, conseils, points à améliorer...">{{ soumission.commentaireEnseignant }}</textarea>
                                </div>

                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                    <a href="{{ path('enseignant_devoir_show', {'id': devoir.id}) }}" class="btn btn-secondary me-md-2">
                                        <i class="fas fa-times me-1"></i>Annuler
                                    </a>
                                    <button type="submit" class="btn btn-success">
                                        <i class="fas fa-check me-1"></i>Enregistrer la Correction
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <!-- Informations étudiant -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h6 class="mb-0">
                                <i class="fas fa-user me-2"></i>Étudiant
                            </h6>
                        </div>
                        <div class="card-body">
                            <p><strong>Nom :</strong><br>{{ soumission.etudiant.nom }} {{ soumission.etudiant.prenom }}</p>
                            <p><strong>Filière :</strong><br>{{ soumission.etudiant.filiere.nom }}</p>
                            <p><strong>Email :</strong><br>{{ soumission.etudiant.email }}</p>
                        </div>
                    </div>

                    <!-- Barème suggéré -->
                    <div class="card">
                        <div class="card-header">
                            <h6 class="mb-0">
                                <i class="fas fa-chart-bar me-2"></i>Barème Suggéré
                            </h6>
                        </div>
                        <div class="card-body">
                            <ul class="list-unstyled">
                                <li><span class="badge bg-success">{{ (devoir.noteMax * 0.9)|round(1) }}-{{ devoir.noteMax }}</span> Excellent</li>
                                <li><span class="badge bg-info">{{ (devoir.noteMax * 0.7)|round(1) }}-{{ (devoir.noteMax * 0.89)|round(1) }}</span> Bien</li>
                                <li><span class="badge bg-warning">{{ (devoir.noteMax * 0.5)|round(1) }}-{{ (devoir.noteMax * 0.69)|round(1) }}</span> Passable</li>
                                <li><span class="badge bg-danger">0-{{ (devoir.noteMax * 0.49)|round(1) }}</span> Insuffisant</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}
