{% extends 'base.html.twig' %}

{% block title %}{{ devoir.titre }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        {% include 'enseignant/_sidebar.html.twig' %}

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <!-- En-tête -->
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <div>
                    <h1 class="h2">
                        <i class="fas fa-tasks me-2 text-primary"></i>
                        {{ devoir.titre }}
                    </h1>
                    <p class="text-muted mb-0">
                        <i class="fas fa-book me-1"></i>{{ devoir.matiere.nom }} - 
                        <i class="fas fa-calendar me-1"></i>Échéance : {{ devoir.dateEcheance|date('d/m/Y à H:i') }}
                    </p>
                </div>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <div class="btn-group me-2">
                        <a href="{{ path('enseignant_devoir_edit', {'id': devoir.id}) }}" class="btn btn-warning">
                            <i class="fas fa-edit me-1"></i>Modifier
                        </a>
                        <a href="{{ path('enseignant_devoirs_index') }}" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-1"></i>Retour
                        </a>
                    </div>
                </div>
            </div>

            <!-- Statistiques -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card text-white bg-info">
                        <div class="card-body text-center">
                            <h6 class="text-white">Soumissions</h6>
                            <h2 class="mb-0">{{ stats.total }}</h2>
                            <small>{{ devoir.tauxSoumission|number_format(0) }}%</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-white bg-warning">
                        <div class="card-body text-center">
                            <h6 class="text-white">À Corriger</h6>
                            <h2 class="mb-0">{{ stats.soumis }}</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-white bg-success">
                        <div class="card-body text-center">
                            <h6 class="text-white">Corrigés</h6>
                            <h2 class="mb-0">{{ stats.corrige }}</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-white bg-danger">
                        <div class="card-body text-center">
                            <h6 class="text-white">En Retard</h6>
                            <h2 class="mb-0">{{ stats.en_retard }}</h2>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-8">
                    <!-- Détails du devoir -->
                    <div class="card mb-4">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-info-circle me-2"></i>Détails du Devoir
                            </h5>
                        </div>
                        <div class="card-body">
                            <p><strong>Description :</strong></p>
                            <p class="bg-light p-3 rounded">{{ devoir.description }}</p>

                            {% if devoir.consignes %}
                                <p><strong>Consignes :</strong></p>
                                <div class="bg-light p-3 rounded">
                                    {{ devoir.consignes|nl2br }}
                                </div>
                            {% endif %}
                            {% include '_partials/liste_fichiers.html.twig' with {'fichiers': devoir.listeDocuments, 'route': 'fichier_devoir', 'id': devoir.id, 'titre': 'Documents fournis'} %}

                            <hr>

                            <div class="row">
                                <div class="col-md-6">
                                    <p><strong>Date limite :</strong> {{ devoir.dateEcheance|date('d/m/Y à H:i') }}</p>
                                    <p><strong>Note maximale :</strong> {{ devoir.noteMax }}</p>
                                </div>
                                <div class="col-md-6">
                                    <p><strong>Soumissions tardives :</strong> 
                                        {% if devoir.accepteSoumissionsTardives %}
                                            <span class="badge bg-success">Acceptées</span>
                                        {% else %}
                                            <span class="badge bg-danger">Refusées</span>
                                        {% endif %}
                                    </p>
                                    <p><strong>Statut :</strong> 
                                        {% if devoir.statut == 'publie' %}
                                            <span class="badge bg-success">Publié</span>
                                        {% else %}
                                            <span class="badge bg-secondary">Brouillon</span>
                                        {% endif %}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Liste des soumissions -->
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <i class="fas fa-file-upload me-2"></i>Soumissions des Étudiants
                                <span class="badge bg-secondary ms-2">{{ soumissions|length }}</span>
                            </h5>
                        </div>
                        <div class="card-body">
                            {% if soumissions|length > 0 %}
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Étudiant</th>
                                                <th>Date soumission</th>
                                                <th>Délai</th>
                                                <th>Note</th>
                                                <th>Statut</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for soumission in soumissions %}
                                                <tr>
                                                    <td>{{ soumission.etudiant.nom }} {{ soumission.etudiant.prenom }}</td>
                                                    <td>{{ soumission.dateSoumission|date('d/m/Y H:i') }}</td>
                                                    <td>
                                                        {% if soumission.isEnRetard %}
                                                            <span class="badge bg-danger">
                                                                <i class="fas fa-exclamation me-1"></i>
                                                                +{{ soumission.delaiSoumission }} jour(s)
                                                            </span>
                                                        {% else %}
                                                            <span class="badge bg-success">
                                                                <i class="fas fa-check me-1"></i>À temps
                                                            </span>
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        {% if soumission.note %}
                                                            <strong>{{ soumission.note }}/{{ devoir.noteMax }}</strong>
                                                        {% else %}
                                                            <span class="text-muted">-</span>
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        {% if soumission.statut == 'corrige' %}
                                                            <span class="badge bg-success">Corrigé</span>
                                                        {% elseif soumission.statut == 'soumis' %}
                                                            <span class="badge bg-warning">À corriger</span>
                                                        {% else %}
                                                            <span class="badge bg-secondary">Brouillon</span>
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        <a href="{{ path('enseignant_devoir_corriger', {'id': devoir.id, 'soumissionId': soumission.id}) }}" 
                                                           class="btn btn-sm btn-primary">
                                                            <i class="fas fa-pen me-1"></i>
                                                            {% if soumission.statut == 'corrige' %}Voir{% else %}Corriger{% endif %}
                                                        </a>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% else %}
                                <div class="text-center py-5">
                                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                                    <h5 class="text-muted">Aucune soumission</h5>
                                    <p class="text-muted">Les étudiants n'ont pas encore soumis leurs travaux.</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <!-- Informations -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h6 class="mb-0">
                                <i class="fas fa-info-circle me-2"></i>Informations
                            </h6>
                        </div>
                        <div class="card-body">
                            <p><strong>Créé le :</strong><br>{{ devoir.dateCreation|date('d/m/Y à H:i') }}</p>
                            {% if devoir.dateModification %}
                                <p><strong>Modifié le :</strong><br>{{ devoir.dateModification|date('d/m/Y à H:i') }}</p>
                            {% endif %}
                            <p><strong>Jours restants :</strong><br>
                                {% if devoir.isEnRetard %}
                                    <span class="text-danger">Échéance dépassée</span>
                                {% else %}
                                    {{ devoir.joursRestants }} jour(s)
                                {% endif %}
                            </p>
                        </div>
                    </div>

                    <!-- Actions rapides -->
                    <div class="card">
                        <div class="card-header">
                            <h6 class="mb-0">
                                <i class="fas fa-bolt me-2"></i>Actions Rapides
                            </h6>
                        </div>
                        <div class="card-body d-grid gap-2">
                            {% if devoir.statut == 'brouillon' %}
                                <form method="post" action="{{ path('enseignant_devoir_publier', {'id': devoir.id}) }}" class="d-grid">
                                    <input type="hidden" name="_token" value="{{ csrf_token('publier-devoir' ~ devoir.id) }}">
                                    <button class="btn btn-success">
                                        <i class="fas fa-paper-plane me-1"></i>Publier le Devoir
                                    </button>
                                </form>
                            {% endif %}
                            <a href="{{ path('enseignant_devoir_edit', {'id': devoir.id}) }}" class="btn btn-warning">
                                <i class="fas fa-edit me-1"></i>Modifier
                            </a>
                            <form method="post" action="{{ path('enseignant_devoir_delete', {'id': devoir.id}) }}" class="d-grid"
                                  onsubmit="return confirm('Supprimer ce devoir et toutes les copies rendues ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-devoir') }}">
                                <button class="btn btn-danger">
                                    <i class="fas fa-trash me-1"></i>Supprimer
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}
