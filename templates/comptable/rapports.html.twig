{% extends 'base.html.twig' %}
{% import 'comptable/_macros.html.twig' as c %}

{% block title %}Rapports comptables{% endblock %}

{% block body %}
{% set periode = {'debut': debut|date('Y-m-d'), 'fin': fin|date('Y-m-d')} %}
<div class="page">
            <div class="page-header">
                <h1 class="h2">Rapports comptables</h1>
            </div>

            <form method="get" class="card mb-4">
                <div class="card-body row g-3 align-items-end">
                    <div class="col-md-4">
                        <label for="debut" class="form-label">Du</label>
                        <input type="date" class="form-control" id="debut" name="debut" value="{{ periode.debut }}">
                    </div>
                    <div class="col-md-4">
                        <label for="fin" class="form-label">Au</label>
                        <input type="date" class="form-control" id="fin" name="fin" value="{{ periode.fin }}">
                    </div>
                    <div class="col-md-4 d-grid">
                        <button class="btn btn-primary"><i class="fas fa-sync me-1"></i>Actualiser</button>
                    </div>
                </div>
            </form>

            <div class="row mb-4">
                <div class="col-md-4 mb-3">
                    <div class="card shadow border-start border-4 border-success"><div class="card-body">
                        <div class="text-xs fw-bold text-success text-uppercase">Encaissé sur la période</div>
                        <div class="h4 mb-0">{{ c.montant(encaisse) }}</div>
                    </div></div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card shadow border-start border-4 border-primary"><div class="card-body">
                        <div class="text-xs fw-bold text-primary text-uppercase">Facturé sur la période</div>
                        <div class="h4 mb-0">{{ c.montant(facture) }}</div>
                    </div></div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card shadow border-start border-4 border-info"><div class="card-body">
                        <div class="text-xs fw-bold text-info text-uppercase">Taux de recouvrement</div>
                        <div class="h4 mb-0">{{ tauxRecouvrement is not null ? tauxRecouvrement ~ ' %' : '-' }}</div>
                    </div></div>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-lg-7 mb-3">
                    <div class="card shadow h-100">
                        <div class="card-header"><h6 class="m-0 fw-bold text-primary">Encaissements mensuels</h6></div>
                        <div class="card-body"><canvas id="graphiquePaiementsMois" height="140"></canvas></div>
                    </div>
                </div>
                <div class="col-lg-5 mb-3">
                    <div class="card shadow h-100">
                        <div class="card-header"><h6 class="m-0 fw-bold text-primary">Répartition par type</h6></div>
                        <div class="card-body">
                            {% if parType is empty %}
                                <p class="text-muted text-center py-5 mb-0">Aucun encaissement sur la période.</p>
                            {% else %}
                                <canvas id="graphiqueRepartition" height="200"></canvas>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h6 class="m-0 fw-bold text-primary">Exports CSV (compatibles Excel)</h6>
                </div>
                <div class="card-body d-flex flex-wrap gap-2">
                    <a href="{{ path('comptable_export', {'rapport': 'paiements'}|merge(periode)) }}" class="btn btn-outline-primary">
                        <i class="fas fa-money-bill-wave me-1"></i>Paiements de la période
                    </a>
                    <a href="{{ path('comptable_export', {'rapport': 'factures'}|merge(periode)) }}" class="btn btn-outline-success">
                        <i class="fas fa-file-invoice-dollar me-1"></i>Factures de la période
                    </a>
                    <a href="{{ path('comptable_export', {'rapport': 'retards'}) }}" class="btn btn-outline-warning">
                        <i class="fas fa-exclamation-triangle me-1"></i>Factures en retard
                    </a>
                    <a href="{{ path('comptable_export', {'rapport': 'soldes'}) }}" class="btn btn-outline-info">
                        <i class="fas fa-users me-1"></i>Soldes des étudiants
                    </a>
                </div>
            </div>

            <div class="card shadow mb-4">
                <div class="card-header"><h6 class="m-0 fw-bold text-danger">Factures en retard ({{ retards|length }})</h6></div>
                <div class="card-body p-0">
                    <table class="table mb-0">
                        <thead class="table-light">
                            <tr><th>N°</th><th>Étudiant</th><th>Libellé</th><th>Échéance</th><th class="text-end">Reste dû</th></tr>
                        </thead>
                        <tbody>
                            {% for f in retards %}
                                <tr>
                                    <td><a href="{{ path('comptable_factures_show', {'id': f.id}) }}">F-{{ f.id }}</a></td>
                                    <td>{{ f.etudiant.nom }} {{ f.etudiant.prenom }}</td>
                                    <td>{{ f.libelle }}</td>
                                    <td class="text-danger">{{ f.dateEcheance|date('d/m/Y') }}</td>
                                    <td class="text-end fw-bold">{{ c.montant(f.resteAPayer) }}</td>
                                </tr>
                            {% else %}
                                <tr><td colspan="5" class="text-center text-muted py-3">Aucune facture en retard.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const mois = {{ mois|json_encode|raw }};
    const libellesMois = mois.map(m => {
        const [annee, numero] = m.split('-');
        return new Date(annee, numero - 1, 1).toLocaleDateString('fr-FR', {month: 'short', year: '2-digit'});
    });

    new Chart(document.getElementById('graphiquePaiementsMois'), {
        type: 'bar',
        data: {
            labels: libellesMois,
            datasets: [{
                label: 'Encaissements (€)',
                data: {{ montantsParMois|json_encode|raw }},
                backgroundColor: 'rgba(52, 152, 219, 0.7)'
            }]
        },
        options: {plugins: {legend: {display: false}}, scales: {y: {beginAtZero: true}}}
    });

    const repartition = document.getElementById('graphiqueRepartition');
    if (repartition) {
        new Chart(repartition, {
            type: 'doughnut',
            data: {
                labels: {{ types|json_encode|raw }},
                datasets: [{
                    data: {{ montantsParType|json_encode|raw }},
                    backgroundColor: ['#3498db', '#2ecc71', '#f1c40f', '#e74c3c', '#9b59b6', '#1abc9c', '#95a5a6']
                }]
            }
        });
    }
});
</script>
{% endblock %}
