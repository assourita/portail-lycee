{% extends 'base.html.twig' %}
{% import 'comptable/_macros.html.twig' as c %}

{% block title %}Paiements{% endblock %}

{% block body %}
<div class="page">
            <div class="page-header">
                <h1 class="h2">Paiements</h1>
                <div class="btn-toolbar mb-2 mb-md-0 gap-2">
                    <a href="{{ path('comptable_export', {'rapport': 'paiements'}) }}" class="btn btn-outline-success">
                        <i class="fas fa-file-csv me-1"></i>Exporter
                    </a>
                    <a href="{{ path('comptable_paiements_new') }}" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i>Nouveau paiement
                    </a>
                </div>
            </div>

            <form method="get" class="card mb-4">
                <div class="card-body row g-3 align-items-end">
                    <div class="col-md-4">
                        <label for="recherche" class="form-label">Recherche</label>
                        <input type="text" class="form-control" id="recherche" name="recherche" value="{{ filtres.recherche }}" placeholder="Nom, prénom, référence...">
                    </div>
                    <div class="col-md-3">
                        <label for="type" class="form-label">Type</label>
                        <select class="form-select" id="type" name="type">
                            <option value="">Tous</option>
                            {% for type in types %}
                                <option value="{{ type }}" {{ filtres.type == type ? 'selected' }}>{{ type }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="statut" class="form-label">Statut</label>
                        <select class="form-select" id="statut" name="statut">
                            <option value="">Tous</option>
                            <option value="paye" {{ filtres.statut == 'paye' ? 'selected' }}>Encaissé</option>
                            <option value="annule" {{ filtres.statut == 'annule' ? 'selected' }}>Annulé</option>
                        </select>
                    </div>
                    <div class="col-md-2 d-grid">
                        <button class="btn btn-secondary"><i class="fas fa-search me-1"></i>Filtrer</button>
                    </div>
                </div>
            </form>

            <div class="card shadow">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Étudiant</th>
                                    <th>Type</th>
                                    <th>Mode</th>
                                    <th>Facture</th>
                                    <th class="text-end">Montant</th>
                                    <th>Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for paiement in paiements %}
                                    <tr>
                                        <td>{{ paiement.datePaiement|date('d/m/Y') }}</td>
                                        <td>
                                            <a href="{{ path('comptable_etudiants_show', {'id': paiement.etudiant.id}) }}">
                                                {{ paiement.etudiant.nom }} {{ paiement.etudiant.prenom }}
                                            </a>
                                        </td>
                                        <td>{{ paiement.type }}</td>
                                        <td>
                                            {{ modes[paiement.modePaiement] ?? '-' }}
                                            {% if paiement.reference %}<br><small class="text-muted">{{ paiement.reference }}</small>{% endif %}
                                        </td>
                                        <td>
                                            {% if paiement.facture %}
                                                <a href="{{ path('comptable_factures_show', {'id': paiement.facture.id}) }}">F-{{ paiement.facture.id }}</a>
                                            {% else %}-{% endif %}
                                        </td>
                                        <td class="text-end">{{ c.montant(paiement.montant) }}</td>
                                        <td>{{ c.statut_paiement(paiement) }}</td>
                                    </tr>
                                {% else %}
                                    <tr><td colspan="7" class="text-center text-muted py-4">Aucun paiement ne correspond à ces critères.</td></tr>
                                {% endfor %}
                            </tbody>
                            {% if paiements|length > 0 %}
                                <tfoot class="table-light">
                                    <tr>
                                        <th colspan="5">{{ paiements|length }} paiement(s)</th>
                                        <th class="text-end">{{ c.montant(total) }}</th>
                                        <th>encaissés</th>
                                    </tr>
                                </tfoot>
                            {% endif %}
                        </table>
                    </div>
                </div>
            </div>
        </div>
{% endblock %}
