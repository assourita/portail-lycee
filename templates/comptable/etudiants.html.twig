{% extends 'base.html.twig' %}
{% import 'comptable/_macros.html.twig' as c %}

{% block title %}Comptes étudiants{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        {% include 'comptable/_sidebar.html.twig' %}

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Comptes étudiants</h1>
                <a href="{{ path('comptable_export', {'rapport': 'soldes'}) }}" class="btn btn-outline-success">
                    <i class="fas fa-file-csv me-1"></i>Exporter les soldes
                </a>
            </div>

            <form method="get" class="card mb-4">
                <div class="card-body row g-3 align-items-end">
                    <div class="col-md-4">
                        <label for="recherche" class="form-label">Recherche</label>
                        <input type="text" class="form-control" id="recherche" name="recherche" value="{{ filtres.recherche }}" placeholder="Nom, prénom, email...">
                    </div>
                    <div class="col-md-3">
                        <label for="filiere" class="form-label">Filière</label>
                        <select class="form-select" id="filiere" name="filiere">
                            <option value="">Toutes</option>
                            {% for filiere in filieres %}
                                <option value="{{ filiere.id }}" {{ filtres.filiere == filiere.id ? 'selected' }}>{{ filiere.nom }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="statut" class="form-label">Situation</label>
                        <select class="form-select" id="statut" name="statut">
                            {% for valeur, libelle in {'': 'Toutes', 'a_jour': 'À jour', 'solde_du': 'Solde à régler', 'en_retard': 'En retard'} %}
                                <option value="{{ valeur }}" {{ filtres.statut == valeur ? 'selected' }}>{{ libelle }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-2 d-grid">
                        <button class="btn btn-secondary"><i class="fas fa-search me-1"></i>Filtrer</button>
                    </div>
                </div>
            </form>

            <div class="card shadow">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Étudiant</th>
                                    <th>Filière</th>
                                    <th class="text-end">Total facturé</th>
                                    <th class="text-end">Total payé</th>
                                    <th class="text-end">Solde</th>
                                    <th>Situation</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for compte in comptes %}
                                    <tr class="{{ compte.statut == 'en_retard' ? 'table-warning' }}">
                                        <td>
                                            <strong>{{ compte.etudiant.nom }} {{ compte.etudiant.prenom }}</strong><br>
                                            <small class="text-muted">{{ compte.etudiant.email }}</small>
                                        </td>
                                        <td>{{ compte.etudiant.filiere ? compte.etudiant.filiere.nom : '-' }}</td>
                                        <td class="text-end">{{ c.montant(compte.du) }}</td>
                                        <td class="text-end">{{ c.montant(compte.paye) }}</td>
                                        <td class="text-end fw-bold {{ compte.solde > 0 ? 'text-danger' : 'text-success' }}">{{ c.montant(compte.solde) }}</td>
                                        <td>{{ c.statut_compte(compte.statut, compte.statut_libelle) }}</td>
                                        <td class="text-end text-nowrap">
                                            <a href="{{ path('comptable_etudiants_show', {'id': compte.etudiant.id}) }}" class="btn btn-sm btn-outline-primary" title="Voir le compte">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="{{ path('comptable_paiements_new', {'etudiant': compte.etudiant.id}) }}" class="btn btn-sm btn-success" title="Enregistrer un paiement">
                                                <i class="fas fa-money-bill"></i>
                                            </a>
                                            {% if compte.etudiant.email and compte.solde > 0 %}
                                                <a href="mailto:{{ compte.etudiant.email }}?subject={{ ('Rappel de paiement - solde de ' ~ c.montant(compte.solde))|url_encode }}"
                                                   class="btn btn-sm btn-outline-danger" title="Envoyer un rappel">
                                                    <i class="fas fa-envelope"></i>
                                                </a>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr><td colspan="7" class="text-center text-muted py-4">Aucun étudiant ne correspond à ces critères.</td></tr>
                                {% endfor %}
                            </tbody>
                            {% if comptes|length > 0 %}
                                <tfoot class="table-light">
                                    <tr>
                                        <th colspan="2">{{ comptes|length }} étudiant(s)</th>
                                        <th class="text-end">{{ c.montant(totaux.du) }}</th>
                                        <th class="text-end">{{ c.montant(totaux.paye) }}</th>
                                        <th class="text-end">{{ c.montant(totaux.solde) }}</th>
                                        <th colspan="2"></th>
                                    </tr>
                                </tfoot>
                            {% endif %}
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}
