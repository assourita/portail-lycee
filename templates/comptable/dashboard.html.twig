{% extends 'base.html.twig' %}
{% import 'comptable/_macros.html.twig' as c %}

{% block title %}Dashboard Comptable{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        {% include 'comptable/_sidebar.html.twig' %}

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Dashboard Comptable</h1>
                <div class="btn-toolbar mb-2 mb-md-0 gap-2">
                    <a href="{{ path('comptable_paiements_new') }}" class="btn btn-success">
                        <i class="fas fa-plus me-1"></i>Enregistrer un paiement
                    </a>
                    <a href="{{ path('comptable_factures_new') }}" class="btn btn-primary">
                        <i class="fas fa-file-invoice me-1"></i>Émettre une facture
                    </a>
                </div>
            </div>

            <div class="row">
                {% for carte in [
                    {'titre': 'Encaissé ce mois', 'valeur': c.montant(montantTotalMois), 'icone': 'fa-euro-sign', 'couleur': 'primary'},
                    {'titre': 'Factures en attente', 'valeur': facturesEnAttente, 'icone': 'fa-file-invoice', 'couleur': 'success'},
                    {'titre': 'Taux de paiement', 'valeur': tauxPaiement ~ ' %', 'icone': 'fa-percentage', 'couleur': 'info'},
                    {'titre': 'Factures en retard', 'valeur': retardsPaiement, 'icone': 'fa-clock', 'couleur': 'warning'},
                ] %}
                    <div class="col-xl-3 col-md-6 mb-4">
                        <div class="card border-start border-4 border-{{ carte.couleur }} shadow h-100 py-2">
                            <div class="card-body d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="text-xs fw-bold text-{{ carte.couleur }} text-uppercase mb-1">{{ carte.titre }}</div>
                                    <div class="h5 mb-0 fw-bold text-gray-800">{{ carte.valeur }}</div>
                                </div>
                                <i class="fas {{ carte.icone }} fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div class="row">
                <div class="col-lg-7 mb-4">
                    <div class="card shadow h-100">
                        <div class="card-header py-3 d-flex justify-content-between">
                            <h6 class="m-0 fw-bold text-primary">Derniers paiements</h6>
                            <a href="{{ path('comptable_paiements') }}" class="small">Tout voir</a>
                        </div>
                        <div class="card-body p-0">
                            <table class="table mb-0">
                                <thead class="table-light">
                                    <tr><th>Date</th><th>Étudiant</th><th>Type</th><th class="text-end">Montant</th><th>Statut</th></tr>
                                </thead>
                                <tbody>
                                    {% for paiement in derniersPaiements %}
                                        <tr>
                                            <td>{{ paiement.datePaiement|date('d/m/Y') }}</td>
                                            <td>
                                                <a href="{{ path('comptable_etudiants_show', {'id': paiement.etudiant.id}) }}">
                                                    {{ paiement.etudiant.prenom }} {{ paiement.etudiant.nom }}
                                                </a>
                                            </td>
                                            <td>{{ paiement.type }}</td>
                                            <td class="text-end">{{ c.montant(paiement.montant) }}</td>
                                            <td>{{ c.statut_paiement(paiement) }}</td>
                                        </tr>
                                    {% else %}
                                        <tr><td colspan="5" class="text-center text-muted py-4">Aucun paiement enregistré.</td></tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5 mb-4">
                    <div class="card shadow h-100">
                        <div class="card-header py-3 d-flex justify-content-between">
                            <h6 class="m-0 fw-bold text-danger">Factures en retard</h6>
                            <a href="{{ path('comptable_factures', {'statut': 'en_retard'}) }}" class="small">Tout voir</a>
                        </div>
                        <ul class="list-group list-group-flush">
                            {% for facture in facturesEnRetard %}
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <a href="{{ path('comptable_factures_show', {'id': facture.id}) }}">{{ facture.libelle }}</a><br>
                                        <small class="text-muted">
                                            {{ facture.etudiant.prenom }} {{ facture.etudiant.nom }} - échéance {{ facture.dateEcheance|date('d/m/Y') }}
                                        </small>
                                    </div>
                                    <span class="fw-bold text-danger">{{ c.montant(facture.resteAPayer) }}</span>
                                </li>
                            {% else %}
                                <li class="list-group-item text-center text-muted py-4">Aucune facture en retard.</li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}
