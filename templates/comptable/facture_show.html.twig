{% extends 'base.html.twig' %}
{% import 'comptable/_macros.html.twig' as c %}

{% block title %}Facture F-{{ facture.id }}{% endblock %}

{% block body %}
<div class="page">
            <div class="page-header">
                <h1 class="h2">Facture F-{{ facture.id }} {{ c.statut_facture(facture) }}</h1>
                <div class="btn-toolbar mb-2 mb-md-0 gap-2">
                    <a href="{{ path('comptable_factures') }}" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Retour
                    </a>
                    <button type="button" class="btn btn-outline-primary" onclick="window.print()">
                        <i class="fas fa-print me-1"></i>Imprimer
                    </button>
                    {% if facture.statut == 'en_attente' %}
                        <a href="{{ path('comptable_paiements_new', {'facture': facture.id}) }}" class="btn btn-success">
                            <i class="fas fa-money-bill me-1"></i>Enregistrer un paiement
                        </a>
                        {% if facture.montantPaye == 0 %}
                            <form method="post" action="{{ path('comptable_factures_annuler', {'id': facture.id}) }}"
                                  onsubmit="return confirm('Annuler cette facture ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('annuler-facture' ~ facture.id) }}">
                                <button class="btn btn-outline-danger"><i class="fas fa-ban me-1"></i>Annuler</button>
                            </form>
                        {% endif %}
                    {% endif %}
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <div class="card shadow h-100">
                        <div class="card-header"><h6 class="m-0 fw-bold text-primary">Détail</h6></div>
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-5">Étudiant</dt>
                                <dd class="col-sm-7">
                                    <a href="{{ path('comptable_etudiants_show', {'id': facture.etudiant.id}) }}">
                                        {{ facture.etudiant.prenom }} {{ facture.etudiant.nom }}
                                    </a>
                                    {% if facture.etudiant.filiere %}<br><small class="text-muted">{{ facture.etudiant.filiere.nom }}</small>{% endif %}
                                </dd>
                                <dt class="col-sm-5">Libellé</dt>
                                <dd class="col-sm-7">{{ facture.libelle }}</dd>
                                <dt class="col-sm-5">Émise le</dt>
                                <dd class="col-sm-7">{{ facture.dateCreation|date('d/m/Y') }}</dd>
                                <dt class="col-sm-5">Échéance</dt>
                                <dd class="col-sm-7 {{ facture.enRetard ? 'text-danger fw-bold' }}">{{ facture.dateEcheance|date('d/m/Y') }}</dd>
                            </dl>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <div class="card shadow h-100">
                        <div class="card-header"><h6 class="m-0 fw-bold text-primary">Règlement</h6></div>
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-5">Montant</dt>
                                <dd class="col-sm-7">{{ c.montant(facture.montant) }}</dd>
                                <dt class="col-sm-5">Déjà payé</dt>
                                <dd class="col-sm-7 text-success">{{ c.montant(facture.montantPaye) }}</dd>
                                <dt class="col-sm-5">Reste à payer</dt>
                                <dd class="col-sm-7 fw-bold {{ facture.resteAPayer > 0 ? 'text-danger' }}">{{ c.montant(facture.resteAPayer) }}</dd>
                            </dl>
                            {% set pourcentage = facture.montant > 0 ? (facture.montantPaye / facture.montant * 100)|round : 0 %}
                            <div class="progress mt-3" style="height: 10px;">
                                <div class="progress-bar bg-success" style="width: {{ pourcentage }}%"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow mb-4">
                <div class="card-header"><h6 class="m-0 fw-bold text-primary">Paiements rattachés</h6></div>
                <div class="card-body p-0">
                    <table class="table mb-0">
                        <thead class="table-light">
                            <tr><th>Date</th><th>Mode</th><th>Référence</th><th class="text-end">Montant</th><th>Statut</th></tr>
                        </thead>
                        <tbody>
                            {% for paiement in facture.paiements %}
                                <tr>
                                    <td>{{ paiement.datePaiement|date('d/m/Y') }}</td>
                                    <td>{{ modes[paiement.modePaiement] ?? '-' }}</td>
                                    <td>{{ paiement.reference ?: '-' }}</td>
                                    <td class="text-end">{{ c.montant(paiement.montant) }}</td>
                                    <td>{{ c.statut_paiement(paiement) }}</td>
                                </tr>
                            {% else %}
                                <tr><td colspan="5" class="text-center text-muted py-3">Aucun paiement rattaché.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
{% endblock %}
