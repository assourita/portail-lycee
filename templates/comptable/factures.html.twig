{% extends 'base.html.twig' %}
{% import 'comptable/_macros.html.twig' as c %}

{% block title %}Factures{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        {% include 'comptable/_sidebar.html.twig' %}

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Factures</h1>
                <div class="btn-toolbar mb-2 mb-md-0 gap-2">
                    <a href="{{ path('comptable_export', {'rapport': 'factures'}) }}" class="btn btn-outline-success">
                        <i class="fas fa-file-csv me-1"></i>Exporter
                    </a>
                    <a href="{{ path('comptable_factures_new') }}" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i>Nouvelle facture
                    </a>
                </div>
            </div>

            <div class="row mb-4">
                {% for carte in [
                    {'titre': 'Total', 'valeur': stats.total, 'couleur': 'primary', 'statut': ''},
                    {'titre': 'En attente', 'valeur': stats.en_attente, 'couleur': 'warning', 'statut': 'en_attente'},
                    {'titre': 'Payées', 'valeur': stats.payees, 'couleur': 'success', 'statut': 'paye'},
                    {'titre': 'En retard', 'valeur': stats.en_retard, 'couleur': 'danger', 'statut': 'en_retard'},
                ] %}
                    <div class="col-md-3 mb-3">
                        <a href="{{ path('comptable_factures', {'statut': carte.statut}) }}" class="text-decoration-none">
                            <div class="card text-white bg-{{ carte.couleur }} {{ filtres.statut == carte.statut ? 'shadow-lg' : 'opacity-75' }}">
                                <div class="card-body">
                                    <h6 class="card-title mb-1">{{ carte.titre }}</h6>
                                    <h2 class="mb-0">{{ carte.valeur }}</h2>
                                </div>
                            </div>
                        </a>
                    </div>
                {% endfor %}
            </div>

            <form method="get" class="card mb-4">
                <div class="card-body row g-3 align-items-end">
                    <div class="col-md-6">
                        <label for="recherche" class="form-label">Recherche</label>
                        <input type="text" class="form-control" id="recherche" name="recherche" value="{{ filtres.recherche }}" placeholder="Étudiant ou libellé...">
                    </div>
                    <div class="col-md-4">
                        <label for="statut" class="form-label">Statut</label>
                        <select class="form-select" id="statut" name="statut">
                            {% for valeur, libelle in {'': 'Tous', 'en_attente': 'En attente', 'en_retard': 'En retard', 'paye': 'Payées', 'annule': 'Annulées'} %}
                                <option value="{{ valeur }}" {{ filtres.statut == valeur ? 'selected' }}>{{ libelle }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-2 d-grid">
                        <button class="btn btn-secondary"><i class="fas fa-search me-1"></i>Filtrer</button>
                    </div>
                </div>
            </form>

            <div class="card shadow">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>N°</th>
                                    <th>Émise le</th>
                                    <th>Étudiant</th>
                                    <th>Libellé</th>
                                    <th class="text-end">Montant</th>
                                    <th class="text-end">Reste</th>
                                    <th>Échéance</th>
                                    <th>Statut</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for facture in factures %}
                                    <tr class="{{ facture.enRetard ? 'table-danger' }}">
                                        <td>F-{{ facture.id }}</td>
                                        <td>{{ facture.dateCreation|date('d/m/Y') }}</td>
                                        <td>
                                            <a href="{{ path('comptable_etudiants_show', {'id': facture.etudiant.id}) }}">
                                                {{ facture.etudiant.nom }} {{ facture.etudiant.prenom }}
                                            </a>
                                        </td>
                                        <td>{{ facture.libelle }}</td>
                                        <td class="text-end">{{ c.montant(facture.montant) }}</td>
                                        <td class="text-end">{{ facture.statut == 'annule' ? '-' : c.montant(facture.resteAPayer) }}</td>
                                        <td>{{ facture.dateEcheance|date('d/m/Y') }}</td>
                                        <td>{{ c.statut_facture(facture) }}</td>
                                        <td class="text-end text-nowrap">
                                            <a href="{{ path('comptable_factures_show', {'id': facture.id}) }}" class="btn btn-sm btn-outline-primary" title="Détail">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            {% if facture.statut == 'en_attente' %}
                                                <a href="{{ path('comptable_paiements_new', {'facture': facture.id}) }}" class="btn btn-sm btn-success" title="Enregistrer un paiement">
                                                    <i class="fas fa-money-bill"></i>
                                                </a>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr><td colspan="9" class="text-center text-muted py-4">Aucune facture ne correspond à ces critères.</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}
