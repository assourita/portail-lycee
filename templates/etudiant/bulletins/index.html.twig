{% extends 'base.html.twig' %}

{% block title %}Mes Bulletins - Mon Portail Lycée{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .bulletins-container {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            min-height: 100vh;
            padding: 20px;
        }
        
        .bulletins-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 2rem 0;
            margin: -20px -20px 30px -20px;
            border-radius: 20px 20px 0 0;
            text-align: center;
        }
        
        .bulletins-title {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }
        
        .bulletins-subtitle {
            font-size: 1.1rem;
            opacity: 0.9;
            margin-bottom: 0;
        }
        
        .bulletins-stats {
            display: flex;
            justify-content: center;
            gap: 30px;
            margin-top: 30px;
        }
        
        .stat-card {
            background: white;
            padding: 20px 30px;
            border-radius: 15px;
            text-align: center;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        
        .stat-number {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 5px;
        }
        
        .stat-number.total { color: #667eea; }
        .stat-number.current { color: #28a745; }
        .stat-number.average { color: #ffc107; }
        
        .stat-label {
            font-size: 0.9rem;
            color: #6c757d;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        
        .bulletins-list {
            margin-top: 40px;
        }
        
        .bulletins-list-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 2px solid #e9ecef;
        }
        
        .bulletins-list-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: #2c3e50;
            margin: 0;
        }
        
        .filter-buttons {
            display: flex;
            gap: 10px;
        }
        
        .filter-btn {
            padding: 8px 16px;
            border: 2px solid #e9ecef;
            border-radius: 25px;
            background: white;
            color: #6c757d;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .filter-btn:hover, .filter-btn.active {
            background: #667eea;
            color: white;
            border-color: #667eea;
        }
        
        .bulletin-card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 20px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            border-left: 5px solid #6c757d;
            transition: all 0.3s ease;
        }
        
        .bulletin-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        }
        
        .bulletin-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 15px;
        }
        
        .bulletin-info {
            flex-grow: 1;
        }
        
        .bulletin-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 8px;
        }
        
        .bulletin-meta {
            display: flex;
            gap: 15px;
            font-size: 0.9rem;
            color: #6c757d;
        }
        
        .bulletin-stats {
            display: flex;
            gap: 20px;
            margin-top: 15px;
            padding-top: 15px;
            border-top: 1px solid #e9ecef;
        }
        
        .bulletin-stat {
            text-align: center;
        }
        
        .bulletin-stat-value {
            font-size: 1.5rem;
            font-weight: 700;
            color: #667eea;
            display: block;
            margin-bottom: 5px;
        }
        
        .bulletin-stat-label {
            font-size: 0.8rem;
            color: #6c757d;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        
        .bulletin-actions {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }
        
        .action-btn {
            padding: 8px 16px;
            border-radius: 25px;
            border: none;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        
        .btn-view {
            background: #667eea;
            color: white;
        }
        
        .btn-view:hover {
            background: #5a6fd8;
            color: white;
        }
        
        .btn-download {
            background: #28a745;
            color: white;
        }
        
        .btn-download:hover {
            background: #218838;
            color: white;
        }
        
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #6c757d;
        }
        
        .empty-state i {
            font-size: 4rem;
            color: #dee2e6;
            margin-bottom: 20px;
        }
        
        @media (max-width: 768px) {
            .bulletins-stats {
                flex-direction: column;
                gap: 15px;
            }
            
            .bulletin-header {
                flex-direction: column;
                gap: 10px;
            }
            
            .bulletin-actions {
                flex-direction: column;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="bulletins-container">
    <div class="bulletins-header">
        <h1 class="bulletins-title">
            <i class="fas fa-file-alt me-3"></i>
            Mes Bulletins
        </h1>
        <p class="bulletins-subtitle">
            Filière : {{ etudiant.filiere.nom }} - Période : {{ periodeActive.periode }} {{ periodeActive.anneeScolaire }}
        </p>
    </div>

    <div class="bulletins-stats">
        <div class="stat-card">
            <div class="stat-number total">{{ bulletins|length }}</div>
            <div class="stat-label">Total</div>
        </div>
        <div class="stat-card">
            <div class="stat-number current">{{ bulletins|filter(bulletin => bulletin.trimestre == 3)|length }}</div>
            <div class="stat-label">En cours</div>
        </div>
        <div class="stat-card">
            <div class="stat-number average">15.2</div>
            <div class="stat-label">Moyenne</div>
        </div>
    </div>

    <div class="bulletins-list">
        <div class="bulletins-list-header">
            <h2 class="bulletins-list-title">Historique des bulletins</h2>
            <div class="filter-buttons">
                <button class="filter-btn active">Tous</button>
                <button class="filter-btn">Trimestre 1</button>
                <button class="filter-btn">Trimestre 2</button>
                <button class="filter-btn">Trimestre 3</button>
            </div>
        </div>

        {% if bulletins|length > 0 %}
            {% for bulletin in bulletins %}
                <div class="bulletin-card">
                    <div class="bulletin-header">
                        <div class="bulletin-info">
                            <div class="bulletin-title">Bulletin {{ bulletin.trimestre }} - {{ bulletin.periode }}</div>
                            <div class="bulletin-meta">
                                <span><i class="fas fa-calendar me-2"></i>{{ bulletin.date|date('d/m/Y') }}</span>
                                <span><i class="fas fa-chart-line me-2"></i>Moyenne : {{ bulletin.moyenne }}/20</span>
                            </div>
                        </div>
                    </div>

                    <div class="bulletin-stats">
                        <div class="bulletin-stat">
                            <div class="bulletin-stat-value">{{ bulletin.totalMatiere }}</div>
                            <div class="bulletin-stat-label">Matières</div>
                        </div>
                        <div class="bulletin-stat">
                            <div class="bulletin-stat-value">{{ bulletin.moyenneGenerale }}</div>
                            <div class="bulletin-stat-label">Moyenne générale</div>
                        </div>
                        <div class="bulletin-stat">
                            <div class="bulletin-stat-value">{{ bulletin.appreciation|default('Sans appréciation') }}</div>
                            <div class="bulletin-stat-label">Appréciation</div>
                        </div>
                    </div>

                    <div class="bulletin-actions">
                        <a href="#" class="action-btn btn-view">
                            <i class="fas fa-eye me-2"></i>Voir
                        </a>
                        <a href="#" class="action-btn btn-download">
                            <i class="fas fa-download me-2"></i>Télécharger
                        </a>
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <div class="empty-state">
                <i class="fas fa-file-alt"></i>
                <h3>Aucun bulletin trouvé</h3>
                <p>Vous n'avez pas de bulletins disponibles.</p>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
