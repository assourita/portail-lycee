{% extends 'base.html.twig' %}

{% block title %}Justifier une Absence{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        {% include 'etudiant/_sidebar.html.twig' %}

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <!-- En-tête -->
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <div>
                    <h1 class="h2">
                        <i class="fas fa-file-alt me-2 text-primary"></i>
                        Justifier une Absence
                    </h1>
                    <p class="text-muted mb-0">Absence du {{ absence.date|date('d/m/Y') }}</p>
                </div>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="{{ path('etudiant_absences_index') }}" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Retour
                    </a>
                </div>
            </div>

            <!-- Messages flash -->
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            <div class="row">
                <div class="col-md-8">
                    <!-- Informations de l'absence -->
                    <div class="card mb-4">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-info-circle me-2"></i>Détails de l'Absence
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <p><strong>Date :</strong> {{ absence.date|date('d/m/Y') }}</p>
                                    <p><strong>Type :</strong> 
                                        {% if absence.type == 'absence' %}
                                            <span class="badge bg-danger">Absence</span>
                                        {% else %}
                                            <span class="badge bg-warning">Retard</span>
                                        {% endif %}
                                    </p>
                                </div>
                                <div class="col-md-6">
                                    <p><strong>Période :</strong> {{ absence.periode|capitalize }}</p>
                                    <p><strong>Matière :</strong> {{ absence.matiere ? absence.matiere.nom : '-' }}</p>
                                </div>
                            </div>
                            {% if absence.motif %}
                                <p><strong>Motif enregistré :</strong></p>
                                <p class="bg-light p-2 rounded">{{ absence.motif }}</p>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Formulaire de justification -->
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <i class="fas fa-edit me-2"></i>Fournir une Justification
                            </h5>
                        </div>
                        <div class="card-body">
                            <form method="post">
                                <div class="mb-3">
                                    <label for="justification" class="form-label">
                                        <i class="fas fa-comment me-1"></i>Justification *
                                    </label>
                                    <textarea class="form-control" id="justification" name="justification" rows="6" 
                                              placeholder="Expliquez la raison de votre absence..." required></textarea>
                                    <div class="form-text">
                                        Soyez précis et honnête dans votre justification. Elle sera examinée par l'administration.
                                    </div>
                                </div>

                                <div class="alert alert-info">
                                    <i class="fas fa-info-circle me-2"></i>
                                    <strong>Note :</strong> Votre justification sera envoyée à l'administration pour validation. 
                                    Vous serez notifié une fois qu'elle sera examinée.
                                </div>

                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                    <a href="{{ path('etudiant_absences_index') }}" class="btn btn-secondary me-md-2">
                                        <i class="fas fa-times me-1"></i>Annuler
                                    </a>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-paper-plane me-1"></i>Envoyer la Justification
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card">
                        <div class="card-header">
                            <h6 class="mb-0">
                                <i class="fas fa-lightbulb me-2"></i>Conseils
                            </h6>
                        </div>
                        <div class="card-body">
                            <h6>Justifications acceptées :</h6>
                            <ul class="list-unstyled">
                                <li><i class="fas fa-check text-success me-1"></i>Maladie (avec certificat médical)</li>
                                <li><i class="fas fa-check text-success me-1"></i>Rendez-vous médical</li>
                                <li><i class="fas fa-check text-success me-1"></i>Événement familial important</li>
                                <li><i class="fas fa-check text-success me-1"></i>Problème de transport</li>
                            </ul>
                            
                            <hr>
                            
                            <h6>Important :</h6>
                            <ul class="list-unstyled text-muted">
                                <li><i class="fas fa-exclamation-circle me-1"></i>Justifiez dans les 48h</li>
                                <li><i class="fas fa-exclamation-circle me-1"></i>Soyez honnête et précis</li>
                                <li><i class="fas fa-exclamation-circle me-1"></i>Un document peut être demandé</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}
