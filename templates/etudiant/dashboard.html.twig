{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
{% set types_note = {'devoir': 'Devoir', 'examen': 'Examen', 'projet': 'Projet', 'participation': 'Participation', 'interrogation': 'Interrogation'} %}
<div class="page-header">
    <div>
        <h1>Bonjour, {{ etudiant.prenom }}</h1>
        <p>
            {{ etudiant.filiere ? etudiant.filiere.nom : 'Filière non attribuée' }}
            {% if periodeActive %} · {{ periodeActive.periode }} {{ periodeActive.anneeScolaire }}{% endif %}
        </p>
    </div>
    <div class="page-actions">
        <a href="{{ path('etudiant_emploi_du_temps') }}" class="btn btn-secondary"><i class="fas fa-calendar-days"></i>Emploi du temps</a>
        <a href="{{ path('etudiant_cours_index') }}" class="btn btn-primary"><i class="fas fa-book-open"></i>Mes cours</a>
    </div>
</div>

<div class="kpi-grid">
    <a href="{{ path('etudiant_notes_index') }}" class="kpi">
        <span class="kpi-label"><i class="fas fa-chart-simple"></i>Moyenne générale</span>
        <span class="kpi-value">
            {% if moyenneGenerale is not null %}{{ moyenneGenerale|number_format(2, ',') }}<small> / 20</small>{% else %}—{% endif %}
        </span>
        <span class="kpi-meta">{{ totalNotes }} note{{ totalNotes > 1 ? 's' }} sur la période</span>
    </a>
    <a href="{{ path('etudiant_devoirs_index') }}" class="kpi">
        <span class="kpi-label"><i class="fas fa-list-check"></i>Devoirs à rendre</span>
        <span class="kpi-value">{{ totalARendre }}</span>
        <span class="kpi-meta">{{ totalARendre > 0 ? 'avant leur échéance' : 'vous êtes à jour' }}</span>
    </a>
    <a href="{{ path('etudiant_absences_index') }}" class="kpi">
        <span class="kpi-label"><i class="fas fa-user-clock"></i>Absences</span>
        <span class="kpi-value">{{ absences.total }}</span>
        <span class="kpi-meta">
            {% if absences.aJustifier > 0 %}<span class="down">{{ absences.aJustifier }} à justifier</span>{% else %}aucune à justifier{% endif %}
        </span>
    </a>
    <a href="{{ path('etudiant_cours_index') }}" class="kpi">
        <span class="kpi-label"><i class="fas fa-book-open"></i>Cours disponibles</span>
        <span class="kpi-value">{{ totalCours }}</span>
        <span class="kpi-meta">publiés par vos enseignants</span>
    </a>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-5">
        <section class="panel h-100">
            <div class="panel-header">
                <div>
                    <h2>{{ emploi.libelle }}</h2>
                    <p>{{ emploi.creneaux is empty ? 'Aucun cours prévu' : emploi.creneaux|length ~ ' cours au programme' }}</p>
                </div>
                <a href="{{ path('etudiant_emploi_du_temps') }}" class="link-more">Semaine <i class="fas fa-arrow-right"></i></a>
            </div>
            {% if emploi.creneaux is empty %}
                <div class="empty-state">
                    <div class="empty-state-icon"><i class="far fa-calendar"></i></div>
                    <h3>Aucun cours planifié</h3>
                    <p class="mb-0">L'emploi du temps de votre filière n'est pas encore publié.</p>
                </div>
            {% else %}
                {% include '_partials/creneaux.html.twig' with {'detail': 'enseignant'} %}
            {% endif %}
        </section>
    </div>

    <div class="col-lg-7">
        <section class="panel h-100">
            <div class="panel-header">
                <div>
                    <h2>À rendre</h2>
                    <p>Devoirs classés par échéance</p>
                </div>
                <a href="{{ path('etudiant_devoirs_index') }}" class="link-more">Tous les devoirs <i class="fas fa-arrow-right"></i></a>
            </div>
            {% if aRendre is empty %}
                <div class="empty-state">
                    <div class="empty-state-icon"><i class="far fa-circle-check"></i></div>
                    <h3>Rien à rendre pour le moment</h3>
                    <p class="mb-0">Les nouveaux devoirs de vos enseignants apparaîtront ici.</p>
                </div>
            {% else %}
                <ul class="list-rows">
                    {% for item in aRendre %}
                        {% set devoir = item.devoir %}
                        {% set jours = devoir.joursRestants %}
                        <li class="list-row">
                            <span class="due {{ jours <= 2 ? 'is-soon' }}">
                                <strong>{{ devoir.dateEcheance|date('d') }}</strong>
                                <span>{{ mois_court(devoir.dateEcheance) }}</span>
                            </span>
                            <a href="{{ path('etudiant_devoir_show', {'id': devoir.id}) }}" class="list-row-main text-reset">
                                <span class="list-row-title d-block">{{ devoir.titre }}</span>
                                <span class="list-row-meta d-block">
                                    {{ devoir.matiere.nom }} · {{ jours <= 0 ? 'à rendre aujourd\'hui' : 'dans ' ~ jours ~ ' jour' ~ (jours > 1 ? 's') }}
                                </span>
                            </a>
                            {% if item.brouillon %}<span class="status status-warning d-none d-sm-inline-flex">Brouillon</span>{% endif %}
                            <a href="{{ path('etudiant_devoir_soumettre', {'id': devoir.id}) }}" class="btn btn-sm btn-secondary">Rendre</a>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <section class="panel h-100">
            <div class="panel-header">
                <div>
                    <h2>Dernières notes</h2>
                    <p>Résultats publiés par vos enseignants</p>
                </div>
                <a href="{{ path('etudiant_notes_index') }}" class="link-more">Toutes mes notes <i class="fas fa-arrow-right"></i></a>
            </div>
            {% if dernieresNotes is empty %}
                <div class="empty-state">
                    <div class="empty-state-icon"><i class="fas fa-chart-simple"></i></div>
                    <h3>Aucune note pour l'instant</h3>
                    <p class="mb-0">Vos notes s'afficheront dès leur saisie.</p>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr><th>Matière</th><th>Type</th><th>Date</th><th class="text-end">Note</th></tr>
                        </thead>
                        <tbody>
                            {% for note in dernieresNotes %}
                                <tr>
                                    <td class="fw-medium">{{ note.matiere ? note.matiere.nom : '—' }}</td>
                                    <td class="text-muted">{{ types_note[note.type] ?? note.type|capitalize }}</td>
                                    <td class="text-muted">{{ note.dateNote ? note.dateNote|date('d/m/Y') : '—' }}</td>
                                    <td class="text-end">
                                        <span class="grade {{ note.valeur < 10 ? 'is-low' : (note.valeur >= 16 ? 'is-high') }}">
                                            {{ note.valeur|number_format(2, ',')|replace({',00': ''}) }}<small> / 20</small>
                                        </span>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </section>
    </div>

    <div class="col-lg-5">
        <section class="panel h-100">
            <div class="panel-header">
                <div>
                    <h2>Prochaines évaluations</h2>
                    <p>Pour préparer vos révisions</p>
                </div>
                <a href="{{ path('etudiant_evaluations_index') }}" class="link-more">Toutes <i class="fas fa-arrow-right"></i></a>
            </div>
            {% if evaluations is empty %}
                <div class="empty-state">
                    <div class="empty-state-icon"><i class="fas fa-clipboard-check"></i></div>
                    <h3>Aucune évaluation annoncée</h3>
                    <p class="mb-0">Les évaluations programmées apparaîtront ici.</p>
                </div>
            {% else %}
                <ul class="list-rows">
                    {% for evaluation in evaluations %}
                        <li class="list-row">
                            <span class="due">
                                <strong>{{ evaluation.dateEvaluation|date('d') }}</strong>
                                <span>{{ mois_court(evaluation.dateEvaluation) }}</span>
                            </span>
                            <span class="list-row-main">
                                <span class="list-row-title d-block">{{ evaluation.nom }}</span>
                                <span class="list-row-meta d-block">{{ evaluation.matiere.nom }} · coefficient {{ evaluation.coefficient }}</span>
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    </div>
</div>
{% endblock %}
