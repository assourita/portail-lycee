{% extends 'base.html.twig' %}

{% block title %}Mes Cours{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        {% include 'etudiant/_sidebar.html.twig' %}

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Mes Cours</h1>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <div class="btn-group me-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary">
                            <i class="fas fa-filter"></i> Filtrer
                        </button>
                    </div>
                </div>
            </div>

            <!-- Informations de l'étudiant -->
            <div class="alert alert-info mb-4">
                <div class="row">
                    <div class="col-md-6">
                        <strong>Étudiant :</strong> {{ etudiant.nom }} {{ etudiant.prenom }}
                    </div>
                    <div class="col-md-6">
                        <strong>Filière :</strong> {{ etudiant.filiere.nom }}
                    </div>
                </div>
            </div>

            <div class="row">
                {% for cours in cours %}
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h5 class="card-title mb-0">
                                <i class="fas fa-book me-2"></i>{{ cours.titre }}
                            </h5>
                        </div>
                        <div class="card-body">
                            <p class="card-text">{{ cours.description|slice(0, 120) }}...</p>
                            
                            <div class="mb-3">
                                <small class="text-muted">
                                    <i class="fas fa-chalkboard-teacher me-1"></i>
                                    <strong>Matière :</strong> {{ cours.matiere.nom }}
                                </small>
                            </div>
                            
                            <div class="mb-3">
                                <small class="text-muted">
                                    <i class="fas fa-graduation-cap me-1"></i>
                                    <strong>Filière :</strong> {{ cours.matiere.filiere.nom }}
                                </small>
                            </div>
                            
                            <div class="mb-3">
                                <small class="text-muted">
                                    <i class="fas fa-list-ol me-1"></i>
                                    <strong>Chapitres :</strong> {{ cours.chapitres|length }}
                                </small>
                            </div>
                            
                            <div class="mb-3">
                                <small class="text-muted">
                                    <i class="fas fa-calendar me-1"></i>
                                    <strong>Ajouté le :</strong> {{ cours.dateAjout|date('d/m/Y') }}
                                </small>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent">
                            <a href="{{ path('etudiant_cours_show', {'id': cours.id}) }}" class="btn btn-primary btn-sm w-100">
                                <i class="fas fa-eye me-1"></i> Consulter le cours
                            </a>
                        </div>
                    </div>
                </div>
                {% else %}
                <div class="col-12">
                    <div class="alert alert-warning text-center">
                        <i class="fas fa-exclamation-triangle fa-3x mb-3"></i>
                        <h4>Aucun cours disponible</h4>
                        <p>Il n'y a actuellement aucun cours disponible pour votre filière.</p>
                    </div>
                </div>
                {% endfor %}
            </div>
        </main>
    </div>
</div>
{% endblock %}
