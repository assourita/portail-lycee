{% extends 'base.html.twig' %}

{% block title %}Soumettre - {{ devoir.titre }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        {% include 'etudiant/_sidebar.html.twig' %}

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <!-- En-tête -->
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <div>
                    <h1 class="h2">
                        <i class="fas fa-upload me-2 text-primary"></i>
                        Soumettre le Devoir
                    </h1>
                    <p class="text-muted mb-0">{{ devoir.titre }}</p>
                </div>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="{{ path('etudiant_devoir_show', {'id': devoir.id}) }}" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Retour
                    </a>
                </div>
            </div>

            <!-- Messages flash -->
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            <div class="row">
                <div class="col-md-8">
                    <!-- Rappel du devoir -->
                    <div class="card mb-4">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-info-circle me-2"></i>Rappel du Devoir
                            </h5>
                        </div>
                        <div class="card-body">
                            <p><strong>Description :</strong></p>
                            <p class="bg-light p-3 rounded">{{ devoir.description }}</p>

                            {% if devoir.consignes %}
                                <p><strong>Consignes :</strong></p>
                                <div class="bg-light p-3 rounded">
                                    {{ devoir.consignes|nl2br }}
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Formulaire de soumission -->
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <i class="fas fa-edit me-2"></i>Votre Travail
                            </h5>
                        </div>
                        <div class="card-body">
                            <form method="post" enctype="multipart/form-data">
                                <input type="hidden" name="_token" value="{{ csrf_token('soumettre' ~ devoir.id) }}">
                                <div class="mb-3">
                                    <label for="commentaire" class="form-label">
                                        <i class="fas fa-comment me-1"></i>Commentaire / Réponse
                                    </label>
                                    <textarea class="form-control" id="commentaire" name="commentaire" rows="10"
                                              placeholder="Rédigez votre réponse ici...">{{ soumission ? soumission.commentaire : '' }}</textarea>
                                    <div class="form-text">
                                        Rédigez votre réponse directement ici et/ou joignez des fichiers.
                                    </div>
                                </div>

                                {% if soumission and soumission.listeFichiers|length > 0 %}
                                    <div class="mb-3">
                                        <label class="form-label"><i class="fas fa-paperclip me-1"></i>Fichiers déjà joints</label>
                                        <ul class="list-group">
                                            {% for fichier in soumission.listeFichiers %}
                                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                                    <a href="{{ path('fichier_soumission', {'id': soumission.id, 'fichier': fichier.fichier}) }}">
                                                        <i class="fas fa-file me-1"></i>{{ fichier.nom }}
                                                    </a>
                                                    <div class="form-check mb-0">
                                                        <input class="form-check-input" type="checkbox" name="supprimer_fichiers[]"
                                                               value="{{ fichier.fichier }}" id="suppr{{ loop.index }}">
                                                        <label class="form-check-label text-danger small" for="suppr{{ loop.index }}">Retirer</label>
                                                    </div>
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    </div>
                                {% endif %}

                                <div class="mb-3">
                                    <label for="fichiers" class="form-label">
                                        <i class="fas fa-upload me-1"></i>Joindre des fichiers
                                    </label>
                                    <input type="file" class="form-control" id="fichiers" name="fichiers[]" multiple>
                                    <div class="form-text">PDF, documents bureautiques, images ou archive ZIP, 10 Mo maximum par fichier.</div>
                                </div>

                                <div class="alert alert-warning">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    <strong>Attention :</strong> Une fois soumis, vous ne pourrez plus modifier votre travail.
                                    {% if not devoir.accepteSoumissionsTardives %}
                                        Les soumissions tardives ne sont pas acceptées.
                                    {% endif %}
                                </div>

                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                    <a href="{{ path('etudiant_devoir_show', {'id': devoir.id}) }}" class="btn btn-secondary me-md-2">
                                        <i class="fas fa-times me-1"></i>Annuler
                                    </a>
                                    <button type="submit" name="action" value="brouillon" class="btn btn-outline-primary me-md-2">
                                        <i class="fas fa-save me-1"></i>Enregistrer en brouillon
                                    </button>
                                    <button type="submit" name="action" value="soumettre" class="btn btn-success">
                                        <i class="fas fa-paper-plane me-1"></i>Soumettre le Devoir
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <!-- Informations -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h6 class="mb-0">
                                <i class="fas fa-info-circle me-2"></i>Informations
                            </h6>
                        </div>
                        <div class="card-body">
                            <p><strong>Matière :</strong><br>{{ devoir.matiere.nom }}</p>
                            <p><strong>Enseignant :</strong><br>{{ devoir.enseignant.nom }} {{ devoir.enseignant.prenom }}</p>
                            <p><strong>Date limite :</strong><br>
                                <span class="{% if devoir.isEnRetard %}text-danger{% else %}text-success{% endif %}">
                                    {{ devoir.dateEcheance|date('d/m/Y à H:i') }}
                                </span>
                            </p>
                            <p><strong>Note maximale :</strong><br>{{ devoir.noteMax }} points</p>
                            
                            {% if devoir.isEnRetard %}
                                <div class="alert alert-danger">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    <strong>Échéance dépassée !</strong>
                                    {% if devoir.accepteSoumissionsTardives %}
                                        <br>Soumissions tardives acceptées.
                                    {% else %}
                                        <br>Soumissions tardives refusées.
                                    {% endif %}
                                </div>
                            {% else %}
                                <div class="alert alert-info">
                                    <i class="fas fa-clock me-2"></i>
                                    <strong>{{ devoir.joursRestants }} jour(s) restant(s)</strong>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Statut de votre soumission -->
                    {% if soumission %}
                        <div class="card">
                            <div class="card-header bg-success text-white">
                                <h6 class="mb-0">
                                    <i class="fas fa-check me-2"></i>Votre Soumission
                                </h6>
                            </div>
                            <div class="card-body">
                                <p><strong>Statut :</strong> 
                                    {% if soumission.statut == 'corrige' %}
                                        <span class="badge bg-success">Corrigé</span>
                                    {% elseif soumission.statut == 'soumis' %}
                                        <span class="badge bg-info">Soumis</span>
                                    {% else %}
                                        <span class="badge bg-secondary">Brouillon</span>
                                    {% endif %}
                                </p>
                                <p><strong>{{ soumission.statut == 'brouillon' ? 'Enregistré le' : 'Soumis le' }} :</strong><br>{{ soumission.dateSoumission ? soumission.dateSoumission|date('d/m/Y à H:i') : '-' }}</p>
                                
                                {% if soumission.note %}
                                    <hr>
                                    <div class="text-center">
                                        <h3 class="text-success">{{ soumission.note }}/{{ devoir.noteMax }}</h3>
                                        <p class="text-muted">Votre note</p>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}
