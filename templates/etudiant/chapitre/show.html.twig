{% extends 'base.html.twig' %}

{% block title %}Chapitre : {{ chapitre.titre }}{% endblock %}

{% block body %}
<div class="page">
            <div class="page-header">
                <h1 class="h2">{{ chapitre.titre }}</h1>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="{{ path('etudiant_cours_show', {'id': cours.id}) }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Retour au cours
                    </a>
                </div>
            </div>

            <!-- Informations du chapitre -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-book-open me-2"></i>Informations du chapitre
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Cours :</strong> {{ cours.titre }}</p>
                            <p><strong>Matière :</strong> {{ cours.matiere.nom }}</p>
                            <p><strong>Ordre :</strong> {{ chapitre.ordre }}</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Date de création :</strong> {{ chapitre.createdAt|date('d/m/Y à H:i') }}</p>
                            <p><strong>Dernière modification :</strong> {{ chapitre.updatedAt|date('d/m/Y à H:i') }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contenu du chapitre -->
            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-file-alt me-2"></i>Contenu du chapitre
                    </h5>
                </div>
                <div class="card-body">
                    <div class="chapitre-contenu">
                        {{ chapitre.contenu|nl2br }}
                    </div>
                </div>
            </div>

            <!-- Pièces jointes -->
            {% if chapitre.piecesJointes|length > 0 %}
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-paperclip me-2"></i>Ressources et documents ({{ chapitre.piecesJointes|length }})
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        {% for pieceJointe in chapitre.piecesJointes %}
                        <div class="col-md-6 col-lg-4 mb-3">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body d-flex flex-column">
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="fas fa-file me-2 text-primary"></i>
                                        <h6 class="card-title mb-0 text-truncate" title="{{ pieceJointe.nom }}">
                                            {{ pieceJointe.nom }}
                                        </h6>
                                    </div>
                                    <p class="card-text small text-muted mb-3">
                                        <i class="fas fa-calendar me-1"></i>
                                        Ajouté le {{ pieceJointe.createdAt|date('d/m/Y') }}
                                    </p>
                                    <div class="mt-auto">
                                        <a href="{{ path('etudiant_piece_jointe_download', {'id': pieceJointe.id}) }}" 
                                           class="btn btn-primary btn-sm w-100">
                                            <i class="fas fa-download me-1"></i> Télécharger
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
            {% else %}
            <div class="card">
                <div class="card-body text-center py-5">
                    <i class="fas fa-paperclip fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">Aucune ressource disponible</h5>
                    <p class="text-muted">Ce chapitre ne contient pas de documents ou ressources supplémentaires.</p>
                </div>
            </div>
            {% endif %}
        </div>

<style>
.chapitre-contenu {
    line-height: 1.8;
    font-size: 1.1rem;
    color: #333;
}

.chapitre-contenu p {
    margin-bottom: 1rem;
}

.card {
    transition: transform 0.2s ease-in-out;
}

.card:hover {
    transform: translateY(-2px);
}

.btn {
    transition: all 0.2s ease-in-out;
}

.btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}
</style>
{% endblock %}
