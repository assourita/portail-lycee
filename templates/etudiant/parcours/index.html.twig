{% extends 'base.html.twig' %}

{% block title %}Mon Parcours Scolaire - Mon Portail Lycée{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .parcours-container {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            min-height: 100vh;
            padding: 20px;
        }
        
        .parcours-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 2rem 0;
            margin: -20px -20px 30px -20px;
            border-radius: 20px 20px 0 0;
            text-align: center;
        }
        
        .parcours-title {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }
        
        .parcours-subtitle {
            font-size: 1.1rem;
            opacity: 0.9;
            margin-bottom: 0;
        }
        
        .parcours-content {
            display: grid;
            grid-template-columns: 1fr;
            gap: 30px;
            margin-top: 40px;
        }
        
        .parcours-card {
            background: white;
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
        }
        
        .parcours-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.15);
        }
        
        .parcours-card-header {
            display: flex;
            align-items: center;
            margin-bottom: 25px;
            padding-bottom: 20px;
            border-bottom: 2px solid #e9ecef;
        }
        
        .parcours-icon {
            width: 60px;
            height: 60px;
            background: linear-gradient(45deg, #667eea, #764ba2);
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.5rem;
            margin-right: 20px;
        }
        
        .parcours-info h3 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #2c3e50;
            margin: 0;
        }
        
        .parcours-info p {
            color: #6c757d;
            margin: 10px 0 0 0;
            font-size: 1rem;
            line-height: 1.6;
        }
        
        .objectifs-section, .competences-section {
            margin-top: 30px;
        }
        
        .section-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .section-title i {
            color: #667eea;
        }
        
        .list-items {
            list-style: none;
            padding: 0;
        }
        
        .list-items li {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 15px 20px;
            margin-bottom: 10px;
            border-left: 3px solid #667eea;
            transition: all 0.3s ease;
        }
        
        .list-items li:hover {
            background: #e9ecef;
            transform: translateX(5px);
        }
        
        .list-items li i {
            color: #667eea;
            margin-right: 10px;
        }
        
        .progress-section {
            margin-top: 30px;
        }
        
        .progress-bar {
            background: #e9ecef;
            height: 10px;
            border-radius: 5px;
            overflow: hidden;
            margin-bottom: 10px;
        }
        
        .progress-fill {
            height: 100%;
            background: linear-gradient(45deg, #667eea, #764ba2);
            border-radius: 5px;
            transition: width 0.5s ease;
        }
        
        .progress-label {
            display: flex;
            justify-content: space-between;
            font-size: 0.9rem;
            color: #6c757d;
            margin-bottom: 5px;
        }
        
        .timeline {
            position: relative;
            margin-top: 30px;
        }
        
        .timeline::before {
            content: '';
            position: absolute;
            left: 20px;
            top: 0;
            bottom: 0;
            width: 2px;
            background: #667eea;
        }
        
        .timeline-item {
            position: relative;
            padding-left: 50px;
            margin-bottom: 30px;
        }
        
        .timeline-item::before {
            content: '';
            position: absolute;
            left: 15px;
            top: 0;
            width: 10px;
            height: 10px;
            background: white;
            border: 2px solid #667eea;
            border-radius: 50%;
            z-index: 1;
        }
        
        .timeline-content {
            background: white;
            border-radius: 15px;
            padding: 20px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            border-left: 3px solid #667eea;
        }
        
        .timeline-date {
            font-weight: 700;
            color: #667eea;
            margin-bottom: 10px;
        }
        
        .timeline-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 10px;
        }
        
        .timeline-description {
            color: #6c757d;
            line-height: 1.6;
        }
        
        @media (max-width: 768px) {
            .parcours-content {
                grid-template-columns: 1fr;
                gap: 20px;
            }
            
            .parcours-card {
                padding: 20px;
            }
            
            .parcours-card-header {
                flex-direction: column;
                text-align: center;
                gap: 15px;
            }
            
            .parcours-icon {
                margin-right: 0;
                margin-bottom: 15px;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="parcours-container">
    <div class="parcours-header">
        <h1 class="parcours-title">
            <i class="fas fa-route me-3"></i>
            Mon Parcours Scolaire
        </h1>
        <p class="parcours-subtitle">
            Filière : {{ parcours.filiere.nom }} - Période : {{ periodeActive.periode }} {{ periodeActive.anneeScolaire }}
        </p>
    </div>

    <div class="parcours-content">
        <div class="parcours-card">
            <div class="parcours-card-header">
                <div class="parcours-icon">
                    <i class="fas fa-graduation-cap"></i>
                </div>
                <div class="parcours-info">
                    <h3>Informations Générales</h3>
                    <p><strong>Filière :</strong> {{ parcours.filiere.nom }}</p>
                    <p><strong>Niveau :</strong> {{ parcours.niveau }}</p>
                    <p><strong>Spécialité :</strong> {{ parcours.specialite }}</p>
                    <p><strong>Date d'inscription :</strong> {{ parcours.dateInscription|date('d/m/Y') }}</p>
                </div>
            </div>

            <div class="objectifs-section">
                <h4 class="section-title">
                    <i class="fas fa-bullseye me-2"></i>
                    Objectifs Pédagogiques
                </h4>
                <ul class="list-items">
                    {% for objectif in parcours.objectifs %}
                        <li><i class="fas fa-check-circle"></i>{{ objectif }}</li>
                    {% endfor %}
                </ul>
            </div>

            <div class="competences-section">
                <h4 class="section-title">
                    <i class="fas fa-star me-2"></i>
                    Compétences à Développer
                </h4>
                <ul class="list-items">
                    {% for competence in parcours.competences %}
                        <li><i class="fas fa-award"></i>{{ competence }}</li>
                    {% endfor %}
                </ul>
            </div>

            <div class="progress-section">
                <h4 class="section-title">
                    <i class="fas fa-chart-line me-2"></i>
                    Progression
                </h4>
                <div class="progress-bar">
                    <div class="progress-fill" style="width: 75%;"></div>
                </div>
                <div class="progress-label">
                    <span>Progression générale</span>
                    <span>75%</span>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill" style="width: 60%;"></div>
                </div>
                <div class="progress-label">
                    <span>Objectifs atteints</span>
                    <span>60%</span>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill" style="width: 85%;"></div>
                </div>
                <div class="progress-label">
                    <span>Compétences validées</span>
                    <span>85%</span>
                </div>
            </div>

            <div class="timeline">
                <h4 class="section-title">
                    <i class="fas fa-history me-2"></i>
                    Étapes Clés
                </h4>
                <div class="timeline-item">
                    <div class="timeline-content">
                        <div class="timeline-date">Septembre 2023</div>
                        <div class="timeline-title">Inscription en {{ parcours.filiere.nom }}</div>
                        <div class="timeline-description">Début du parcours scolaire avec orientation et mise à niveau.</div>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-content">
                        <div class="timeline-date">Janvier 2024</div>
                        <div class="timeline-title">Adaptation réussie</div>
                        <div class="timeline-description">Période d'adaptation et consolidation des acquis fondamentaux.</div>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-content">
                        <div class="timeline-date">Juin 2024</div>
                        <div class="timeline-title">Spécialisation en cours</div>
                        <div class="timeline-description">Choix des options de spécialisation et début des enseignements spécifiques.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
