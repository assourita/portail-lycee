{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block site_footer %}{% endblock %}

{% block body %}
<div class="auth-page">
    <div class="auth-card">
        <div class="auth-icon"><i class="fas fa-key"></i></div>
        <h1>Mot de passe oublié</h1>
        <p class="auth-subtitle">Saisissez l'adresse email de votre compte : nous vous enverrons un lien pour choisir un nouveau mot de passe.</p>

        <form method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('reset_password') }}">
            <div class="mb-4">
                <label for="email" class="form-label">Adresse email</label>
                <input type="email" id="email" name="email" class="form-control" autocomplete="email" required autofocus>
            </div>
            <button type="submit" class="btn btn-primary w-100">Envoyer le lien</button>
        </form>

        <p class="auth-footer mb-0"><a href="{{ path('app_login') }}"><i class="fas fa-arrow-left me-1"></i>Retour à la connexion</a></p>
    </div>
</div>
{% endblock %}
