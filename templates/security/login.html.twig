{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block site_footer %}{% endblock %}

{% block body %}
<div class="auth-page">
    <div class="auth-card">
        <div class="auth-icon"><i class="fas fa-graduation-cap"></i></div>
        <h1>Connexion</h1>
        <p class="auth-subtitle">Accédez à votre espace avec les identifiants fournis par le lycée.</p>

        {% if error %}
            <div class="alert alert-danger"><i class="fas fa-circle-exclamation"></i><div>{{ error.messageKey|trans(error.messageData, 'security') }}</div></div>
        {% endif %}

        {% if app.user %}
            <div class="alert alert-info">
                <i class="fas fa-circle-info"></i>
                <div>Connecté en tant que <strong>{{ app.user.userIdentifier }}</strong>. <a href="{{ path('app_logout') }}" class="alert-link">Se déconnecter</a></div>
            </div>
        {% endif %}

        <form method="post">
            <div class="mb-3">
                <label for="username" class="form-label">Identifiant</label>
                <input type="text" value="{{ last_username }}" name="username" id="username" class="form-control"
                       autocomplete="username" required autofocus>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-baseline">
                    <label for="password" class="form-label">Mot de passe</label>
                    <a href="{{ path('app_reset_password') }}" class="small">Mot de passe oublié ?</a>
                </div>
                <div class="password-field">
                    <input type="password" name="password" id="password" class="form-control" autocomplete="current-password" required>
                    <button type="button" class="btn btn-ghost btn-icon btn-sm password-toggle" data-toggle-password="password" aria-label="Afficher le mot de passe">
                        <i class="far fa-eye"></i>
                    </button>
                </div>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="form-check mb-4">
                <input class="form-check-input" type="checkbox" name="_remember_me" id="remember_me">
                <label class="form-check-label" for="remember_me">Rester connecté</label>
            </div>

            <button class="btn btn-primary w-100" type="submit">Se connecter</button>
        </form>

        <p class="auth-footer mb-0">Pas encore de compte ? <a href="{{ path('app_register') }}">Créer un compte</a></p>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.querySelectorAll('[data-toggle-password]').forEach(function (bouton) {
    bouton.addEventListener('click', function () {
        var champ = document.getElementById(bouton.dataset.togglePassword);
        champ.type = champ.type === 'password' ? 'text' : 'password';
        bouton.querySelector('i').className = champ.type === 'password' ? 'far fa-eye' : 'far fa-eye-slash';
    });
});
</script>
{% endblock %}
