{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe{% endblock %}

{% block site_footer %}{% endblock %}

{% block body %}
<div class="auth-page">
    <div class="auth-card">
        <div class="auth-icon"><i class="fas fa-lock"></i></div>
        <h1>Nouveau mot de passe</h1>
        <p class="auth-subtitle">Choisissez un mot de passe d'au moins 8 caractères, que vous n'utilisez pas ailleurs.</p>

        <form method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('reset_password_confirm') }}">
            <div class="mb-3">
                <label for="password" class="form-label">Nouveau mot de passe</label>
                <input type="password" id="password" name="password" class="form-control" minlength="8" autocomplete="new-password" required autofocus>
            </div>
            <div class="mb-4">
                <label for="password_confirm" class="form-label">Confirmation</label>
                <input type="password" id="password_confirm" name="password_confirm" class="form-control" minlength="8" autocomplete="new-password" required>
            </div>
            <button type="submit" class="btn btn-primary w-100">Enregistrer le mot de passe</button>
        </form>

        <p class="auth-footer mb-0"><a href="{{ path('app_login') }}"><i class="fas fa-arrow-left me-1"></i>Retour à la connexion</a></p>
    </div>
</div>
{% endblock %}
