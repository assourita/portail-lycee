{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<section class="hero">
    <div class="site-container hero-grid">
        <div>
            <span class="eyebrow">
                <span class="status-dot"></span>
                {{ anneeScolaire ? 'Année scolaire ' ~ anneeScolaire : 'Espace numérique du lycée' }}
            </span>
            <h1>Toute la vie du lycée,<br><span>réunie dans un seul espace.</span></h1>
            <p class="hero-lead">
                Cours, devoirs, notes, emploi du temps et vie scolaire : élèves, familles et équipes
                pédagogiques retrouvent l'essentiel au même endroit, en temps réel.
            </p>
            <div class="hero-actions">
                {% if profil %}
                    <a href="{{ path('app_dashboard') }}" class="btn btn-primary btn-lg">Accéder à mon espace <i class="fas fa-arrow-right"></i></a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-primary btn-lg">Se connecter <i class="fas fa-arrow-right"></i></a>
                {% endif %}
                <a href="#formations" class="btn btn-secondary btn-lg">Découvrir les formations</a>
            </div>
        </div>
        <div class="hero-media">
            <img src="{{ asset('images/login.jpg') }}" alt="Élève suivant un cours en ligne" width="724" height="483">
            <div class="hero-card">
                <span class="hero-card-icon"><i class="fas fa-check"></i></span>
                <div>
                    <strong>Suivi en temps réel</strong>
                    <span class="text-muted">Notes, devoirs et absences</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="stats-band" aria-label="Le lycée en chiffres">
    <div class="site-container stats-grid">
        <div class="stat-cell">
            <div class="stat-value">{{ stats.niveaux }}</div>
            <div class="stat-label">Niveaux d'enseignement</div>
        </div>
        <div class="stat-cell">
            <div class="stat-value">{{ stats.filieres }}</div>
            <div class="stat-label">Filières proposées</div>
        </div>
        <div class="stat-cell">
            <div class="stat-value">{{ stats.matieres }}</div>
            <div class="stat-label">Matières enseignées</div>
        </div>
        <div class="stat-cell">
            <div class="stat-value">{{ stats.enseignants }}</div>
            <div class="stat-label">Enseignants</div>
        </div>
    </div>
</section>

<section class="site-section" id="formations">
    <div class="site-container">
        <div class="section-intro">
            <div>
                <div class="section-kicker">Formations</div>
                <h2>Un parcours du 10e à la Terminale</h2>
                <p>Des filières générales et spécialisées, organisées par niveau, avec un programme complet pour chacune.</p>
            </div>
        </div>

        {% if niveaux is empty %}
            <div class="empty-state panel">
                <div class="empty-state-icon"><i class="fas fa-layer-group"></i></div>
                <h3>Les formations seront bientôt publiées</h3>
            </div>
        {% else %}
            <div class="level-grid">
                {% for niveau, donnees in niveaux %}
                    <article class="level-card">
                        <h3>{{ niveau }}</h3>
                        <div class="level-meta">{{ donnees.filieres|length }} filière{{ donnees.filieres|length > 1 ? 's' }}</div>
                        <ul>
                            {% for filiere in donnees.filieres %}
                                <li>{{ filiere.nom }} <span>{{ filiere.matieres }} matière{{ filiere.matieres > 1 ? 's' }}</span></li>
                            {% endfor %}
                        </ul>
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>

<section class="site-section" id="espaces">
    <div class="site-container">
        <div class="section-intro">
            <div>
                <div class="section-kicker">Espaces numériques</div>
                <h2>Un espace adapté à chacun</h2>
                <p>Chaque membre de la communauté scolaire dispose d'outils pensés pour son rôle.</p>
            </div>
        </div>
        <div class="feature-grid">
            <div class="feature">
                <div class="feature-icon"><i class="fas fa-user-graduate"></i></div>
                <h3>Élèves</h3>
                <p>Cours et ressources, devoirs à rendre en ligne, notes, bulletins et emploi du temps.</p>
            </div>
            <div class="feature">
                <div class="feature-icon"><i class="fas fa-user-group"></i></div>
                <h3>Familles</h3>
                <p>Suivi des résultats, des bulletins et des absences de chaque enfant, sans attendre la fin du trimestre.</p>
            </div>
            <div class="feature">
                <div class="feature-icon"><i class="fas fa-chalkboard-user"></i></div>
                <h3>Enseignants</h3>
                <p>Publication des cours, création et correction des devoirs, saisie des notes et des absences.</p>
            </div>
            <div class="feature">
                <div class="feature-icon"><i class="fas fa-school"></i></div>
                <h3>Administration</h3>
                <p>Organisation des classes, des filières et des périodes, bulletins et suivi de l'assiduité.</p>
            </div>
            <div class="feature">
                <div class="feature-icon"><i class="fas fa-file-invoice"></i></div>
                <h3>Comptabilité</h3>
                <p>Facturation, encaissements et suivi des soldes, avec des rapports exportables.</p>
            </div>
            <div class="feature">
                <div class="feature-icon"><i class="fas fa-shield-halved"></i></div>
                <h3>Confidentialité</h3>
                <p>Chacun n'accède qu'aux informations qui le concernent. Les documents restent privés.</p>
            </div>
        </div>
    </div>
</section>

<section class="site-section" id="actualites">
    <div class="site-container">
        <div class="section-intro">
            <div>
                <div class="section-kicker">Actualités</div>
                <h2>Calendrier scolaire{{ anneeScolaire ? ' ' ~ anneeScolaire }}</h2>
                <p>Les grandes étapes de l'année, publiées par l'administration.</p>
            </div>
        </div>

        {% if calendrier is empty %}
            <div class="panel empty-state">
                <div class="empty-state-icon"><i class="far fa-calendar"></i></div>
                <h3>Le calendrier de l'année n'est pas encore publié</h3>
            </div>
        {% else %}
            <div class="news-list">
                {% for periode in calendrier %}
                    <article class="news-item">
                        <div class="news-date">
                            <i class="far fa-calendar"></i>
                            {{ periode.dateDebut|date('d/m/Y') }} – {{ periode.dateFin|date('d/m/Y') }}
                            {% if periode.active %}<span class="status status-success ms-auto">En cours</span>{% endif %}
                        </div>
                        <h3>{{ periode.periode }}</h3>
                        <p>
                            {% if loop.first %}
                                Rentrée et premier temps d'apprentissage, clôturé par les conseils de classe.
                            {% elseif loop.last %}
                                Dernière période de l'année : évaluations finales et orientation.
                            {% else %}
                                Poursuite des enseignements et évaluations de mi-année.
                            {% endif %}
                        </p>
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>

<section class="site-section pt-0">
    <div class="site-container">
        <div class="cta-band">
            <div>
                <h2>Vous faites partie du lycée ?</h2>
                <p>Vos identifiants vous sont remis par l'administration à l'inscription.</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a href="{{ path(profil ? 'app_dashboard' : 'app_login') }}" class="btn btn-primary">{{ profil ? 'Accéder à mon espace' : 'Se connecter' }}</a>
                <a href="mailto:contact@monportaillycee.fr" class="btn btn-secondary">Contacter le secrétariat</a>
            </div>
        </div>
    </div>
</section>
{% endblock %}
