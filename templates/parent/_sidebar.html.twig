<nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block bg-dark sidebar collapse">
    <div class="position-sticky pt-3">
        <div class="text-center mb-4">
            <i class="fas fa-user-circle fa-3x text-white"></i>
            <h6 class="text-white mt-2">Espace Parent</h6>
            {% if app.user.parentEleve %}
                <small class="text-muted">{{ app.user.parentEleve.prenom }} {{ app.user.parentEleve.nom }}</small>
            {% endif %}
        </div>

        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link text-white {{ app.request.attributes.get('_route') == 'parent_dashboard' ? 'active bg-primary' : '' }}" 
                   href="{{ path('parent_dashboard') }}">
                    <i class="fas fa-home me-2"></i>
                    Dashboard
                </a>
            </li>

            <li><hr class="dropdown-divider bg-secondary"></li>

            <li class="nav-item">
                <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-4 mb-1 text-muted">
                    <span>MES ENFANTS</span>
                </h6>
            </li>

            {% if app.user.parentEleve %}
                {% for enfant in app.user.parentEleve.enfants %}
                    <li class="nav-item">
                        <div class="text-white px-3 py-2">
                            <i class="fas fa-user-graduate me-2"></i>
                            <strong>{{ enfant.prenom }}</strong>
                            <div class="btn-group-vertical w-100 mt-2">
                                <a href="{{ path('parent_enfant_notes', {'id': enfant.id}) }}" 
                                   class="btn btn-sm btn-outline-light text-start">
                                    <i class="fas fa-chart-line me-1"></i>Notes
                                </a>
                                <a href="{{ path('parent_enfant_bulletins', {'id': enfant.id}) }}" 
                                   class="btn btn-sm btn-outline-light text-start">
                                    <i class="fas fa-file-alt me-1"></i>Bulletins
                                </a>
                                <a href="{{ path('parent_enfant_absences', {'id': enfant.id}) }}" 
                                   class="btn btn-sm btn-outline-light text-start">
                                    <i class="fas fa-user-clock me-1"></i>Absences
                                </a>
                            </div>
                        </div>
                    </li>
                {% endfor %}
            {% endif %}
        </ul>

        <hr class="my-4">

        <div class="sidebar-footer">
            <div class="text-center">
                <a href="{{ path('app_logout') }}" class="btn btn-outline-light btn-sm">
                    <i class="fas fa-sign-out-alt me-1"></i>Déconnexion
                </a>
            </div>
        </div>
    </div>
</nav>
