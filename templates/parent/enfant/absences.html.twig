{% extends 'base.html.twig' %}

{% block title %}Absences de {{ enfant.prenom }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        {% include 'parent/_sidebar.html.twig' %}

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <!-- En-tête -->
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <div>
                    <h1 class="h2">
                        <i class="fas fa-user-clock me-2 text-primary"></i>
                        Absences de {{ enfant.prenom }} {{ enfant.nom }}
                    </h1>
                    <p class="text-muted mb-0">
                        <i class="fas fa-graduation-cap me-1"></i>{{ enfant.filiere.nom }}
                    </p>
                    {% if periodeActive %}
                        <p class="text-muted mb-0">
                            <i class="fas fa-calendar-check me-1"></i>
                            Période : <strong>{{ periodeActive.periode }}</strong> - {{ periodeActive.anneeScolaire }}
                        </p>
                    {% endif %}
                </div>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="{{ path('parent_dashboard') }}" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Retour
                    </a>
                </div>
            </div>

            <!-- Statistiques -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card text-white bg-primary">
                        <div class="card-body text-center">
                            <h6 class="text-white">Total Absences</h6>
                            <h2 class="mb-0">{{ stats.total }}</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-white bg-success">
                        <div class="card-body text-center">
                            <h6 class="text-white">Justifiées</h6>
                            <h2 class="mb-0">{{ stats.justifiees }}</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-white bg-danger">
                        <div class="card-body text-center">
                            <h6 class="text-white">Non Justifiées</h6>
                            <h2 class="mb-0">{{ stats.non_justifiees }}</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-white {% if stats.taux_assiduite >= 90 %}bg-success{% elseif stats.taux_assiduite >= 75 %}bg-warning{% else %}bg-danger{% endif %}">
                        <div class="card-body text-center">
                            <h6 class="text-white">Taux d'Assiduité</h6>
                            <h2 class="mb-0">{{ stats.taux_assiduite|number_format(1) }}%</h2>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Alerte si absences non justifiées -->
            {% if stats.non_justifiees > 0 %}
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Attention !</strong> Votre enfant a {{ stats.non_justifiees }} absence(s) non justifiée(s).
                </div>
            {% endif %}

            <!-- Liste des absences -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-list me-2"></i>Historique des Absences
                        <span class="badge bg-secondary ms-2">{{ absences|length }}</span>
                    </h5>
                </div>
                <div class="card-body">
                    {% if absences|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Date</th>
                                        <th>Type</th>
                                        <th>Période</th>
                                        <th>Matière</th>
                                        <th>Durée</th>
                                        <th>Statut</th>
                                        <th>Motif</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for absence in absences %}
                                        <tr>
                                            <td>{{ absence.date|date('d/m/Y') }}</td>
                                            <td>
                                                {% if absence.type == 'absence' %}
                                                    <span class="badge bg-danger">Absence</span>
                                                {% else %}
                                                    <span class="badge bg-warning">Retard</span>
                                                {% endif %}
                                            </td>
                                            <td>{{ absence.periode|capitalize }}</td>
                                            <td>{{ absence.matiere ? absence.matiere.nom : '-' }}</td>
                                            <td>{{ absence.dureeHeures|number_format(1) }}h</td>
                                            <td>
                                                {% if absence.justifiee %}
                                                    <span class="badge bg-success">
                                                        <i class="fas fa-check me-1"></i>Justifiée
                                                    </span>
                                                {% elseif absence.justification %}
                                                    <span class="badge bg-warning">
                                                        <i class="fas fa-clock me-1"></i>En attente
                                                    </span>
                                                {% else %}
                                                    <span class="badge bg-danger">
                                                        <i class="fas fa-times me-1"></i>Non justifiée
                                                    </span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if absence.motif %}
                                                    <small>{{ absence.motif|slice(0, 50) }}...</small>
                                                {% else %}
                                                    <span class="text-muted">-</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="text-center py-5">
                            <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                            <h5 class="text-success">Aucune absence</h5>
                            <p class="text-muted">Votre enfant n'a aucune absence pour cette période.</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}
