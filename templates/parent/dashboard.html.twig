{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h1>Suivi scolaire</h1>
        <p>
            Bonjour {{ parent.prenom }}, voici où en {{ enfantsStats|length > 1 ? 'sont vos enfants' : 'est votre enfant' }}
            {% if periodeActive %} · {{ periodeActive.periode }} {{ periodeActive.anneeScolaire }}{% endif %}
        </p>
    </div>
</div>

{% if enfantsStats is empty %}
    <section class="panel">
        <div class="empty-state">
            <div class="empty-state-icon"><i class="fas fa-user-graduate"></i></div>
            <h3>Aucun enfant rattaché à votre compte</h3>
            <p class="mb-0">Contactez le secrétariat du lycée pour associer votre compte au dossier de votre enfant.</p>
        </div>
    </section>
{% else %}
    {% if enfantsStats|length > 1 %}
        <nav class="segmented nav" role="tablist">
            {% for stats in enfantsStats %}
                <button class="nav-link {{ loop.first ? 'active' }}" data-bs-toggle="pill" data-bs-target="#enfant-{{ stats.enfant.id }}" type="button" role="tab">
                    <span class="avatar">{{ stats.enfant.prenom|first|upper }}{{ stats.enfant.nom|first|upper }}</span>
                    {{ stats.enfant.prenom }}
                </button>
            {% endfor %}
        </nav>
    {% endif %}

    <div class="tab-content">
        {% for stats in enfantsStats %}
            {% set enfant = stats.enfant %}
            <div class="tab-pane fade {{ loop.first ? 'show active' }}" id="enfant-{{ enfant.id }}" role="tabpanel">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <span class="avatar avatar-lg">{{ enfant.prenom|first|upper }}{{ enfant.nom|first|upper }}</span>
                    <div>
                        <div class="fw-semibold" style="font-size: 16px;">{{ enfant.prenom }} {{ enfant.nom }}</div>
                        <div class="small text-muted">{{ enfant.filiere ? enfant.filiere.nom : 'Filière non attribuée' }}</div>
                    </div>
                    {% if stats.absencesNonJustifiees > 0 %}
                        <span class="status status-warning ms-auto">{{ stats.absencesNonJustifiees }} absence{{ stats.absencesNonJustifiees > 1 ? 's' }} non justifiée{{ stats.absencesNonJustifiees > 1 ? 's' }}</span>
                    {% else %}
                        <span class="status status-success ms-auto">Aucune alerte</span>
                    {% endif %}
                </div>

                <div class="kpi-grid">
                    <a href="{{ path('parent_enfant_notes', {'id': enfant.id}) }}" class="kpi">
                        <span class="kpi-label"><i class="fas fa-chart-simple"></i>Moyenne générale</span>
                        <span class="kpi-value">
                            {% if stats.moyenneGenerale is not null %}{{ stats.moyenneGenerale|number_format(2, ',') }}<small> / 20</small>{% else %}—{% endif %}
                        </span>
                        <span class="kpi-meta">{{ stats.totalNotes }} note{{ stats.totalNotes > 1 ? 's' }} sur la période</span>
                    </a>
                    <a href="{{ path('parent_enfant_absences', {'id': enfant.id}) }}" class="kpi">
                        <span class="kpi-label"><i class="fas fa-user-clock"></i>Absences</span>
                        <span class="kpi-value">{{ stats.totalAbsences }}</span>
                        <span class="kpi-meta">{{ stats.absencesNonJustifiees }} non justifiée{{ stats.absencesNonJustifiees > 1 ? 's' }}</span>
                    </a>
                    <div class="kpi">
                        <span class="kpi-label"><i class="fas fa-calendar-check"></i>Assiduité</span>
                        <span class="kpi-value">{{ stats.tauxAssiduite|round(1)|number_format(1, ',') }}<small> %</small></span>
                        <span class="kpi-meta">sur la période en cours</span>
                    </div>
                    <a href="{{ path('parent_enfant_bulletins', {'id': enfant.id}) }}" class="kpi">
                        <span class="kpi-label"><i class="fas fa-file-lines"></i>Dernier bulletin</span>
                        <span class="kpi-value" style="font-size: 18px; padding: 3px 0;">{{ stats.dernierBulletin ? stats.dernierBulletin.periode : '—' }}</span>
                        <span class="kpi-meta">{{ stats.dernierBulletin ? stats.dernierBulletin.anneeScolaire : 'pas encore publié' }}</span>
                    </a>
                </div>

                <div class="row g-3">
                    <div class="col-lg-7">
                        <section class="panel h-100">
                            <div class="panel-header">
                                <h2>Dernières notes</h2>
                                <a href="{{ path('parent_enfant_notes', {'id': enfant.id}) }}" class="link-more">Toutes les notes <i class="fas fa-arrow-right"></i></a>
                            </div>
                            {% if stats.dernieresNotes is empty %}
                                <div class="empty-state">
                                    <div class="empty-state-icon"><i class="fas fa-chart-simple"></i></div>
                                    <h3>Aucune note sur la période</h3>
                                    <p class="mb-0">Les notes apparaîtront ici dès leur saisie par les enseignants.</p>
                                </div>
                            {% else %}
                                <div class="table-responsive">
                                    <table class="table">
                                        <thead><tr><th>Matière</th><th>Date</th><th class="text-end">Note</th></tr></thead>
                                        <tbody>
                                            {% for note in stats.dernieresNotes %}
                                                <tr>
                                                    <td class="fw-medium">{{ note.matiere ? note.matiere.nom : '—' }}</td>
                                                    <td class="text-muted">{{ note.dateNote ? note.dateNote|date('d/m/Y') : '—' }}</td>
                                                    <td class="text-end">
                                                        <span class="grade {{ note.valeur < 10 ? 'is-low' : (note.valeur >= 16 ? 'is-high') }}">
                                                            {{ note.valeur|number_format(2, ',')|replace({',00': ''}) }}<small> / 20</small>
                                                        </span>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% endif %}
                        </section>
                    </div>

                    <div class="col-lg-5">
                        <section class="panel h-100">
                            <div class="panel-header">
                                <h2>Absences récentes</h2>
                                <a href="{{ path('parent_enfant_absences', {'id': enfant.id}) }}" class="link-more">Historique <i class="fas fa-arrow-right"></i></a>
                            </div>
                            {% if stats.absencesRecentes is empty %}
                                <div class="empty-state">
                                    <div class="empty-state-icon"><i class="far fa-circle-check"></i></div>
                                    <h3>Aucune absence</h3>
                                    <p class="mb-0">Votre enfant a été présent à tous ses cours sur la période.</p>
                                </div>
                            {% else %}
                                <ul class="list-rows">
                                    {% for absence in stats.absencesRecentes %}
                                        <li class="list-row">
                                            <span class="list-row-main">
                                                <span class="list-row-title d-block">{{ absence.type == 'retard' ? 'Retard' : 'Absence' }} du {{ absence.date|date('d/m/Y') }}</span>
                                                <span class="list-row-meta d-block">{{ absence.matiere ? absence.matiere.nom : (absence.periode|capitalize) }}</span>
                                            </span>
                                            {% if absence.justifiee %}
                                                <span class="status status-success">Justifiée</span>
                                            {% elseif absence.justification %}
                                                <span class="status status-accent">En examen</span>
                                            {% else %}
                                                <span class="status status-danger">Non justifiée</span>
                                            {% endif %}
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </section>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
