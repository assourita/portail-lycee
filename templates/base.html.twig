{% set route_courante = app.request.attributes.get('_route') ?? '' %}
{% set routes_publiques = ['app_home', 'app_login', 'app_register', 'app_reset_password', 'app_reset_password_confirm'] %}
{% set profil = profil_utilisateur() %}
{% set coque_app = profil is not null and route_courante not in routes_publiques %}
{% set titre_page = block('title') %}
{% set fil_ariane %}{% block breadcrumb %}{% endblock %}{% endset %}
<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Accueil{% endblock %} · Mon Portail Lycée</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><rect width=%2232%22 height=%2232%22 rx=%228%22 fill=%22%23243B53%22/><path d=%22M16 8 5 13.5 16 19l11-5.5L16 8Zm-6.5 8.2V20c0 1.8 2.9 3.5 6.5 3.5s6.5-1.7 6.5-3.5v-3.8L16 19.5l-6.5-3.3Z%22 fill=%22white%22/></svg>">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;450;500;600;650&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
        <link href="{{ asset('css/app.css') }}" rel="stylesheet">
        {% if coque_app %}
            <script>
                if (localStorage.getItem('sidebar-reduite') === '1') {
                    document.documentElement.classList.add('sidebar-collapsed');
                }
            </script>
        {% endif %}
        {% block stylesheets %}{% endblock %}
    </head>

    {% if coque_app %}
        <body class="app-body">
            {% include 'layouts/_sidebar.html.twig' %}
            <div class="sidebar-backdrop" data-sidebar-close></div>

            <div class="app-main">
                {% include 'layouts/_topbar.html.twig' %}

                <main class="app-content" id="contenu">
                    {% include 'layouts/_flashes.html.twig' %}
                    {% block body %}{% endblock %}
                </main>
            </div>
    {% else %}
        <body class="public-body">
            {% include 'layouts/_site_header.html.twig' %}

            <main id="contenu">
                {% if app.request.hasPreviousSession and app.session.flashBag.peekAll is not empty %}
                    <div class="site-container pt-4">{% include 'layouts/_flashes.html.twig' %}</div>
                {% endif %}
                {{ block('body') }}
            </main>

            {% block site_footer %}{% include 'layouts/_site_footer.html.twig' %}{% endblock %}
    {% endif %}

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
            <script>
                (function () {
                    var racine = document.documentElement;
                    document.querySelectorAll('[data-sidebar-toggle]').forEach(function (bouton) {
                        bouton.addEventListener('click', function () {
                            if (window.matchMedia('(max-width: 991.98px)').matches) {
                                document.body.classList.toggle('sidebar-open');
                            } else {
                                var reduite = racine.classList.toggle('sidebar-collapsed');
                                localStorage.setItem('sidebar-reduite', reduite ? '1' : '0');
                            }
                        });
                    });
                    document.querySelectorAll('[data-sidebar-close]').forEach(function (el) {
                        el.addEventListener('click', function () { document.body.classList.remove('sidebar-open'); });
                    });
                    document.querySelectorAll('[data-site-menu]').forEach(function (bouton) {
                        bouton.addEventListener('click', function () {
                            document.getElementById(bouton.dataset.siteMenu).classList.toggle('open');
                        });
                    });
                    document.querySelectorAll('[data-confirm]').forEach(function (form) {
                        form.addEventListener('submit', function (e) {
                            if (!confirm(form.dataset.confirm)) { e.preventDefault(); }
                        });
                    });
                    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) { new bootstrap.Tooltip(el); });
                })();
            </script>
            {% block javascripts %}{% endblock %}
        </body>
</html>
