{% set sections = menus[profil.espace] ?? [] %}

{% if profil.espace == 'parent' and app.user.parentEleve %}
    {% for enfant in app.user.parentEleve.enfants %}
        {% set sections = sections|merge([{'titre': enfant.prenom ~ ' ' ~ enfant.nom, 'enfant': enfant.id, 'items': [
            {'label': 'Notes', 'icone': 'fa-chart-simple', 'route': 'parent_enfant_notes', 'parametres': {'id': enfant.id}, 'actif': ['parent_enfant_notes']},
            {'label': 'Bulletins', 'icone': 'fa-file-lines', 'route': 'parent_enfant_bulletins', 'parametres': {'id': enfant.id}, 'actif': ['parent_enfant_bulletins']},
            {'label': 'Absences', 'icone': 'fa-user-clock', 'route': 'parent_enfant_absences', 'parametres': {'id': enfant.id}, 'actif': ['parent_enfant_absences']},
        ]}]) %}
    {% endfor %}
{% endif %}

{% set id_courant = app.request.attributes.get('id') %}

<aside class="app-sidebar" aria-label="Navigation principale">
    <a href="{{ path('app_dashboard') }}" class="sidebar-brand">
        <span class="brand-mark"><i class="fas fa-graduation-cap"></i></span>
        <span class="brand-name">
            Mon Portail Lycée
            <span class="brand-space">{{ profil.role }}</span>
        </span>
    </a>

    <nav class="sidebar-nav">
        {% for section in sections %}
            <div class="nav-section">
                {% if section.titre is defined %}
                    <div class="nav-section-title" title="{{ section.titre }}">{{ section.titre }}</div>
                {% endif %}
                {% for item in section.items %}
                    {% set actif = item.actif|filter(prefixe => route_courante starts with prefixe)|length > 0 %}
                    {% if section.enfant is defined %}
                        {% set actif = actif and id_courant == section.enfant %}
                    {% endif %}
                    <a href="{{ path(item.route, item.parametres ?? {}) }}"
                       class="nav-link-item {{ actif ? 'active' }}"
                       {% if actif %}aria-current="page"{% endif %}
                       title="{{ item.label }}">
                        <i class="fas {{ item.icone }}"></i>
                        <span class="nav-label">{{ item.label }}</span>
                    </a>
                {% endfor %}
            </div>
        {% endfor %}
    </nav>

    <div class="sidebar-footer">
        <a href="{{ path('app_parametres_aide') }}" class="sidebar-help" title="Aide">
            <i class="fas fa-circle-question"></i>
            <span>Besoin d'aide ?<small>Questions fréquentes</small></span>
        </a>
    </div>
</aside>
