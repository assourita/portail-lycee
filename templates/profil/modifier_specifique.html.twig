{% extends 'base.html.twig' %}

{% block title %}Mes informations personnelles{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        {% include '_partials/sidebar_role.html.twig' %}

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">
                    <i class="fas fa-id-card me-2 text-primary"></i>
                    Mes informations personnelles
                </h1>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="{{ path('app_profil') }}" class="btn btn-sm btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Retour
                    </a>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-8">
                    <div class="card shadow">
                        <div class="card-body">
                            {{ form_start(form) }}
                                <div class="row">
                                    {% for champ in form %}
                                        {% if champ.vars.name != '_token' %}
                                            <div class="col-md-6 mb-3">
                                                {{ form_label(champ, null, {'label_attr': {'class': 'form-label'}}) }}
                                                {{ form_widget(champ) }}
                                                {{ form_errors(champ) }}
                                            </div>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-save me-1"></i>Enregistrer
                                    </button>
                                    <a href="{{ path('app_profil') }}" class="btn btn-secondary">Annuler</a>
                                </div>
                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-1"></i>
                        Les informations scolaires (filière, matières, classes) sont gérées par l'administration.
                        Contactez-la pour toute correction.
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}
