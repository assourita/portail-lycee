{% extends 'base.html.twig' %}
{% block title %}Détail Étudiant{% endblock %}
{% block body %}
<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        {% include 'admin/_sidebar.html.twig' %}

        <!-- Main content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Détail de l'étudiant</h1>
            </div>
            <div class="card">
                <div class="card-body">
                    <table class="table table-bordered">
                        <tr><th>ID</th><td>{{ etudiant.id }}</td></tr>
                        <tr><th>Nom</th><td>{{ etudiant.nom }}</td></tr>
                        <tr><th>Prénom</th><td>{{ etudiant.prenom }}</td></tr>
                        <tr><th>Email</th><td>{{ etudiant.email }}</td></tr>
                        <tr><th>Date de naissance</th><td>{{ etudiant.dateNaissance ? etudiant.dateNaissance|date('Y-m-d') : '' }}</td></tr>
                        <tr><th>Filière</th><td>{{ etudiant.filiere ? etudiant.filiere.nom : '' }}</td></tr>
                    </table>
                    <a href="{{ path('admin_etudiant_edit', {'id': etudiant.id}) }}" class="btn btn-warning">Modifier</a>
                    <a href="{{ path('admin_etudiants') }}" class="btn btn-secondary">Retour à la liste</a>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %} 