{% extends 'base.html.twig' %}

{% block title %}Nouvelle Filière{% endblock %}

{% block body %}
<div class="page">
            <div class="page-header">
                <h1 class="h2">Nouvelle Filière</h1>
            </div>

            <div class="card">
                <div class="card-body">
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.nom, 'Nom', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.nom) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.classe, 'Classe', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.classe, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.classe) }}
                            <div class="form-text">
                                <i class="fas fa-info-circle me-1"></i>
                                Associer cette filière à une classe (10ème, 11ème, Terminale)
                            </div>
                        </div>

                        <div class="mb-3">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Enregistrer
                            </button>
                            <a href="{{ path('admin_filieres') }}" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Retour
                            </a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
{% endblock %} 