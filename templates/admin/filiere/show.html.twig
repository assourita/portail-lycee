{% extends 'base.html.twig' %}

{% block title %}Détail Filière - {{ filiere.nom }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        {% include 'admin/_sidebar.html.twig' %}

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <!-- En-tête de la page -->
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <div>
                    <h1 class="h2">
                        <i class="fas fa-graduation-cap me-2 text-primary"></i>
                        {{ filiere.nom }}
                    </h1>
                    <p class="text-muted mb-0">Détails de la filière et informations associées</p>
                </div>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="{{ path('admin_filiere_edit', {'id': filiere.id}) }}" class="btn btn-warning me-2">
                        <i class="fas fa-edit me-1"></i>Modifier
                    </a>
                    <a href="{{ path('admin_filieres') }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Retour à la liste
                    </a>
                </div>
            </div>

            <!-- Informations de base -->
            {% if filiere.classe %}
                <div class="alert alert-info mb-4">
                    <i class="fas fa-school me-2"></i>
                    <strong>Classe associée :</strong> {{ filiere.classe.nom }}
                </div>
            {% else %}
                <div class="alert alert-warning mb-4">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Attention :</strong> Cette filière n'est pas encore associée à une classe.
                    <a href="{{ path('admin_filiere_edit', {'id': filiere.id}) }}" class="alert-link">Modifier</a>
                </div>
            {% endif %}

            <!-- Statistiques de la filière -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card bg-primary text-white">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <h4 class="card-title">{{ matieres|length }}</h4>
                                    <p class="card-text">Matières</p>
                                </div>
                                <div class="align-self-center">
                                    <i class="fas fa-book fa-2x"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-success text-white">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <h4 class="card-title">{{ etudiants|length }}</h4>
                                    <p class="card-text">Étudiants</p>
                                </div>
                                <div class="align-self-center">
                                    <i class="fas fa-users fa-2x"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-info text-white">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <h4 class="card-title">{{ emplois_du_temps|length }}</h4>
                                    <p class="card-text">Créneaux EDT</p>
                                </div>
                                <div class="align-self-center">
                                    <i class="fas fa-calendar-alt fa-2x"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-warning text-white">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <h4 class="card-title">{{ filiere.id }}</h4>
                                    <p class="card-text">ID Filière</p>
                                </div>
                                <div class="align-self-center">
                                    <i class="fas fa-hashtag fa-2x"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Onglets pour les différentes sections -->
            <ul class="nav nav-tabs" id="filiereTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="matieres-tab" data-bs-toggle="tab" data-bs-target="#matieres" type="button" role="tab">
                        <i class="fas fa-book me-1"></i>Matières ({{ matieres|length }})
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="etudiants-tab" data-bs-toggle="tab" data-bs-target="#etudiants" type="button" role="tab">
                        <i class="fas fa-users me-1"></i>Étudiants ({{ etudiants|length }})
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="emploi-tab" data-bs-toggle="tab" data-bs-target="#emploi" type="button" role="tab">
                        <i class="fas fa-calendar-alt me-1"></i>Emploi du temps ({{ emplois_du_temps|length }})
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="filiereTabsContent">
                <!-- Onglet Matières -->
                <div class="tab-pane fade show active" id="matieres" role="tabpanel">
                    <div class="card mt-3">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <i class="fas fa-book me-2"></i>Matières de la filière
                            </h5>
                            <a href="{{ path('admin_matiere_new') }}" class="btn btn-primary btn-sm">
                                <i class="fas fa-plus me-1"></i>Ajouter une matière
                            </a>
                        </div>
                        <div class="card-body">
                            {% if matieres|length > 0 %}
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>ID</th>
                                                <th>Nom</th>
                                                <th>Coefficient</th>
                                                <th>Enseignant</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for matiere in matieres %}
                                                <tr>
                                                    <td>{{ matiere.id }}</td>
                                                    <td>
                                                        <strong>{{ matiere.nom }}</strong>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-info">{{ matiere.coeficient }}</span>
                                                    </td>
                                                    <td>
                                                        {% if matiere.enseignant %}
                                                            <i class="fas fa-user-tie me-1"></i>
                                                            {{ matiere.enseignant.nom }} {{ matiere.enseignant.prenom }}
                                                        {% else %}
                                                            <span class="text-muted">Non assigné</span>
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        <a href="{{ path('admin_matiere_show', {'id': matiere.id}) }}" class="btn btn-info btn-sm">
                                                            <i class="fas fa-eye"></i>
                                                        </a>
                                                        <a href="{{ path('admin_matiere_edit', {'id': matiere.id}) }}" class="btn btn-warning btn-sm">
                                                            <i class="fas fa-edit"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% else %}
                                <div class="text-center py-5">
                                    <i class="fas fa-book fa-3x text-muted mb-3"></i>
                                    <h5 class="text-muted">Aucune matière assignée</h5>
                                    <p class="text-muted">Cette filière n'a pas encore de matières associées.</p>
                                    <a href="{{ path('admin_matiere_new') }}" class="btn btn-primary">
                                        <i class="fas fa-plus me-1"></i>Ajouter la première matière
                                    </a>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- Onglet Étudiants -->
                <div class="tab-pane fade" id="etudiants" role="tabpanel">
                    <div class="card mt-3">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <i class="fas fa-users me-2"></i>Étudiants de la filière
                            </h5>
                            <a href="{{ path('admin_etudiant_new') }}" class="btn btn-primary btn-sm">
                                <i class="fas fa-plus me-1"></i>Ajouter un étudiant
                            </a>
                        </div>
                        <div class="card-body">
                            {% if etudiants|length > 0 %}
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>ID</th>
                                                <th>Nom</th>
                                                <th>Prénom</th>
                                                <th>Email</th>
                                                <th>Date de naissance</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for etudiant in etudiants %}
                                                <tr>
                                                    <td>{{ etudiant.id }}</td>
                                                    <td><strong>{{ etudiant.nom }}</strong></td>
                                                    <td>{{ etudiant.prenom }}</td>
                                                    <td>
                                                        <i class="fas fa-envelope me-1"></i>
                                                        {{ etudiant.email }}
                                                    </td>
                                                    <td>
                                                        {% if etudiant.dateNaissance %}
                                                            {{ etudiant.dateNaissance|date('d/m/Y') }}
                                                        {% else %}
                                                            <span class="text-muted">Non renseignée</span>
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        <a href="{{ path('admin_etudiant_edit', {'id': etudiant.id}) }}" class="btn btn-warning btn-sm">
                                                            <i class="fas fa-edit"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% else %}
                                <div class="text-center py-5">
                                    <i class="fas fa-users fa-3x text-muted mb-3"></i>
                                    <h5 class="text-muted">Aucun étudiant inscrit</h5>
                                    <p class="text-muted">Cette filière n'a pas encore d'étudiants inscrits.</p>
                                    <a href="{{ path('admin_etudiant_new') }}" class="btn btn-primary">
                                        <i class="fas fa-plus me-1"></i>Inscrire le premier étudiant
                                    </a>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- Onglet Emploi du temps -->
                <div class="tab-pane fade" id="emploi" role="tabpanel">
                    <div class="card mt-3">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <i class="fas fa-calendar-alt me-2"></i>Emploi du temps de la filière
                            </h5>
                            <a href="{{ path('admin_emploi_du_temps_new', {'filiere': filiere.id}) }}" class="btn btn-primary btn-sm">
                                <i class="fas fa-plus me-1"></i>Créer l'emploi du temps
                            </a>
                        </div>
                        <div class="card-body">
                            {% if emplois_du_temps|length > 0 %}
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Jour</th>
                                                <th>Heure début</th>
                                                <th>Heure fin</th>
                                                <th>Matière</th>
                                                <th>Enseignant</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for emploi in emplois_du_temps %}
                                                <tr>
                                                    <td>
                                                        <span class="badge bg-secondary">
                                                            {{ emploi.jour ? emploi.jour.nom : 'N/A' }}
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <i class="fas fa-clock me-1"></i>
                                                        {{ emploi.heureDebut ? emploi.heureDebut|date('H:i') : 'N/A' }}
                                                    </td>
                                                    <td>
                                                        <i class="fas fa-clock me-1"></i>
                                                        {{ emploi.heureFin ? emploi.heureFin|date('H:i') : 'N/A' }}
                                                    </td>
                                                    <td>
                                                        <strong>{{ emploi.matiere ? emploi.matiere.nom : 'N/A' }}</strong>
                                                    </td>
                                                    <td>
                                                        {% if emploi.enseignant %}
                                                            <i class="fas fa-user-tie me-1"></i>
                                                            {{ emploi.enseignant.nom }} {{ emploi.enseignant.prenom }}
                                                        {% else %}
                                                            <span class="text-muted">Non assigné</span>
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        <a href="{{ path('admin_emploi_du_temps_filiere_edit', {'id': filiere.id}) }}" class="btn btn-warning btn-sm">
                                                            <i class="fas fa-edit"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% else %}
                                <div class="text-center py-5">
                                    <i class="fas fa-calendar-alt fa-3x text-muted mb-3"></i>
                                    <h5 class="text-muted">Aucun emploi du temps</h5>
                                    <p class="text-muted">Cette filière n'a pas encore d'emploi du temps configuré.</p>
                                    <a href="{{ path('admin_emploi_du_temps_new', {'filiere': filiere.id}) }}" class="btn btn-primary">
                                        <i class="fas fa-plus me-1"></i>Créer l'emploi du temps
                                    </a>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %} 