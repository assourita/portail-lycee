{% extends 'base.html.twig' %}

{% block title %}Comptables{% endblock %}

{% block body %}
<div class="page">
            <div class="page-header">
                <h1 class="h2">Gestion des Comptables</h1>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="{{ path('admin_comptable_new') }}" class="btn btn-sm btn-primary">
                        <i class="fas fa-plus me-1"></i>Nouveau comptable
                    </a>
                </div>
            </div>
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Liste des comptables</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Nom</th>
                                    <th>Prénom</th>
                                    <th>Email</th>
                                    <th>Nom d'utilisateur</th>
                                    <th>Rôles</th>
                                    <th>Dernière connexion</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for comptable in comptables %}
                                <tr>
                                    <td>{{ comptable.id }}</td>
                                    <td>{{ comptable.nom }}</td>
                                    <td>{{ comptable.prenom }}</td>
                                    <td>{{ comptable.email }}</td>
                                    <td>{{ comptable.user ? comptable.user.username : '' }}</td>
                                    <td>
                                        {% if comptable.user and comptable.user.roles is defined and comptable.user.roles|length > 0 %}
                                            {% for role in comptable.user.roles %}
                                                {% if role == 'ROLE_COMPTABLE' %}
                                                    <span class="badge bg-warning text-dark">Comptable</span>
                                                {% elseif role == 'ROLE_ADMIN' %}
                                                    <span class="badge bg-danger">Admin</span>
                                                {% elseif role == 'ROLE_ENSEIGNANT' %}
                                                    <span class="badge bg-success">Enseignant</span>
                                                {% elseif role == 'ROLE_ETUDIANT' %}
                                                    <span class="badge bg-primary">Étudiant</span>
                                                {% endif %}
                                            {% endfor %}
                                        {% else %}
                                            <span class="text-muted">Aucun rôle</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ comptable.user and comptable.user.lastLogin ? comptable.user.lastLogin|date('Y-m-d H:i:s') : 'Jamais' }}</td>
                                    <td>
                                        <a href="{{ path('admin_comptable_show', {'id': comptable.id}) }}" class="btn btn-sm btn-info">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="{{ path('admin_comptable_edit', {'id': comptable.id}) }}" class="btn btn-sm btn-warning">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form method="post" action="{{ path('admin_comptable_delete', {'id': comptable.id}) }}" style="display:inline-block" onsubmit="return confirm('Voulez-vous vraiment supprimer ce comptable ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete-comptable-' ~ comptable.id) }}">
                                            <button class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                                {% else %}
                                <tr><td colspan="6" class="text-center">Aucun comptable trouvé</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
{% endblock %} 