{% extends 'base.html.twig' %}

{% block title %}Détails de l'Absence{% endblock %}

{% block body %}
<div class="page">
            <!-- En-tête -->
            <div class="page-header">
                <div>
                    <h1 class="h2">
                        <i class="fas fa-user-clock me-2 text-primary"></i>
                        Détails de l'Absence
                    </h1>
                    <p class="text-muted mb-0">
                        {{ absence.etudiant.nom }} {{ absence.etudiant.prenom }} - {{ absence.date|date('d/m/Y') }}
                    </p>
                </div>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="{{ path('admin_absences_index') }}" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Retour
                    </a>
                </div>
            </div>

            <div class="row">
                <div class="col-md-8">
                    <!-- Informations de l'absence -->
                    <div class="card mb-4">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-info-circle me-2"></i>Informations
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <strong><i class="fas fa-user me-2 text-primary"></i>Étudiant :</strong>
                                    <p>{{ absence.etudiant.nom }} {{ absence.etudiant.prenom }}</p>
                                </div>
                                <div class="col-md-6">
                                    <strong><i class="fas fa-graduation-cap me-2 text-primary"></i>Filière :</strong>
                                    <p>{{ absence.etudiant.filiere.nom }}</p>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <strong><i class="fas fa-calendar me-2 text-primary"></i>Date :</strong>
                                    <p>{{ absence.date|date('d/m/Y') }}</p>
                                </div>
                                <div class="col-md-4">
                                    <strong><i class="fas fa-tag me-2 text-primary"></i>Type :</strong>
                                    <p>
                                        {% if absence.type == 'absence' %}
                                            <span class="badge bg-danger">Absence</span>
                                        {% else %}
                                            <span class="badge bg-warning">Retard</span>
                                        {% endif %}
                                    </p>
                                </div>
                                <div class="col-md-4">
                                    <strong><i class="fas fa-clock me-2 text-primary"></i>Période :</strong>
                                    <p>{{ absence.periode|capitalize }}</p>
                                </div>
                            </div>

                            {% if absence.heureDebut or absence.heureFin %}
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <strong><i class="fas fa-hourglass-start me-2 text-primary"></i>Heure début :</strong>
                                        <p>{{ absence.heureDebut ? absence.heureDebut|date('H:i') : '-' }}</p>
                                    </div>
                                    <div class="col-md-6">
                                        <strong><i class="fas fa-hourglass-end me-2 text-primary"></i>Heure fin :</strong>
                                        <p>{{ absence.heureFin ? absence.heureFin|date('H:i') : '-' }}</p>
                                    </div>
                                </div>
                            {% endif %}

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <strong><i class="fas fa-book me-2 text-primary"></i>Matière :</strong>
                                    <p>{{ absence.matiere ? absence.matiere.nom : '-' }}</p>
                                </div>
                                <div class="col-md-6">
                                    <strong><i class="fas fa-chalkboard-teacher me-2 text-primary"></i>Enseignant :</strong>
                                    <p>{{ absence.enseignant ? (absence.enseignant.nom ~ ' ' ~ absence.enseignant.prenom) : '-' }}</p>
                                </div>
                            </div>

                            {% if absence.motif %}
                                <div class="mb-3">
                                    <strong><i class="fas fa-comment me-2 text-primary"></i>Motif :</strong>
                                    <p>{{ absence.motif }}</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Justification -->
                    {% if absence.justification or absence.justifiee %}
                        <div class="card mb-4">
                            <div class="card-header {% if absence.justifiee %}bg-success{% else %}bg-warning{% endif %} text-white">
                                <h5 class="mb-0">
                                    <i class="fas fa-file-alt me-2"></i>Justification
                                </h5>
                            </div>
                            <div class="card-body">
                                {% if absence.justification %}
                                    <p><strong>Justification de l'étudiant :</strong></p>
                                    <p class="bg-light p-3 rounded">{{ absence.justification }}</p>
                                {% if absence.documentJustificatif %}
                                    <p>
                                        <a href="{{ path('fichier_absence_justificatif', {'id': absence.id}) }}" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-file-download me-1"></i>Télécharger le justificatif
                                        </a>
                                    </p>
                                {% endif %}
                                {% endif %}

                                {% if absence.justifiee %}
                                    <div class="alert alert-success">
                                        <i class="fas fa-check-circle me-2"></i>
                                        <strong>Absence validée</strong>
                                        {% if absence.validePar %}
                                            par {{ absence.validePar.email }}
                                        {% endif %}
                                        {% if absence.dateValidation %}
                                            le {{ absence.dateValidation|date('d/m/Y à H:i') }}
                                        {% endif %}
                                    </div>
                                {% elseif absence.justification %}
                                    <div class="alert alert-warning">
                                        <i class="fas fa-clock me-2"></i>
                                        <strong>En attente de validation</strong>
                                    </div>
                                    
                                    <div class="d-flex gap-2">
                                        <form method="post" action="{{ path('admin_absence_valider', {'id': absence.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('valider' ~ absence.id) }}">
                                            <button type="submit" class="btn btn-success">
                                                <i class="fas fa-check me-1"></i>Valider la justification
                                            </button>
                                        </form>
                                        <form method="post" action="{{ path('admin_absence_rejeter', {'id': absence.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('rejeter' ~ absence.id) }}">
                                            <button type="submit" class="btn btn-danger">
                                                <i class="fas fa-times me-1"></i>Rejeter
                                            </button>
                                        </form>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}
                </div>

                <div class="col-md-4">
                    <!-- Statut -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h6 class="mb-0">
                                <i class="fas fa-info-circle me-2"></i>Statut
                            </h6>
                        </div>
                        <div class="card-body text-center">
                            {% if absence.justifiee %}
                                <i class="fas fa-check-circle fa-4x text-success mb-3"></i>
                                <h5 class="text-success">Justifiée</h5>
                            {% elseif absence.justification %}
                                <i class="fas fa-clock fa-4x text-warning mb-3"></i>
                                <h5 class="text-warning">En attente</h5>
                            {% else %}
                                <i class="fas fa-times-circle fa-4x text-danger mb-3"></i>
                                <h5 class="text-danger">Non justifiée</h5>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Informations complémentaires -->
                    <div class="card">
                        <div class="card-header">
                            <h6 class="mb-0">
                                <i class="fas fa-clock me-2"></i>Dates
                            </h6>
                        </div>
                        <div class="card-body">
                            <p><strong>Créée le :</strong><br>{{ absence.dateCreation|date('d/m/Y à H:i') }}</p>
                            {% if absence.dateModification %}
                                <p><strong>Modifiée le :</strong><br>{{ absence.dateModification|date('d/m/Y à H:i') }}</p>
                            {% endif %}
                            <p><strong>Durée estimée :</strong><br>{{ absence.dureeHeures|number_format(1) }} heure(s)</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
{% endblock %}
