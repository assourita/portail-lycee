{% extends 'base.html.twig' %}
{% block title %}Détail Comptable{% endblock %}
{% block body %}
<div class="page">
            <div class="page-header">
                <h1 class="h2">Détail du comptable</h1>
            </div>
            <div class="card">
                <div class="card-body">
                    <table class="table table-bordered">
                        <tr><th>ID</th><td>{{ comptable.id }}</td></tr>
                        <tr><th>Nom</th><td>{{ comptable.nom }}</td></tr>
                        <tr><th>Prénom</th><td>{{ comptable.prenom }}</td></tr>
                        <tr><th>Email</th><td>{{ comptable.email }}</td></tr>
                        <tr><th>Utilisateur lié</th><td>{{ comptable.user ? comptable.user.username : '' }}</td></tr>
                    </table>
                    <a href="{{ path('admin_comptable_edit', {'id': comptable.id}) }}" class="btn btn-warning">Modifier</a>
                    <a href="{{ path('admin_comptables') }}" class="btn btn-secondary">Retour à la liste</a>
                </div>
            </div>
        </div>
{% endblock %} 