{% extends 'base.html.twig' %}

{% block title %}Modifier {{ trimestre.nom }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        {% include 'admin/_sidebar.html.twig' %}

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <!-- En-tête de la page -->
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <div>
                    <h1 class="h2">
                        <i class="fas fa-edit me-2 text-warning"></i>
                        Modifier {{ trimestre.nom }}
                    </h1>
                    <p class="text-muted mb-0">{{ trimestre.classe.nom }} - {{ trimestre.anneeScolaire }}</p>
                </div>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="{{ path('admin_trimestre_show', {'id': trimestre.id}) }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Retour
                    </a>
                </div>
            </div>

            <!-- Formulaire de modification -->
            <div class="row">
                <div class="col-lg-8">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <i class="fas fa-edit me-2"></i>Informations du Trimestre
                            </h5>
                        </div>
                        <div class="card-body">
                            <form method="post">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="classe" class="form-label">
                                            <i class="fas fa-school me-1"></i>Classe *
                                        </label>
                                        <select class="form-select" id="classe" name="classe" required>
                                            {% for classe in classes %}
                                                <option value="{{ classe.id }}" {% if classe.id == trimestre.classe.id %}selected{% endif %}>
                                                    {{ classe.nom }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label for="nom" class="form-label">
                                            <i class="fas fa-tag me-1"></i>Nom du trimestre *
                                        </label>
                                        <select class="form-select" id="nom" name="nom" required>
                                            <option value="1er Trimestre" {% if trimestre.nom == '1er Trimestre' %}selected{% endif %}>1er Trimestre</option>
                                            <option value="2ème Trimestre" {% if trimestre.nom == '2ème Trimestre' %}selected{% endif %}>2ème Trimestre</option>
                                            <option value="3ème Trimestre" {% if trimestre.nom == '3ème Trimestre' %}selected{% endif %}>3ème Trimestre</option>
                                            <option value="1er Semestre" {% if trimestre.nom == '1er Semestre' %}selected{% endif %}>1er Semestre</option>
                                            <option value="2ème Semestre" {% if trimestre.nom == '2ème Semestre' %}selected{% endif %}>2ème Semestre</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label for="annee_scolaire" class="form-label">
                                            <i class="fas fa-calendar me-1"></i>Année Scolaire *
                                        </label>
                                        <select class="form-select" id="annee_scolaire" name="annee_scolaire" required>
                                            {% for annee in annees_scolaires() %}
                                            <option value="{{ annee }}" {{ trimestre.anneeScolaire == annee ? 'selected' }}>{{ annee }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>

                                    <div class="col-md-4 mb-3">
                                        <label for="date_debut" class="form-label">
                                            <i class="fas fa-play me-1"></i>Date de début *
                                        </label>
                                        <input type="date" class="form-control" id="date_debut" name="date_debut" 
                                               value="{{ trimestre.dateDebut|date('Y-m-d') }}" required>
                                    </div>

                                    <div class="col-md-4 mb-3">
                                        <label for="date_fin" class="form-label">
                                            <i class="fas fa-stop me-1"></i>Date de fin *
                                        </label>
                                        <input type="date" class="form-control" id="date_fin" name="date_fin" 
                                               value="{{ trimestre.dateFin|date('Y-m-d') }}" required>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label for="description" class="form-label">
                                        <i class="fas fa-align-left me-1"></i>Description (optionnel)
                                    </label>
                                    <textarea class="form-control" id="description" name="description" rows="3">{{ trimestre.description }}</textarea>
                                </div>

                                <hr>

                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                    <a href="{{ path('admin_trimestre_show', {'id': trimestre.id}) }}" class="btn btn-secondary me-md-2">
                                        <i class="fas fa-times me-1"></i>Annuler
                                    </a>
                                    <button type="submit" class="btn btn-warning">
                                        <i class="fas fa-save me-1"></i>Enregistrer les Modifications
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}

