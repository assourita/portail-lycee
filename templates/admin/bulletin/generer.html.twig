{% extends 'base.html.twig' %}

{% block title %}Générer des Bulletins{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        {% include 'admin/_sidebar.html.twig' %}

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <!-- En-tête de la page -->
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <div>
                    <h1 class="h2">
                        <i class="fas fa-magic me-2 text-success"></i>
                        Génération Automatique des Bulletins
                    </h1>
                    <p class="text-muted mb-0">Générer automatiquement les bulletins pour une ou plusieurs filières</p>
                </div>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="{{ path('admin_bulletins_index') }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Retour à la liste
                    </a>
                </div>
            </div>

            <!-- Bannière d'information -->
            <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
                <i class="fas fa-magic fa-2x me-3"></i>
                <div>
                    <h5 class="alert-heading mb-1">🎯 Génération par Classe</h5>
                    <p class="mb-0">
                        <strong>Sélectionnez une classe</strong> (10ème, 11ème ou Terminale) et un <strong>trimestre</strong> : 
                        le système générera automatiquement les bulletins pour <strong>TOUS les étudiants de TOUTES les filières</strong> de cette classe !
                    </p>
                </div>
            </div>

            <div class="alert alert-warning mb-4">
                <i class="fas fa-lightbulb me-2"></i>
                <strong>Exemple :</strong> En sélectionnant "10ème" et "1er Trimestre 2024-2025", tous les bulletins seront créés pour tous les étudiants 
                de toutes les filières de 10ème (Sciences Exactes, Sciences Humaines, etc.) en une seule fois !
            </div>

            <!-- Formulaire de génération -->
            <div class="row">
                <div class="col-lg-8">
                    <div class="card shadow-sm">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-cogs me-2"></i>Paramètres de Génération
                            </h5>
                        </div>
                        <div class="card-body">
                            <form method="post" id="generation-form">
                                <div class="row">
                                    <div class="col-md-6 mb-4">
                                        <label for="classe-select" class="form-label">
                                            <i class="fas fa-school me-1"></i>Classe (Niveau) *
                                        </label>
                                        <select class="form-select form-select-lg" id="classe-select" name="classe" required>
                                            <option value="">Sélectionner une classe</option>
                                            <option value="all" class="fw-bold text-primary">🌐 TOUTES LES CLASSES (Tout le lycée)</option>
                                            <option disabled>──────────────────────</option>
                                            {% for classe in classes %}
                                                <option value="{{ classe.id }}">
                                                    📚 {{ classe.nom }} (toutes ses filières)
                                                </option>
                                            {% endfor %}
                                        </select>
                                        <div class="form-text">
                                            <i class="fas fa-users me-1"></i>
                                            <strong>Important :</strong> Tous les étudiants de toutes les filières de la classe sélectionnée recevront un bulletin.
                                        </div>
                                    </div>

                                    <div class="col-md-6 mb-4">
                                        <label for="trimestre-select" class="form-label">
                                            <i class="fas fa-calendar-alt me-1"></i>Trimestre/Période *
                                        </label>
                                        <select class="form-select form-select-lg" id="trimestre-select" name="trimestre" required>
                                            <option value="">Sélectionner un trimestre</option>
                                            {% for trimestre in trimestres %}
                                                <option value="{{ trimestre.id }}" 
                                                        data-classe="{{ trimestre.classe.id }}"
                                                        data-nom="{{ trimestre.nom }}"
                                                        data-debut="{{ trimestre.dateDebut|date('d/m/Y') }}"
                                                        data-fin="{{ trimestre.dateFin|date('d/m/Y') }}"
                                                        data-annee="{{ trimestre.anneeScolaire }}">
                                                    {{ trimestre.classe.nom }} - {{ trimestre.nom }} ({{ trimestre.anneeScolaire }})
                                                </option>
                                            {% endfor %}
                                        </select>
                                        <div class="form-text">
                                            <i class="fas fa-filter me-1"></i>
                                            Seuls les trimestres de la classe sélectionnée s'afficheront.
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <div class="card bg-light">
                                        <div class="card-body">
                                            <h6 class="card-title">
                                                <i class="fas fa-comment-dots me-2"></i>Options de Commentaires
                                            </h6>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" id="generer_commentaires" 
                                                       name="generer_commentaires" value="1" checked>
                                                <label class="form-check-label" for="generer_commentaires">
                                                    <strong>Générer des commentaires automatiques</strong>
                                                </label>
                                            </div>
                                            <small class="text-muted">
                                                Les commentaires seront générés automatiquement en fonction de la moyenne générale de chaque étudiant.
                                            </small>
                                        </div>
                                    </div>
                                </div>

                                <div id="date-info-section" style="display: none;" class="mb-4">
                                    <div class="card bg-info text-white">
                                        <div class="card-body">
                                            <h6 class="card-title">
                                                <i class="fas fa-calendar-check me-2"></i>Date de fin de période
                                            </h6>
                                            <p class="mb-0" id="date-info-text"></p>
                                        </div>
                                    </div>
                                </div>

                                <div id="preview-section" style="display: none;">
                                    <div class="alert alert-warning">
                                        <h6 class="alert-heading">
                                            <i class="fas fa-exclamation-triangle me-2"></i>Aperçu de la génération
                                        </h6>
                                        <p class="mb-2" id="preview-text"></p>
                                        <hr>
                                        <p class="mb-0 small">
                                            <strong>Note :</strong> Les bulletins existants pour cette période ne seront pas écrasés.
                                        </p>
                                    </div>
                                </div>

                                <hr>

                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                    <a href="{{ path('admin_bulletins_index') }}" class="btn btn-secondary btn-lg me-md-2">
                                        <i class="fas fa-times me-1"></i>Annuler
                                    </a>
                                    <button type="submit" class="btn btn-success btn-lg" id="submit-btn">
                                        <i class="fas fa-magic me-1"></i>Générer les Bulletins
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <!-- Statistiques -->
                    <div class="card mb-3 shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h6 class="mb-0">
                                <i class="fas fa-chart-bar me-2"></i>Statistiques
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row text-center">
                                <div class="col-12 mb-3">
                                    <div class="stat-box p-3 bg-light rounded">
                                        <h3 class="mb-1 text-primary">{{ classes|length }}</h3>
                                        <small class="text-muted">Classes disponibles</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Barème des commentaires -->
                    <div class="card mb-3 shadow-sm">
                        <div class="card-header bg-info text-white">
                            <h6 class="mb-0">
                                <i class="fas fa-star me-2"></i>Barème des Commentaires
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <span class="badge bg-success mb-1">≥ 16/20</span>
                                <p class="small mb-0">Excellent travail ! Continue comme ça !</p>
                            </div>
                            <hr>
                            <div class="mb-3">
                                <span class="badge bg-primary mb-1">14-15.99/20</span>
                                <p class="small mb-0">Très bon niveau. Quelques efforts pour l'excellence.</p>
                            </div>
                            <hr>
                            <div class="mb-3">
                                <span class="badge bg-info mb-1">12-13.99/20</span>
                                <p class="small mb-0">Bon niveau. Maintenir les efforts.</p>
                            </div>
                            <hr>
                            <div class="mb-3">
                                <span class="badge bg-warning mb-1">10-11.99/20</span>
                                <p class="small mb-0">Passable. Efforts supplémentaires nécessaires.</p>
                            </div>
                            <hr>
                            <div class="mb-0">
                                <span class="badge bg-danger mb-1">< 10/20</span>
                                <p class="small mb-0">Insuffisant. Travail régulier requis.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Aide -->
                    <div class="card shadow-sm border-success">
                        <div class="card-header bg-success text-white">
                            <h6 class="mb-0">
                                <i class="fas fa-question-circle me-2"></i>Comment ça marche ?
                            </h6>
                        </div>
                        <div class="card-body">
                            <h6>📋 Étapes de génération par classe :</h6>
                            <ol class="small">
                                <li><strong>Sélectionnez la classe</strong> (10ème, 11ème, Terminale ou toutes)</li>
                                <li><strong>Choisissez le trimestre</strong> (filtré par classe)</li>
                                <li><strong>Activez les commentaires</strong> automatiques si souhaité</li>
                                <li><strong>Cliquez sur "Générer"</strong></li>
                            </ol>
                            <hr>
                            <div class="alert alert-success mb-2">
                                <strong>✅ Résultat :</strong> Tous les étudiants de <u>toutes les filières</u> de la classe auront leur bulletin !
                            </div>
                            <p class="small text-muted mb-0">
                                <i class="fas fa-shield-alt me-1"></i>
                                <strong>Protection :</strong> Les bulletins déjà existants ne seront jamais écrasés.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const classeSelect = document.getElementById('classe-select');
    const trimestreSelect = document.getElementById('trimestre-select');
    const previewSection = document.getElementById('preview-section');
    const previewText = document.getElementById('preview-text');
    const dateInfoSection = document.getElementById('date-info-section');
    const dateInfoText = document.getElementById('date-info-text');
    const submitBtn = document.getElementById('submit-btn');

    // Stocker toutes les options de trimestre
    const allTrimestreOptions = Array.from(trimestreSelect.options).slice(1); // Exclure l'option vide

    function filterTrimestres() {
        const selectedClasseId = classeSelect.value;
        
        // Réinitialiser le select des trimestres
        trimestreSelect.innerHTML = '<option value="">Sélectionner un trimestre</option>';
        
        if (selectedClasseId === 'all') {
            // Afficher tous les trimestres
            allTrimestreOptions.forEach(option => {
                trimestreSelect.appendChild(option.cloneNode(true));
            });
        } else if (selectedClasseId) {
            // Filtrer par classe
            allTrimestreOptions.forEach(option => {
                if (option.dataset.classe === selectedClasseId) {
                    trimestreSelect.appendChild(option.cloneNode(true));
                }
            });
        }
    }

    function updateDateInfo() {
        const selectedTrimestre = trimestreSelect.options[trimestreSelect.selectedIndex];

        if (trimestreSelect.value && selectedTrimestre.dataset.debut) {
            const dateText = `Période : <strong>${selectedTrimestre.dataset.nom}</strong><br>
                Du <strong>${selectedTrimestre.dataset.debut}</strong> au <strong>${selectedTrimestre.dataset.fin}</strong><br>
                Année scolaire : <strong>${selectedTrimestre.dataset.annee}</strong>`;
            dateInfoText.innerHTML = dateText;
            dateInfoSection.style.display = 'block';
        } else {
            dateInfoSection.style.display = 'none';
        }
    }

    function updatePreview() {
        const classe = classeSelect.options[classeSelect.selectedIndex].text;
        const trimestre = trimestreSelect.options[trimestreSelect.selectedIndex];

        updateDateInfo();

        if (classeSelect.value && trimestreSelect.value) {
            let message = '';
            if (classeSelect.value === 'all') {
                message = `Vous êtes sur le point de générer les bulletins pour <strong>TOUS LES ÉTUDIANTS</strong> de <strong>TOUTES LES CLASSES</strong> pour <strong>${trimestre.dataset.nom}</strong>.`;
            } else {
                message = `Vous êtes sur le point de générer les bulletins pour tous les étudiants de la classe <strong>${classe}</strong> pour <strong>${trimestre.dataset.nom}</strong>.`;
            }
            previewText.innerHTML = message;
            previewSection.style.display = 'block';
        } else {
            previewSection.style.display = 'none';
        }
    }

    classeSelect.addEventListener('change', function() {
        filterTrimestres();
        updatePreview();
    });
    
    trimestreSelect.addEventListener('change', updatePreview);

    // Confirmation avant soumission
    document.getElementById('generation-form').addEventListener('submit', function(e) {
        const classe = classeSelect.options[classeSelect.selectedIndex].text;
        const trimestre = trimestreSelect.options[trimestreSelect.selectedIndex];
        
        if (!trimestreSelect.value) {
            alert('Veuillez sélectionner un trimestre.');
            e.preventDefault();
            return;
        }
        
        let confirmMessage = '';
        if (classeSelect.value === 'all') {
            confirmMessage = `Êtes-vous sûr de vouloir générer les bulletins pour TOUS LES ÉTUDIANTS de TOUTES LES CLASSES pour "${trimestre.dataset.nom}" ?`;
        } else {
            confirmMessage = `Êtes-vous sûr de vouloir générer les bulletins pour tous les étudiants de la classe "${classe}" pour "${trimestre.dataset.nom}" ?`;
        }

        if (!confirm(confirmMessage)) {
            e.preventDefault();
        } else {
            // Désactiver le bouton pour éviter les doubles soumissions
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Génération en cours...';
        }
    });
});
</script>

<style>
.stat-box {
    transition: all 0.3s ease;
}

.stat-box:hover {
    transform: translateY(-5px);
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}

.form-select-lg {
    font-size: 1.1rem;
    padding: 0.75rem 1rem;
}

.card {
    transition: all 0.3s ease;
}

.card:hover {
    box-shadow: 0 8px 16px rgba(0,0,0,0.1);
}
</style>
{% endblock %}
