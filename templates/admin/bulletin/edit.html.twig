{% extends 'base.html.twig' %}

{% block title %}Modifier Bulletin - {{ bulletin.etudiant.nom }} {{ bulletin.etudiant.prenom }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        {% include 'admin/_sidebar.html.twig' %}

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <!-- En-tête de la page -->
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <div>
                    <h1 class="h2">
                        <i class="fas fa-edit me-2 text-warning"></i>
                        Modifier le Bulletin
                    </h1>
                    <p class="text-muted mb-0">
                        {{ bulletin.etudiant.nom }} {{ bulletin.etudiant.prenom }} - {{ bulletin.periode }} {{ bulletin.anneeScolaire }}
                    </p>
                </div>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="{{ path('admin_bulletin_show', {'id': bulletin.id}) }}" class="btn btn-primary me-2">
                        <i class="fas fa-eye me-1"></i>Voir
                    </a>
                    <a href="{{ path('admin_bulletins_index') }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Retour à la liste
                    </a>
                </div>
            </div>

            <!-- Formulaire de modification -->
            <div class="row">
                <div class="col-lg-8">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <i class="fas fa-edit me-2"></i>Modifier les Informations
                            </h5>
                        </div>
                        <div class="card-body">
                            <form method="post" id="bulletin-edit-form">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="periode" class="form-label">
                                            <i class="fas fa-calendar-alt me-1"></i>Période *
                                        </label>
                                        <select class="form-select" id="periode" name="periode" required>
                                            <option value="1er Trimestre" {% if bulletin.periode == '1er Trimestre' %}selected{% endif %}>1er Trimestre</option>
                                            <option value="2ème Trimestre" {% if bulletin.periode == '2ème Trimestre' %}selected{% endif %}>2ème Trimestre</option>
                                            <option value="3ème Trimestre" {% if bulletin.periode == '3ème Trimestre' %}selected{% endif %}>3ème Trimestre</option>
                                            <option value="1er Semestre" {% if bulletin.periode == '1er Semestre' %}selected{% endif %}>1er Semestre</option>
                                            <option value="2ème Semestre" {% if bulletin.periode == '2ème Semestre' %}selected{% endif %}>2ème Semestre</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="annee_scolaire" class="form-label">
                                            <i class="fas fa-calendar me-1"></i>Année Scolaire *
                                        </label>
                                        <select class="form-select" id="annee_scolaire" name="annee_scolaire" required>
                                            <option value="2023-2024" {% if bulletin.anneeScolaire == '2023-2024' %}selected{% endif %}>2023-2024</option>
                                            <option value="2024-2025" {% if bulletin.anneeScolaire == '2024-2025' %}selected{% endif %}>2024-2025</option>
                                            <option value="2025-2026" {% if bulletin.anneeScolaire == '2025-2026' %}selected{% endif %}>2025-2026</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label for="commentaire" class="form-label">
                                        <i class="fas fa-comment me-1"></i>Commentaire
                                    </label>
                                    <textarea class="form-control" id="commentaire" name="commentaire" rows="4" 
                                              placeholder="Commentaires généraux sur le bulletin...">{{ bulletin.commentaire }}</textarea>
                                </div>

                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                    <a href="{{ path('admin_bulletin_show', {'id': bulletin.id}) }}" class="btn btn-secondary me-md-2">
                                        <i class="fas fa-times me-1"></i>Annuler
                                    </a>
                                    <button type="submit" class="btn btn-warning">
                                        <i class="fas fa-save me-1"></i>Enregistrer les Modifications
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <!-- Informations sur l'étudiant -->
                    <div class="card mb-3">
                        <div class="card-header">
                            <h6 class="mb-0">
                                <i class="fas fa-user me-2"></i>Informations de l'étudiant
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-3">
                                <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                                    <i class="fas fa-user"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0">{{ bulletin.etudiant.nom }} {{ bulletin.etudiant.prenom }}</h6>
                                    <small class="text-muted">{{ bulletin.etudiant.email }}</small>
                                </div>
                            </div>
                            <hr>
                            <div class="row text-center">
                                <div class="col-6">
                                    <h6 class="text-muted mb-1">Filière</h6>
                                    <p class="mb-0">{{ bulletin.etudiant.filiere.nom }}</p>
                                </div>
                                <div class="col-6">
                                    <h6 class="text-muted mb-1">Inscription</h6>
                                    <p class="mb-0">{{ bulletin.etudiant.dateInscription|date('d/m/Y') }}</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Informations du bulletin -->
                    <div class="card mb-3">
                        <div class="card-header">
                            <h6 class="mb-0">
                                <i class="fas fa-info-circle me-2"></i>Informations du bulletin
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row text-center">
                                <div class="col-12 mb-2">
                                    <h6 class="text-muted mb-1">Date de création</h6>
                                    <p class="mb-0">{{ bulletin.dateCreation|date('d/m/Y H:i') }}</p>
                                </div>
                                {% if bulletin.dateModification %}
                                    <div class="col-12 mb-2">
                                        <h6 class="text-muted mb-1">Dernière modification</h6>
                                        <p class="mb-0">{{ bulletin.dateModification|date('d/m/Y H:i') }}</p>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <!-- Aide -->
                    <div class="card">
                        <div class="card-header">
                            <h6 class="mb-0">
                                <i class="fas fa-info-circle me-2"></i>Aide
                            </h6>
                        </div>
                        <div class="card-body">
                            <h6>Modification du bulletin :</h6>
                            <ul class="small">
                                <li>Vous pouvez modifier la période et l'année scolaire</li>
                                <li>Ajoutez ou modifiez le commentaire</li>
                                <li>Les notes ne peuvent pas être modifiées ici</li>
                                <li>Pour modifier les notes, utilisez la gestion des notes</li>
                            </ul>
                            <hr>
                            <p class="small text-muted mb-0">
                                <i class="fas fa-lightbulb me-1"></i>
                                Les modifications seront enregistrées avec la date actuelle.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}
