{% extends 'base.html.twig' %}

{% block title %}Emploi du Temps - {{ filiere.nom }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        {% include 'admin/_sidebar.html.twig' %}

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">
                    <i class="fas fa-calendar-alt me-2"></i>Emploi du Temps - {{ filiere.nom }}
                </h1>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="{{ path('admin_emploi_du_temps_new', {'filiere': filiere.id}) }}" class="btn btn-primary me-2">
                        <i class="fas fa-edit me-1"></i>Modifier
                    </a>
                    <button type="button" class="btn btn-outline-primary" onclick="window.print()">
                        <i class="fas fa-print me-1"></i>Imprimer
                    </button>
                    <a href="{{ path('admin_emploi_du_temps_index') }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Retour
                    </a>
                </div>
            </div>

            {% if emplois_par_jour %}
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-graduation-cap me-2"></i>
                            Emploi du temps - {{ filiere.nom }}
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th style="width: 15%">Heure</th>
                                        <th style="width: 12%">Lundi</th>
                                        <th style="width: 12%">Mardi</th>
                                        <th style="width: 12%">Mercredi</th>
                                        <th style="width: 12%">Jeudi</th>
                                        <th style="width: 12%">Vendredi</th>
                                        <th style="width: 12%">Samedi</th>
                                        <th style="width: 13%">Dimanche</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% set heures = ['08:00', '09:30', '11:00', '14:00', '15:30', '17:00'] %}
                                    {% for heure in heures %}
                                        <tr>
                                            <td class="fw-bold bg-light text-center">
                                                <i class="fas fa-clock me-1"></i>{{ heure }}
                                            </td>
                                            {% for jour in ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi', 'Dimanche'] %}
                                                <td class="text-center">
                                                    {% set creneau_trouve = false %}
                                                    {% for emploi in emplois_par_jour[jour]|default([]) %}
                                                        {% set heure_debut = emploi.heureDebut|date('H:i') %}
                                                        {% set heure_fin = emploi.heureFin|date('H:i') %}
                                                        {% if heure_debut == heure %}
                                                            <div class="p-2 border rounded bg-info text-white">
                                                                <div class="fw-bold">{{ emploi.matiere.nom }}</div>
                                                                <small>{{ emploi.enseignant.nom }} {{ emploi.enseignant.prenom }}</small>
                                                                <br>
                                                                <small>{{ heure_debut }} - {{ heure_fin }}</small>
                                                                {% if emploi.cours %}
                                                                    <br>
                                                                    <small class="text-warning">{{ emploi.cours.titre }}</small>
                                                                {% endif %}
                                                            </div>
                                                            {% set creneau_trouve = true %}
                                                        {% endif %}
                                                    {% endfor %}
                                                    {% if not creneau_trouve %}
                                                        <span class="text-muted">-</span>
                                                    {% endif %}
                                                </td>
                                            {% endfor %}
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Statistiques -->
                <div class="row mt-4">
                    <div class="col-md-3">
                        <div class="card text-white bg-primary">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h4 class="card-title">
                                            {% set total_cours = 0 %}
                                            {% for jour, emplois in emplois_par_jour %}
                                                {% set total_cours = total_cours + emplois|length %}
                                            {% endfor %}
                                            {{ total_cours }}
                                        </h4>
                                        <p class="card-text">Total cours</p>
                                    </div>
                                    <div class="align-self-center">
                                        <i class="fas fa-book fa-2x"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-white bg-success">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h4 class="card-title">
                                            {% set total_heures = 0 %}
                                            {% for jour, emplois in emplois_par_jour %}
                                                {% for emploi in emplois %}
                                                    {% set duree = emploi.heureFin|date('U') - emploi.heureDebut|date('U') %}
                                                    {% set total_heures = total_heures + (duree / 3600) %}
                                                {% endfor %}
                                            {% endfor %}
                                            {{ total_heures|round(1) }}h
                                        </h4>
                                        <p class="card-text">Heures/semaine</p>
                                    </div>
                                    <div class="align-self-center">
                                        <i class="fas fa-clock fa-2x"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-white bg-info">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h4 class="card-title">
                                            {% set enseignants_uniques = [] %}
                                            {% for jour, emplois in emplois_par_jour %}
                                                {% for emploi in emplois %}
                                                    {% if emploi.enseignant.nom not in enseignants_uniques %}
                                                        {% set enseignants_uniques = enseignants_uniques|merge([emploi.enseignant.nom]) %}
                                                    {% endif %}
                                                {% endfor %}
                                            {% endfor %}
                                            {{ enseignants_uniques|length }}
                                        </h4>
                                        <p class="card-text">Enseignants</p>
                                    </div>
                                    <div class="align-self-center">
                                        <i class="fas fa-chalkboard-teacher fa-2x"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-white bg-warning">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h4 class="card-title">
                                            {% set matieres_uniques = [] %}
                                            {% for jour, emplois in emplois_par_jour %}
                                                {% for emploi in emplois %}
                                                    {% if emploi.matiere.nom not in matieres_uniques %}
                                                        {% set matieres_uniques = matieres_uniques|merge([emploi.matiere.nom]) %}
                                                    {% endif %}
                                                {% endfor %}
                                            {% endfor %}
                                            {{ matieres_uniques|length }}
                                        </h4>
                                        <p class="card-text">Matières</p>
                                    </div>
                                    <div class="align-self-center">
                                        <i class="fas fa-graduation-cap fa-2x"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Légende -->
                <div class="card mt-4">
                    <div class="card-header">
                        <h6 class="mb-0">
                            <i class="fas fa-info-circle me-2"></i>Légende
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="bg-info text-white p-2 rounded me-3" style="width: 20px; height: 20px;"></div>
                                    <span>Cours programmé</span>
                                </div>
                                <div class="d-flex align-items-center mb-2">
                                    <div class="bg-light border p-2 rounded me-3" style="width: 20px; height: 20px;"></div>
                                    <span>Heure</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-primary">Informations affichées :</h6>
                                <ul class="list-unstyled">
                                    <li><i class="fas fa-book me-2"></i>Nom de la matière</li>
                                    <li><i class="fas fa-user me-2"></i>Nom de l'enseignant</li>
                                    <li><i class="fas fa-clock me-2"></i>Heures de début et fin</li>
                                    <li><i class="fas fa-file-alt me-2"></i>Titre du cours (si spécifié)</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="text-center py-5">
                    <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">Aucun emploi du temps</h4>
                    <p class="text-muted">L'emploi du temps pour la filière {{ filiere.nom }} n'a pas encore été configuré.</p>
                    <a href="{{ path('admin_emploi_du_temps_new', {'filiere': filiere.id}) }}" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i>Créer l'emploi du temps
                    </a>
                </div>
            {% endif %}
        </main>
    </div>
</div>

<style>
@media print {
    .btn-toolbar, .card-header, .sidebar {
        display: none !important;
    }
    
    .table {
        font-size: 12px;
    }
    
    .container-fluid {
        margin: 0;
        padding: 0;
    }
    
    main {
        margin-left: 0 !important;
        padding: 0 !important;
    }
}

.table td {
    vertical-align: middle;
    min-height: 60px;
}

.bg-info {
    background-color: #0dcaf0 !important;
}
</style>
{% endblock %}
