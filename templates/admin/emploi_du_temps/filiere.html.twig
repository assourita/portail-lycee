{% extends 'base.html.twig' %}

{% block title %}Emploi du temps - {{ filiere.nom }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        {% include 'admin/_sidebar.html.twig' %}

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">
                    <i class="fas fa-calendar-alt me-2 text-primary"></i>
                    Emploi du temps : {{ filiere.nom }}
                </h1>
                <div class="btn-toolbar mb-2 mb-md-0 gap-2">
                    <a href="{{ path('admin_emploi_du_temps_index') }}" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Retour
                    </a>
                    <a href="{{ path('admin_emploi_du_temps_filiere_edit', {'id': filiere.id}) }}" class="btn btn-primary">
                        <i class="fas fa-edit me-1"></i>Modifier la grille
                    </a>
                    <button type="button" class="btn btn-outline-primary" onclick="window.print()">
                        <i class="fas fa-print me-1"></i>Imprimer
                    </button>
                </div>
            </div>

            {% include 'admin/emploi_du_temps/_grille.html.twig' with {'afficher_filiere': false} %}
        </main>
    </div>
</div>
{% endblock %}
