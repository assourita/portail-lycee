{% extends 'base.html.twig' %}

{% block title %}Gestion des Évaluations{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        {% include 'admin/_sidebar.html.twig' %}

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <!-- En-tête -->
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <div>
                    <h1 class="h2">
                        <i class="fas fa-clipboard-list me-2 text-primary"></i>
                        Gestion des Évaluations
                    </h1>
                    {% if periodeActive %}
                        <p class="text-muted mb-0">
                            <i class="fas fa-calendar-check me-1"></i>
                            Période active : <strong>{{ periodeActive.periode }}</strong> - {{ periodeActive.anneeScolaire }}
                        </p>
                    {% else %}
                        <p class="text-danger mb-0">
                            <i class="fas fa-exclamation-triangle me-1"></i>
                            Aucune période active
                        </p>
                    {% endif %}
                </div>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="{{ path('admin_evaluation_new') }}" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i>Nouvelle Évaluation
                    </a>
                </div>
            </div>

            <!-- Messages flash -->
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            <!-- Statistiques -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card text-white bg-primary">
                        <div class="card-body">
                            <h5 class="card-title">Total Évaluations</h5>
                            <h2>{{ evaluations|length }}</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-white bg-success">
                        <div class="card-body">
                            <h5 class="card-title">Matières</h5>
                            <h2>{{ matieres|length }}</h2>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Liste des évaluations -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-list me-2"></i>Liste des Évaluations
                    </h5>
                </div>
                <div class="card-body">
                    {% if evaluations|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Nom</th>
                                        <th>Matière</th>
                                        <th>Enseignant</th>
                                        <th>Date</th>
                                        <th>Coefficient</th>
                                        <th>Note Max</th>
                                        <th>Trimestre</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for evaluation in evaluations %}
                                        <tr>
                                            <td>
                                                <strong>{{ evaluation.nom }}</strong>
                                                {% if evaluation.description %}
                                                    <br><small class="text-muted">{{ evaluation.description|slice(0, 50) }}...</small>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <span class="badge bg-primary">{{ evaluation.matiere.nom }}</span>
                                            </td>
                                            <td>{{ evaluation.enseignant.nom }} {{ evaluation.enseignant.prenom }}</td>
                                            <td>{{ evaluation.dateEvaluation|date('d/m/Y') }}</td>
                                            <td>
                                                <span class="badge bg-info">x{{ evaluation.coefficient }}</span>
                                            </td>
                                            <td>{{ evaluation.noteMax }}</td>
                                            <td>
                                                <span class="badge bg-secondary">{{ evaluation.trimestre.nom }}</span>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a href="{{ path('admin_evaluation_show', {'id': evaluation.id}) }}" 
                                                       class="btn btn-sm btn-info" title="Voir">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a href="{{ path('admin_evaluation_edit', {'id': evaluation.id}) }}" 
                                                       class="btn btn-sm btn-warning" title="Modifier">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <button type="button" class="btn btn-sm btn-danger" 
                                                            onclick="deleteEvaluation({{ evaluation.id }})" title="Supprimer">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="text-center py-5">
                            <i class="fas fa-clipboard-list fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Aucune évaluation créée</h5>
                            <p class="text-muted">Commencez par créer votre première évaluation.</p>
                            <a href="{{ path('admin_evaluation_new') }}" class="btn btn-primary">
                                <i class="fas fa-plus me-1"></i>Créer une Évaluation
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </main>
    </div>
</div>

<!-- Modal de confirmation de suppression -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmer la suppression</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Êtes-vous sûr de vouloir supprimer cette évaluation ?</p>
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Attention :</strong> Cette action est irréversible.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <form id="delete-form" method="post" style="display: inline;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-evaluation') }}">
                    <button type="submit" class="btn btn-danger">Supprimer</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
function deleteEvaluation(evaluationId) {
    const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
    const form = document.getElementById('delete-form');
    form.action = '{{ path('admin_evaluation_delete', {'id': '__ID__'}) }}'.replace('__ID__', evaluationId);
    modal.show();
}
</script>
{% endblock %}
