{% extends 'base.html.twig' %}

{% block title %}{{ classe.nom }}{% endblock %}

{% block body %}
<div class="page">
            <!-- En-tête de la page -->
            <div class="page-header">
                <div>
                    <h1 class="h2">
                        <i class="fas fa-school me-2 text-primary"></i>
                        {{ classe.nom }}
                    </h1>
                    <p class="text-muted mb-0">{{ classe.description }}</p>
                </div>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="{{ path('admin_classe_edit', {'id': classe.id}) }}" class="btn btn-warning me-2">
                        <i class="fas fa-edit me-1"></i>Modifier
                    </a>
                    <a href="{{ path('admin_classes_index') }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Retour à la liste
                    </a>
                </div>
            </div>

            <!-- Statistiques -->
            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="card bg-info text-white">
                        <div class="card-body text-center">
                            <i class="fas fa-graduation-cap fa-2x mb-2"></i>
                            <h3>{{ classe.filieres|length }}</h3>
                            <p class="mb-0">Filières</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card bg-success text-white">
                        <div class="card-body text-center">
                            <i class="fas fa-calendar-week fa-2x mb-2"></i>
                            <h3>{{ classe.trimestres|length }}</h3>
                            <p class="mb-0">Trimestres</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Filières et Trimestres -->
            <div class="row">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <i class="fas fa-graduation-cap me-2"></i>Filières
                            </h5>
                        </div>
                        <div class="card-body">
                            {% if classe.filieres|length > 0 %}
                                <ul class="list-group">
                                    {% for filiere in classe.filieres %}
                                        <li class="list-group-item">
                                            <i class="fas fa-graduation-cap me-2 text-primary"></i>
                                            {{ filiere.nom }}
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% else %}
                                <p class="text-muted">Aucune filière associée</p>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <i class="fas fa-calendar-week me-2"></i>Trimestres
                            </h5>
                        </div>
                        <div class="card-body">
                            {% if classe.trimestres|length > 0 %}
                                <ul class="list-group">
                                    {% for trimestre in classe.trimestres %}
                                        <li class="list-group-item">
                                            <strong>{{ trimestre.nom }}</strong> ({{ trimestre.anneeScolaire }})<br>
                                            <small class="text-muted">
                                                Du {{ trimestre.dateDebut|date('d/m/Y') }} au {{ trimestre.dateFin|date('d/m/Y') }}
                                            </small>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% else %}
                                <p class="text-muted">Aucun trimestre créé</p>
                                <a href="{{ path('admin_trimestre_new') }}" class="btn btn-sm btn-primary">
                                    <i class="fas fa-plus me-1"></i>Créer un trimestre
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
{% endblock %}

