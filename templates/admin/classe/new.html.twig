{% extends 'base.html.twig' %}

{% block title %}Nouvelle Classe{% endblock %}

{% block body %}
<div class="page">
            <!-- En-tête de la page -->
            <div class="page-header">
                <div>
                    <h1 class="h2">
                        <i class="fas fa-plus me-2 text-primary"></i>
                        Nouvelle Classe
                    </h1>
                    <p class="text-muted mb-0">Créer une nouvelle classe</p>
                </div>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="{{ path('admin_classes_index') }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Retour à la liste
                    </a>
                </div>
            </div>

            <!-- Formulaire de création -->
            <div class="row">
                <div class="col-lg-8">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <i class="fas fa-edit me-2"></i>Informations de la Classe
                            </h5>
                        </div>
                        <div class="card-body">
                            <form method="post">
                                <div class="mb-3">
                                    <label for="nom" class="form-label">
                                        <i class="fas fa-tag me-1"></i>Nom de la classe *
                                    </label>
                                    <input type="text" class="form-control" id="nom" name="nom" required 
                                           placeholder="Ex: 10ème, 11ème, Terminale">
                                    <div class="form-text">
                                        <i class="fas fa-info-circle me-1"></i>
                                        Nom de la classe (ex: 10ème, 11ème, Terminale)
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label for="description" class="form-label">
                                        <i class="fas fa-align-left me-1"></i>Description
                                    </label>
                                    <textarea class="form-control" id="description" name="description" rows="3" 
                                              placeholder="Description de la classe..."></textarea>
                                </div>

                                <hr>

                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                    <a href="{{ path('admin_classes_index') }}" class="btn btn-secondary me-md-2">
                                        <i class="fas fa-times me-1"></i>Annuler
                                    </a>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-save me-1"></i>Créer la Classe
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <!-- Aide -->
                    <div class="card">
                        <div class="card-header">
                            <h6 class="mb-0">
                                <i class="fas fa-info-circle me-2"></i>Aide
                            </h6>
                        </div>
                        <div class="card-body">
                            <h6>Comment créer une classe :</h6>
                            <ol class="small">
                                <li>Entrez le nom de la classe</li>
                                <li>Ajoutez une description (optionnel)</li>
                                <li>Cliquez sur "Créer la Classe"</li>
                                <li>Vous pourrez ensuite ajouter des trimestres</li>
                            </ol>
                            <hr>
                            <p class="small text-muted mb-0">
                                <i class="fas fa-lightbulb me-1"></i>
                                Après la création, pensez à créer les trimestres pour cette classe.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
{% endblock %}

