{% extends 'base.html.twig' %}

{% block title %}Détail utilisateur{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        {% include 'admin/_sidebar.html.twig' %}

        <!-- Main content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Détail de l'utilisateur</h1>
            </div>
            <div class="card">
                <div class="card-body">
                    <table class="table table-bordered">
                        <tr><th>ID</th><td>{{ user.id }}</td></tr>
                        <tr><th>Nom d'utilisateur</th><td>{{ user.username }}</td></tr>
                        <tr><th>Email</th><td>{{ user.email }}</td></tr>
                        <tr><th>Rôles</th><td>{% for role in user.roles %}<span class="badge bg-secondary">{{ role }}</span> {% endfor %}</td></tr>
                        <tr><th>Actif</th><td>{{ user.isActivate ? 'Oui' : 'Non' }}</td></tr>
                        <tr><th>Dernière connexion</th><td>{{ user.lastLogin ? user.lastLogin|date('Y-m-d H:i:s') : 'Jamais' }}</td></tr>
                    </table>
                    <a href="{{ path('admin_user_edit', {'id': user.id}) }}" class="btn btn-warning">Modifier</a>
                    <a href="{{ path('admin_users') }}" class="btn btn-secondary">Retour à la liste</a>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %} 