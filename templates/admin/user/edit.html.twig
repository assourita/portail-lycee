{% extends 'base.html.twig' %}

{% block title %}Modifier utilisateur{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        {% include 'admin/_sidebar.html.twig' %}

        <!-- Main content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Modifier l'utilisateur</h1>
            </div>
            <div class="card">
                <div class="card-body">
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.username) }}
                            {{ form_widget(form.username, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="mb-3">
                            {{ form_label(form.email) }}
                            {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="mb-3">
                            {{ form_label(form.plainPassword) }}
                            {{ form_widget(form.plainPassword, {'attr': {'class': 'form-control'}}) }}
                            <div class="form-text">Laissez vide pour conserver le mot de passe actuel</div>
                        </div>
                        <div class="mb-3">
                            {{ form_label(form.roles) }}
                            <div class="form-check">
                                {{ form_widget(form.roles) }}
                            </div>
                        </div>
                        <div class="mb-3">
                            {{ form_label(form.isActivate) }}
                            {{ form_widget(form.isActivate, {'attr': {'class': 'form-check-input'}}) }}
                        </div>
                        <button class="btn btn-success">Enregistrer</button>
                        <a href="{{ path('admin_user_show', {'id': user.id}) }}" class="btn btn-secondary">Annuler</a>
                    {{ form_end(form) }}
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %} 