{% extends 'base.html.twig' %}
{% block title %}Modifier Matière{% endblock %}
{% block body %}
<div class="page">
            <div class="page-header">
                <h1 class="h2">Modifier la matière</h1>
            </div>
            <div class="card">
                <div class="card-body">
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.nom) }}
                            {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="mb-3">
                            {{ form_label(form.enseignant) }}
                            {{ form_widget(form.enseignant, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="mb-3">
                            {{ form_label(form.filiere) }}
                            {{ form_widget(form.filiere, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <button class="btn btn-success">Enregistrer</button>
                        <a href="{{ path('admin_matiere_show', {'id': matiere.id}) }}" class="btn btn-secondary">Annuler</a>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
{% endblock %} 