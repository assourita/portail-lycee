{% extends 'base.html.twig' %}

{% block title %}Modifier {{ parent.prenom }} {{ parent.nom }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        {% include 'admin/_sidebar.html.twig' %}

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <div>
                    <h1 class="h2">
                        <i class="fas fa-edit me-2 text-primary"></i>
                        Modifier le parent
                    </h1>
                    <p class="text-muted mb-0">{{ parent.prenom }} {{ parent.nom }}</p>
                </div>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="{{ path('admin_parent_show', {'id': parent.id}) }}" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Retour
                    </a>
                </div>
            </div>

            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            {% set enfantsIds = parent.enfants|map(e => e.id) %}

            <div class="card">
                <div class="card-body">
                    <form method="post">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="nom" class="form-label">Nom *</label>
                                <input type="text" class="form-control" id="nom" name="nom" value="{{ parent.nom }}" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="prenom" class="form-label">Prénom *</label>
                                <input type="text" class="form-control" id="prenom" name="prenom" value="{{ parent.prenom }}" required>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="email" class="form-label">Email *</label>
                                <input type="email" class="form-control" id="email" name="email" value="{{ parent.email }}" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="telephone" class="form-label">Téléphone</label>
                                <input type="tel" class="form-control" id="telephone" name="telephone" value="{{ parent.telephone }}">
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="lien_parente" class="form-label">Lien de parenté *</label>
                                <select class="form-select" id="lien_parente" name="lien_parente" required>
                                    {% for valeur, libelle in {'pere': 'Père', 'mere': 'Mère', 'tuteur': 'Tuteur légal', 'autre': 'Autre'} %}
                                        <option value="{{ valeur }}" {{ parent.lienParente == valeur ? 'selected' }}>{{ libelle }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="profession" class="form-label">Profession</label>
                                <input type="text" class="form-control" id="profession" name="profession" value="{{ parent.profession }}">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="adresse" class="form-label">Adresse</label>
                            <input type="text" class="form-control" id="adresse" name="adresse" value="{{ parent.adresse }}">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Enfants</label>
                            <div class="border rounded p-3" style="max-height: 300px; overflow-y: auto;">
                                {% for etudiant in etudiants %}
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="enfants[]"
                                               value="{{ etudiant.id }}" id="enfant{{ etudiant.id }}"
                                               {{ etudiant.id in enfantsIds ? 'checked' }}>
                                        <label class="form-check-label" for="enfant{{ etudiant.id }}">
                                            {{ etudiant.nom }} {{ etudiant.prenom }}
                                            {% if etudiant.filiere %}({{ etudiant.filiere.nom }}){% endif %}
                                        </label>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a href="{{ path('admin_parent_show', {'id': parent.id}) }}" class="btn btn-secondary">Annuler</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i>Enregistrer
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}
