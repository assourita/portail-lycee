{% extends 'base.html.twig' %}

{% block title %}{{ parent.prenom }} {{ parent.nom }}{% endblock %}

{% block body %}
{% set liens = {'pere': 'Père', 'mere': 'Mère', 'tuteur': 'Tuteur légal', 'autre': 'Autre'} %}
<div class="page">
            <div class="page-header">
                <div>
                    <h1 class="h2">
                        <i class="fas fa-user-friends me-2 text-primary"></i>
                        {{ parent.prenom }} {{ parent.nom }}
                    </h1>
                    <p class="text-muted mb-0">{{ liens[parent.lienParente] ?? parent.lienParente }}</p>
                </div>
                <div class="btn-toolbar mb-2 mb-md-0 gap-2">
                    <a href="{{ path('admin_parents_index') }}" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Retour
                    </a>
                    <a href="{{ path('admin_parent_edit', {'id': parent.id}) }}" class="btn btn-primary">
                        <i class="fas fa-edit me-1"></i>Modifier
                    </a>
                    <form method="post" action="{{ path('admin_parent_delete', {'id': parent.id}) }}"
                          onsubmit="return confirm('Supprimer ce parent et son compte utilisateur ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-parent') }}">
                        <button class="btn btn-danger"><i class="fas fa-trash me-1"></i>Supprimer</button>
                    </form>
                </div>
            </div>

            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            <div class="row">
                <div class="col-md-6 mb-4">
                    <div class="card h-100">
                        <div class="card-header">
                            <h5 class="mb-0"><i class="fas fa-id-card me-2"></i>Coordonnées</h5>
                        </div>
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-5">Email</dt>
                                <dd class="col-sm-7">{{ parent.email }}</dd>
                                <dt class="col-sm-5">Téléphone</dt>
                                <dd class="col-sm-7">{{ parent.telephone ?: '-' }}</dd>
                                <dt class="col-sm-5">Téléphone secondaire</dt>
                                <dd class="col-sm-7">{{ parent.telephoneSecondaire ?: '-' }}</dd>
                                <dt class="col-sm-5">Adresse</dt>
                                <dd class="col-sm-7">{{ parent.adresse ?: '-' }}</dd>
                                <dt class="col-sm-5">Profession</dt>
                                <dd class="col-sm-7">{{ parent.profession ?: '-' }}</dd>
                                <dt class="col-sm-5">Créé le</dt>
                                <dd class="col-sm-7">{{ parent.dateCreation ? parent.dateCreation|date('d/m/Y') : '-' }}</dd>
                            </dl>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 mb-4">
                    <div class="card h-100">
                        <div class="card-header">
                            <h5 class="mb-0"><i class="fas fa-user-lock me-2"></i>Compte d'accès au portail</h5>
                        </div>
                        <div class="card-body">
                            {% if parent.user %}
                                <p class="mb-1"><strong>Identifiant :</strong> {{ parent.user.username }}</p>
                                <p class="mb-1">
                                    <strong>Statut :</strong>
                                    {% if parent.user.isActivate %}
                                        <span class="badge bg-success">Actif</span>
                                    {% else %}
                                        <span class="badge bg-secondary">Inactif</span>
                                    {% endif %}
                                </p>
                                <p class="mb-0">
                                    <strong>Dernière connexion :</strong>
                                    {{ parent.user.lastLogin ? parent.user.lastLogin|date('d/m/Y H:i') : 'Jamais' }}
                                </p>
                            {% else %}
                                <p class="text-muted">Ce parent n'a pas encore de compte utilisateur.</p>
                                <form method="post" action="{{ path('admin_parent_creer_compte', {'id': parent.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('creer-compte' ~ parent.id) }}">
                                    <button class="btn btn-success">
                                        <i class="fas fa-user-plus me-1"></i>Créer un compte
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-user-graduate me-2"></i>Enfants ({{ parent.enfants|length }})</h5>
                </div>
                <div class="card-body p-0">
                    {% if parent.enfants|length > 0 %}
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Nom</th>
                                    <th>Prénom</th>
                                    <th>Filière</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for enfant in parent.enfants %}
                                    <tr>
                                        <td>{{ enfant.nom }}</td>
                                        <td>{{ enfant.prenom }}</td>
                                        <td>{{ enfant.filiere ? enfant.filiere.nom : '-' }}</td>
                                        <td class="text-end">
                                            <a href="{{ path('admin_etudiant_show', {'id': enfant.id}) }}" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% else %}
                        <p class="text-muted p-3 mb-0">Aucun enfant associé.</p>
                    {% endif %}
                </div>
            </div>
        </div>
{% endblock %}
