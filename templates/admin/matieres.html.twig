{% extends 'base.html.twig' %}

{% block title %}Gestion des Matières{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        {% include 'admin/_sidebar.html.twig' %}
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Gestion des Matières</h1>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="{{ path('admin_matiere_new') }}" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Ajouter une matière
                    </a>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Nom</th>
                                    <th>Filière</th>
                                    <th>Enseignant</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for matiere in matieres %}
                                    <tr>
                                        <td>{{ matiere.id }}</td>
                                        <td>{{ matiere.nom }}</td>
                                        <td>{{ matiere.filiere ? matiere.filiere.nom : 'Non assigné' }}</td>
                                        <td>{{ matiere.enseignant ? matiere.enseignant.nom ~ ' ' ~ matiere.enseignant.prenom : 'Non assigné' }}</td>
                                        <td>
                                            <a href="{{ path('admin_matiere_show', {'id': matiere.id}) }}" class="btn btn-sm btn-info">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="{{ path('admin_matiere_edit', {'id': matiere.id}) }}" class="btn btn-sm btn-warning">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form method="post" action="{{ path('admin_matiere_delete', {'id': matiere.id}) }}" style="display:inline-block" onsubmit="return confirm('Voulez-vous vraiment supprimer cette matière ?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete-matiere-' ~ matiere.id) }}">
                                                <button class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %} 